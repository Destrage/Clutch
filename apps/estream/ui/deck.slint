// The Live deck: what the studio shows while a stream is running. Big, glanceable controls:
// stream time and platforms, the program picture with a clip button, scene buttons with
// F-key shortcuts, and sound knobs (whose names open the sound's settings over the deck).

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { SceneRow, MixerStrip, LiveRow, AudioInspect, InspectorFolds, CanvasTab } from "types.slint";
import { Button, Icon, IconButton, Hint } from "widgets.slint";
import { ProgramView } from "panels.slint";
import { ChatPanel, ChatTabRow, ChatLive, ChatLine, ChatStateRow } from "chat.slint";
import { SoundKnob, AudioSettings } from "sound.slint";

// One platform's state in the top bar.
component PlatformChip inherits Rectangle {
    in property <LiveRow> entry;
    property <color> dot: entry.state == 2 ? Theme.ok : entry.state == 4 ? Theme.live : Theme.warn;
    height: 30px;
    width: chip.preferred-width;
    border-radius: 15px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    accessible-role: text;
    accessible-label: entry.name + ": " + (entry.state == 2 ? "live" : entry.state == 1 ? "connecting" : entry.state == 3 ? "reconnecting" : entry.state == 4 ? "failed" : "off");
    chip := HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle { width: 8px; height: 8px; border-radius: 4px; background: root.dot; }
        }
        Text { text: root.entry.name; color: Theme.text; font-size: Theme.font-m; font-weight: 600; vertical-alignment: center; }
        if root.entry.viewers >= 0: Text { text: root.entry.viewers; color: Theme.text-muted; font-size: Theme.font-m; vertical-alignment: center; }
    }
}

// A small label on a picture ("Preview", "Live").
component ViewTag inherits Rectangle {
    in property <string> text;
    in property <color> tint;
    width: tag.preferred-width + 16px;
    height: 22px;
    border-radius: 6px;
    background: root.tint;
    tag := Text {
        text: root.text;
        color: Theme.on-accent;
        font-size: Theme.font-xs;
        font-weight: 700;
        letter-spacing: 0.5px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A big scene button.
component SceneButton inherits Rectangle {
    in property <SceneRow> scene;
    in property <string> key-label;
    /// Studio mode: `active` is the Preview scene and `live` the program one.
    in property <bool> studio;
    callback clicked;
    // Equal widths whatever the names.
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    height: 76px;
    border-radius: 14px;
    border-width: 2px;
    border-color: root.studio && scene.live ? Theme.live : scene.live || scene.active ? Theme.accent : ta.has-hover ? Theme.border-strong : Theme.border;
    background: root.studio && scene.live && !scene.active ? Theme.surface : scene.live || scene.active ? Theme.accent-soft : ta.pressed ? Theme.pressed : Theme.surface;
    accessible-role: button;
    accessible-label: root.studio ? "Prepare " + scene.name + " in the Preview" : "Switch to " + scene.name;
    VerticalLayout {
        padding: 12px;
        Text {
            text: root.scene.name;
            color: Theme.text;
            font-size: Theme.font-l;
            font-weight: 600;
            overflow: elide;
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            if root.key-label != "": Rectangle {
                width: key.preferred-width + 10px;
                height: 18px;
                border-radius: 4px;
                border-width: 1px;
                border-color: Theme.border-strong;
                key := Text { text: root.key-label; color: Theme.text-muted; font-size: Theme.font-xs; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            }
            Rectangle { horizontal-stretch: 1; }
        }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

export component LiveDeck inherits Rectangle {
    in property <image> frame;
    in property <float> canvas-w: 1920;
    in property <float> canvas-h: 1080;
    in property <[SceneRow]> scenes;
    in property <[MixerStrip]> strips;
    in property <[LiveRow]> live-rows;
    in property <string> stream-time;
    /// Viewers across platforms that report them (-1: none do).
    in property <int> viewers-total: -1;
    /// 1 good, 2 congested or connecting, 3 failing.
    in property <int> stream-health;
    in property <string> stream-info;
    in property <bool> recording;
    in property <string> record-time;
    in property <bool> replay-active;
    in property <string> clip-hotkey;
    callback scene(string);
    callback fader(string, float);
    callback commit();
    callback toggle-mute(string);
    callback clip-now();
    callback toggle-record();
    callback end-stream();
    callback edit-layout();
    /// Studio mode: the Preview render next to the program (`frame`).
    in property <bool> studio-mode;
    in property <image> preview;
    callback toggle-studio();
    /// Studio mode: send the Preview to program ("go" = chosen transition, "cut").
    callback go(string);
    in property <string> transition-label;
    /// Canvas tabs: the deck shows the active one (a picker with more than one).
    in property <[CanvasTab]> canvas-tabs;
    callback canvas-select(string);
    // A sound's settings over the deck (opened by clicking its name under the knob).
    in property <AudioInspect> audio;
    /// The window's folded sound panels, shared with the inspector.
    in-out property <InspectorFolds> folds;
    in-out property <bool> sound-open;
    callback open-sound(string);
    callback close-sound();
    callback remove-sound(string);
    callback audio-remove();
    callback audio-set(string, float);
    callback filter-add(int);
    callback filter-remove(string);
    callback filter-toggle(string, bool);
    callback filter-param(string, string, float);
    callback filter-move(string, bool);
    // The chat column.
    in property <[ChatTabRow]> chat-tabs;
    in property <int> chat-selected;
    in property <image> chat-frame;
    in property <string> chat-message;
    in property <int> chat-people-total: -1;
    in property <[string]> chat-people;
    in property <ChatLive> chat-live;
    callback chat-select(int);
    callback chat-pointer(string, float, float, int, float, float);
    callback chat-key(string, bool, bool, bool, bool);
    callback chat-home();
    callback chat-reload();
    callback chat-resized(float, float);
    callback chat-send(string, int);
    callback chat-toggle-chime();
    in property <int> chat-emote-ms;
    callback chat-text-width(float);

    /// The F-key label for scene `i` ("" past F9, or when the key is the clip hotkey).
    pure function key-label(i: int) -> string {
        if (i >= 9) { return ""; }
        if ("F" + (i + 1) == root.clip-hotkey) { return ""; }
        return "F" + (i + 1);
    }

    /// End stream asks for a second click within a few seconds.
    property <bool> confirm-end;

    background: Theme.bg;

    VerticalLayout {
        // Top bar: on-air state and the platforms.
        HorizontalLayout {
            height: 60px;
            padding-left: 16px;
            padding-right: 16px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                Image { source: Icons.logo; width: 28px; height: 28px; }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 30px;
                    width: live.preferred-width;
                    border-radius: 8px;
                    background: Theme.live;
                    accessible-role: text;
                    accessible-label: "Live for " + root.stream-time;
                    live := HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        Text { text: "LIVE"; color: Theme.on-accent; font-size: Theme.font-m; font-weight: 800; letter-spacing: 1px; vertical-alignment: center; }
                        Text { text: root.stream-time; color: Theme.on-accent; font-size: Theme.font-m; font-weight: 600; vertical-alignment: center; }
                    }
                }
            }
            if root.viewers-total >= 0: VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 30px;
                    width: watching.preferred-width;
                    border-radius: 15px;
                    background: Theme.surface-2;
                    accessible-role: text;
                    accessible-label: root.viewers-total + " watching";
                    watching := HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 14px;
                        spacing: 8px;
                        VerticalLayout { alignment: center; Icon { source: Icons.eye; size: 16px; tint: Theme.text; } }
                        Text { text: root.viewers-total + " watching"; color: Theme.text; font-size: Theme.font-m; font-weight: 700; vertical-alignment: center; }
                    }
                }
            }
            for row in root.live-rows: VerticalLayout {
                alignment: center;
                PlatformChip { entry: row; }
            }
            Rectangle { horizontal-stretch: 1; }
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: root.stream-health == 3 ? Theme.live : root.stream-health == 2 ? Theme.warn : Theme.ok;
                    }
                }
                Text {
                    text: root.stream-health == 3 ? "Connection trouble" : root.stream-health == 2 ? "Connection busy" : "Connection healthy";
                    color: Theme.text-muted;
                    font-size: Theme.font-m;
                    vertical-alignment: center;
                }
            }
            // Which canvas the deck shows (switching scenes still moves every following canvas).
            if root.canvas-tabs.length > 1: VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 32px;
                    width: tabs.preferred-width;
                    border-radius: 8px;
                    background: Theme.surface-2;
                    tabs := HorizontalLayout {
                        padding: 2px;
                        spacing: 2px;
                        for tab in root.canvas-tabs: Rectangle {
                            width: tab-text.preferred-width + 20px;
                            border-radius: 6px;
                            background: tab.active ? Theme.surface-3 : tab-ta.has-hover ? Theme.hover : transparent;
                            accessible-role: button;
                            accessible-label: "Show " + tab.name;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;
                                if tab.live: VerticalLayout {
                                    alignment: center;
                                    Rectangle { width: 6px; height: 6px; border-radius: 3px; background: Theme.live; }
                                }
                                tab-text := Text {
                                    text: tab.name;
                                    color: tab.active ? Theme.text : Theme.text-muted;
                                    font-size: Theme.font-s;
                                    font-weight: tab.active ? 600 : 400;
                                    vertical-alignment: center;
                                }
                            }
                            tab-ta := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { root.canvas-select(tab.id); }
                            }
                        }
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: "Studio mode";
                    has-icon: true;
                    icon: Icons.layout-dashboard;
                    kind: root.studio-mode ? "primary" : "default";
                    tooltip: root.studio-mode ? "Leave studio mode (Ctrl+Shift+T)" : "Prepare the next scene off-air, then send it live (Ctrl+Shift+T)";
                    clicked => { root.toggle-studio(); }
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: "Edit layout";
                    has-icon: true;
                    icon: Icons.pencil;
                    tooltip: "Edit scenes and sources. The stream keeps running.";
                    clicked => { root.edit-layout(); }
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: root.confirm-end ? "Click again to end" : "End stream";
                    kind: "danger";
                    clicked => {
                        if (root.confirm-end) {
                            root.confirm-end = false;
                            root.end-stream();
                        } else {
                            root.confirm-end = true;
                        }
                    }
                }
            }
        }
        Timer {
            interval: 4s;
            running: root.confirm-end;
            triggered => { root.confirm-end = false; }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            padding: 16px;
            padding-top: 4px;
            spacing: 16px;

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 12px;
                // What viewers see (and in studio mode, the Preview beside it).
                HorizontalLayout {
                vertical-stretch: 1;
                spacing: 12px;
                if root.studio-mode: Rectangle {
                    horizontal-stretch: 1;
                    border-radius: Theme.radius-l;
                    border-width: 2px;
                    border-color: Theme.accent;
                    clip: true;
                    ProgramView {
                        width: parent.width;
                        height: parent.height;
                        frame: root.preview;
                        canvas-w: root.canvas-w;
                        canvas-h: root.canvas-h;
                        on-air: false;
                        badge: false;
                    }
                    ViewTag { x: 12px; y: 12px; text: "Preview"; tint: Theme.accent; }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    border-radius: Theme.radius-l;
                    border-width: root.studio-mode ? 2px : 1px;
                    border-color: root.studio-mode ? Theme.live : Theme.border;
                    clip: true;
                    ProgramView {
                        width: parent.width;
                        height: parent.height;
                        frame: root.frame;
                        canvas-w: root.canvas-w;
                        canvas-h: root.canvas-h;
                        badge: !root.studio-mode;
                    }
                    if root.studio-mode: ViewTag { x: 12px; y: 12px; text: "Live"; tint: Theme.live; }
                    Button {
                        x: parent.width - self.width - 16px;
                        y: parent.height - self.height - 16px;
                        width: 150px;
                        height: 40px;
                        text: root.clip-hotkey != "" ? "Clip that  " + root.clip-hotkey : "Clip that";
                        kind: "primary";
                        has-icon: true;
                        icon: Icons.film;
                        tooltip: "Save the last moments as a clip";
                        clicked => { root.clip-now(); }
                    }
                }
                }
                // Scenes (in studio mode they pick the Preview), then Transition and Cut.
                HorizontalLayout {
                    spacing: 10px;
                    for scene[i] in root.scenes: SceneButton {
                        scene: scene;
                        studio: root.studio-mode;
                        key-label: root.key-label(i);
                        clicked => { root.scene(scene.id); }
                    }
                    if root.studio-mode: VerticalLayout {
                        width: 170px;
                        spacing: 6px;
                        Button {
                            vertical-stretch: 1;
                            text: "Transition";
                            kind: "primary";
                            has-icon: true;
                            icon: Icons.play;
                            tooltip: "Send the Preview live with " + root.transition-label + " on every canvas that switches together";
                            clicked => { root.go("go"); }
                        }
                        Button {
                            text: "Cut";
                            tooltip: "Send the Preview live at once";
                            clicked => { root.go("cut"); }
                        }
                    }
                }
                // Sound and recording.
                Rectangle {
                    height: 124px;
                    border-radius: Theme.radius-l;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        padding: 14px;
                        spacing: 4px;
                        for strip in root.strips: VerticalLayout {
                            alignment: center;
                            SoundKnob {
                                strip: strip;
                                size: 60px;
                                fader(v) => { root.fader(strip.id, v); }
                                commit => { root.commit(); }
                                toggle-mute => { root.toggle-mute(strip.id); }
                                open-settings => {
                                    root.open-sound(strip.id);
                                    root.sound-open = true;
                                }
                                remove => { root.remove-sound(strip.id); }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout {
                            alignment: end;
                            spacing: 8px;
                            Button {
                                text: root.recording ? "Recording  " + root.record-time : "Record";
                                kind: root.recording ? "live" : "default";
                                has-icon: true;
                                icon: Icons.circle;
                                clicked => { root.toggle-record(); }
                            }
                            Text {
                                text: root.replay-active ? "Clip buffer ready" : "Clip buffer off";
                                color: Theme.text-muted;
                                font-size: Theme.font-s;
                                horizontal-alignment: right;
                            }
                        }
                    }
                }
            }

            // Chat on top, each platform's state below.
            VerticalLayout {
                width: 380px;
                spacing: 12px;
                ChatPanel {
                    vertical-stretch: 1;
                    tabs: root.chat-tabs;
                    selected: root.chat-selected;
                    frame: root.chat-frame;
                    message: root.chat-message;
                    people-total: root.chat-people-total;
                    people: root.chat-people;
                    live: root.chat-live;
                    select(i) => { root.chat-select(i); }
                    pointer(k, x, y, b, dx, dy) => { root.chat-pointer(k, x, y, b, dx, dy); }
                    key(t, d, c, s, a) => { root.chat-key(t, d, c, s, a); }
                    home => { root.chat-home(); }
                    reload => { root.chat-reload(); }
                    resized(w, h) => { root.chat-resized(w, h); }
                    send(t, i) => { root.chat-send(t, i); }
                    toggle-chime => { root.chat-toggle-chime(); }
                    emote-ms: root.chat-emote-ms;
                    text-width(w) => { root.chat-text-width(w); }
                }
                Rectangle {
                    border-radius: Theme.radius-l;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 6px;
                        for row in root.live-rows: HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: row.state == 2 ? Theme.ok : row.state == 4 ? Theme.live : Theme.warn;
                                }
                            }
                            Text { text: row.name; color: Theme.text; font-size: Theme.font-m; font-weight: 600; vertical-alignment: center; }
                            Text {
                                text: row.info;
                                color: Theme.text-muted;
                                font-size: Theme.font-s;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                horizontal-alignment: right;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }
    }

    // The sound's settings, over the left of the deck.
    if root.sound-open && root.audio.has: Rectangle {
        x: 16px;
        y: 76px;
        width: min(380px, root.width - 32px);
        height: root.height - self.y - 156px;
        background: Theme.surface;
        border-radius: Theme.radius-l;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000070;
        clip: true;
        TouchArea {}
        VerticalLayout {
            HorizontalLayout {
                height: 44px;
                padding-left: 14px;
                padding-right: 8px;
                Text {
                    text: root.audio.name;
                    color: Theme.text;
                    font-size: Theme.font-l;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.x;
                        tooltip: "Close (Esc)";
                        size: 28px;
                        icon-size: 14px;
                        clicked => {
                            root.sound-open = false;
                            root.close-sound();
                        }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            Flickable {
                vertical-stretch: 1;
                content-height: sound-body.preferred-height;
                sound-body := VerticalLayout {
                    padding: 14px;
                    alignment: start;
                    AudioSettings {
                        audio: root.audio;
                        folds <=> root.folds;
                        audio-set(k, v) => { root.audio-set(k, v); }
                        filter-add(i) => { root.filter-add(i); }
                        filter-remove(id) => { root.filter-remove(id); }
                        filter-toggle(id, v) => { root.filter-toggle(id, v); }
                        filter-param(id, k, v) => { root.filter-param(id, k, v); }
                        filter-move(id, up) => { root.filter-move(id, up); }
                        commit => { root.commit(); }
                        remove-source => {
                            root.audio-remove();
                            root.sound-open = false;
                        }
                    }
                }
            }
        }
    }
}

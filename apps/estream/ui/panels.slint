import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { CanvasTab, SceneRow, LayerRow, Inspect, PropRow, MixerStrip, AudioInspect, FilterRow, VideoFilterRow, MediaInspect } from "types.slint";
import {
    Button, IconButton, Icon, TextField, TextArea, NumberField, Toggle, Slider, Select, Panel,
    PanelHeader, SectionTitle, Badge, EmptyState, Hint,
} from "widgets.slint";

export component TopBar inherits Rectangle {
    in property <string> collection-name;
    in property <string> canvas-info;
    in property <bool> dirty;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> recording;
    in property <string> record-time;
    in property <bool> replay-active;
    in property <int> stream-state;
    /// 0 off, 1 starting or installing, 2 on, 3 in use by an app.
    in property <int> vcam-state;
    in property <string> vcam-tooltip;
    callback toggle-vcam();
    in property <string> stream-time;
    callback open-palette();
    callback toggle-stream();
    in property <bool> studio-mode;
    callback toggle-studio();
    callback open-destinations();
    in property <bool> live-panel-open;
    callback undo();
    callback redo();
    callback toggle-theme();
    callback toggle-record();
    callback toggle-replay();
    callback save-replay();
    callback open-settings();

    height: 52px;
    background: Theme.bg;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 8px;

        // Brand
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 26px;
                    height: 26px;
                    border-radius: 8px;
                    background: @linear-gradient(135deg, Theme.accent 0%, #b06cff 100%);
                    Icon { source: Icons.radio; size: 15px; tint: #ffffff; }
                }
            }
            Text {
                text: "eStream";
                color: Theme.text;
                font-size: Theme.font-l;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
        Rectangle { width: 10px; }
        VerticalLayout {
            alignment: center;
            Rectangle {
                height: 28px;
                border-radius: Theme.radius-s;
                background: Theme.surface-2;
                width: coll.preferred-width + 20px;
                coll := HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        Icon { source: Icons.folder; size: 14px; }
                    }
                    Text {
                        text: root.collection-name + (root.dirty ? " •" : "");
                        color: Theme.text;
                        font-size: Theme.font-s;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.canvas-info;
                        color: Theme.text-faint;
                        font-size: Theme.font-s;
                        vertical-alignment: center;
                    }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 2px;
                IconButton { icon: Icons.undo; tooltip: "Undo (Ctrl+Z)"; enabled: root.can-undo; clicked => { root.undo(); } }
                IconButton { icon: Icons.redo; tooltip: "Redo (Ctrl+Shift+Z)"; enabled: root.can-redo; clicked => { root.redo(); } }
            }
        }

        Rectangle { horizontal-stretch: 1; }

        // Command palette launcher
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 260px;
                height: 30px;
                border-radius: Theme.radius-s;
                background: palette-ta.has-hover ? Theme.surface-3 : Theme.surface-2;
                border-width: 1px;
                border-color: Theme.border;
                accessible-role: button;
                accessible-label: "Open command palette";
                accessible-action-default => { root.open-palette(); }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 6px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Icon { source: Icons.search; size: 14px; tint: Theme.text-faint; }
                    }
                    Text {
                        text: "Search actions, scenes, sources…";
                        color: Theme.text-faint;
                        font-size: Theme.font-s;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        Badge { text: "Ctrl K"; }
                    }
                }
                palette-ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.open-palette(); }
                }
            }
        }

        Rectangle { horizontal-stretch: 1; }

        VerticalLayout {
            alignment: center;
            Button {
                text: "Studio mode";
                has-icon: true;
                icon: Icons.layout-dashboard;
                kind: root.studio-mode ? "primary" : "ghost";
                tooltip: root.studio-mode ? "Leave studio mode (Ctrl+Shift+T)" : "Prepare scenes off-air (Ctrl+Shift+T)";
                clicked => { root.toggle-studio(); }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Theme.dark ? Icons.sun : Icons.moon;
                tooltip: Theme.dark ? "Switch to light theme" : "Switch to dark theme";
                clicked => { root.toggle-theme(); }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.settings;
                tooltip: "Settings (Ctrl+,)";
                clicked => { root.open-settings(); }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: vcam-button.width;
                height: vcam-button.height;
                vcam-button := IconButton {
                    icon: Icons.camera;
                    toggled: root.vcam-state >= 2;
                    tooltip: root.vcam-tooltip;
                    clicked => { root.toggle-vcam(); }
                }
                // Live dot while an app is receiving the camera.
                if root.vcam-state == 3: Rectangle {
                    x: parent.width - 9px;
                    y: 3px;
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: Theme.live;
                }
                // Pulsing ring while starting or installing.
                if root.vcam-state == 1: Rectangle {
                    border-radius: Theme.radius-s;
                    border-width: 1px;
                    border-color: Theme.accent.with-alpha(0.4 + 0.4 * Math.sin(animation-tick() / 300ms * 1rad));
                }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.rotate-cw;
                toggled: root.replay-active;
                tooltip: root.replay-active ? "Stop replay buffer" : "Start replay buffer";
                clicked => { root.toggle-replay(); }
            }
        }
        if root.replay-active: VerticalLayout {
            alignment: center;
            Button {
                text: "Save replay";
                kind: "ghost";
                tooltip: "Save the last seconds (Ctrl+Shift+R)";
                clicked => { root.save-replay(); }
            }
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: root.recording ? root.record-time : "Record";
                has-icon: true;
                icon: root.recording ? Icons.square : Icons.circle;
                kind: root.recording ? "live" : "default";
                active: root.recording;
                tooltip: root.recording ? "Stop recording" : "Start recording";
                clicked => { root.toggle-record(); }
            }
        }
        VerticalLayout {
            alignment: center;
            // stream-state: 0 off, 1 connecting, 2 live, 3 reconnecting
            Button {
                text: root.stream-state == 0 ? "Go Live"
                    : root.stream-state == 1 ? "Connecting…"
                    : root.stream-state == 3 ? "Reconnecting…"
                    : root.stream-time;
                has-icon: true;
                icon: root.stream-state == 2 ? Icons.square : Icons.radio;
                kind: root.stream-state == 3 ? "danger" : root.stream-state == 1 ? "default" : "live";
                active: root.stream-state == 2;
                tooltip: root.stream-state == 0 ? "Go live on all enabled destinations" : "End the stream everywhere";
                clicked => { root.toggle-stream(); }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.chevron-down;
                toggled: root.live-panel-open;
                tooltip: "Destinations";
                clicked => { root.open-destinations(); }
            }
        }
    }
}

/// Transition used when the program scene changes (bottom of the Scenes panel).
export component TransitionBar inherits Rectangle {
    // kind: 0 cut, 1 fade, 2 fade to black, 3 slide, 4 swipe, 5 wipe, 6 custom shader, 7 stinger
    in property <int> kind;
    in property <int> direction;
    in property <float> duration;
    /// Stinger video file name and switch point (ms).
    in property <string> file;
    in property <float> point;
    callback set(string, float);
    callback edit-shader();

    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        Text { text: "TRANSITION"; color: Theme.text-faint; font-size: Theme.font-xs; font-weight: 700; }
        HorizontalLayout {
            spacing: 6px;
            Select {
                label: "Transition";
                options: ["Cut", "Fade", "Fade to black", "Slide", "Swipe", "Wipe", "Custom shader…", "Stinger…"];
                current-index: root.kind;
                selected(i) => { root.set("kind", i); }
            }
            if root.kind != 0: NumberField {
                width: 92px;
                label: "";
                value: root.duration;
                minimum: 50;
                maximum: 10000;
                step: 50;
                suffix: "ms";
                changed(v) => { root.set("duration", v); }
            }
        }
        if root.kind >= 3 && root.kind <= 5: Select {
            label: "Direction";
            options: ["Towards the left", "Towards the right", "Upwards", "Downwards"];
            current-index: root.direction;
            selected(i) => { root.set("direction", i); }
        }
        if root.kind == 6: Button {
            text: "Edit shader…";
            has-icon: true;
            icon: Icons.sparkles;
            kind: "ghost";
            clicked => { root.edit-shader(); }
        }
        if root.kind == 7: HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.file != "" ? root.file : "No video chosen";
                color: root.file != "" ? Theme.text : Theme.text-faint;
                font-size: Theme.font-xs;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Button { text: "Video…"; kind: "ghost"; clicked => { root.set("stinger-file", 0); } }
        }
        if root.kind == 7: HorizontalLayout {
            spacing: 6px;
            Text { text: "Switch at"; color: Theme.text-muted; font-size: Theme.font-xs; vertical-alignment: center; horizontal-stretch: 1; }
            NumberField {
                width: 92px;
                label: "";
                value: root.point;
                minimum: 0;
                maximum: root.duration;
                step: 50;
                suffix: "ms";
                changed(v) => { root.set("point", v); }
            }
        }
    }
}

export component ScenesPanel inherits Panel {
    in property <[SceneRow]> scenes;
    in-out property <string> renaming;
    callback activate(string);
    callback add();
    callback duplicate(string);
    callback remove(string);
    callback rename(string, string);
    in property <bool> studio-mode;
    in property <int> transition-kind;
    in property <int> transition-direction;
    in property <float> transition-duration;
    in property <string> transition-file;
    in property <float> transition-point;
    callback transition-set(string, float);
    callback edit-shader();

    PanelHeader {
        title: "SCENES";
        icon: Icons.layers;
        IconButton { icon: Icons.plus; tooltip: "New scene (Ctrl+Shift+N)"; clicked => { root.add(); } }
    }
    Flickable {
        vertical-stretch: 1;
        content-height: list.preferred-height;
        list := VerticalLayout {
            padding: 6px;
            spacing: 2px;
            alignment: start;
            for scene in root.scenes: Rectangle {
                height: 36px;
                border-radius: Theme.radius-m;
                background: scene.active ? Theme.accent-soft : row-ta.has-hover ? Theme.hover : transparent;
                accessible-role: list-item;
                accessible-label: scene.name;
                accessible-item-selected: scene.active;
                accessible-action-default => { root.activate(scene.id); }

                row-ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.activate(scene.id); }
                    double-clicked => { root.renaming = scene.id; }
                }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 4px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: scene.active ? Theme.accent : Theme.text-faint.with-alpha(0.5);
                        }
                    }
                    if root.renaming == scene.id: VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        TextField {
                            text: scene.name;
                            label: "Scene name";
                            init => { self.focus(); }
                            accepted(t) => {
                                root.rename(scene.id, t);
                                root.renaming = "";
                            }
                            changed has-focus => {
                                if (!self.has-focus && root.renaming == scene.id) {
                                    root.rename(scene.id, self.text);
                                    root.renaming = "";
                                }
                            }
                        }
                    }
                    if root.renaming != scene.id: Text {
                        text: scene.name;
                        color: scene.active ? Theme.text : Theme.text-muted;
                        font-size: Theme.font-m;
                        font-weight: scene.active ? 600 : 400;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if root.renaming != scene.id && (row-ta.has-hover || scene.active): HorizontalLayout {
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: Icons.pencil; tooltip: "Rename (F2)"; size: 24px; icon-size: 13px;
                                clicked => { root.renaming = scene.id; }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: Icons.copy; tooltip: "Duplicate scene"; size: 24px; icon-size: 13px;
                                clicked => { root.duplicate(scene.id); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: Icons.trash; tooltip: "Delete scene"; size: 24px; icon-size: 13px;
                                enabled: root.scenes.length > 1;
                                clicked => { root.remove(scene.id); }
                            }
                        }
                    }
                    if root.studio-mode && scene.live: VerticalLayout {
                        alignment: center;
                        Badge { text: "LIVE"; tone: Theme.live; }
                    }
                }
            }
        }
    }
    TransitionBar {
        kind: root.transition-kind;
        direction: root.transition-direction;
        duration: root.transition-duration;
        file: root.transition-file;
        point: root.transition-point;
        set(k, v) => { root.transition-set(k, v); }
        edit-shader => { root.edit-shader(); }
    }
}

/// Between Preview and Program in studio mode.
export component TransitionColumn inherits VerticalLayout {
    in property <string> label;
    in property <bool> busy;
    callback go(string);

    width: 116px;
    alignment: center;
    spacing: 8px;
    padding: 8px;
    Button {
        text: "Transition";
        kind: "primary";
        enabled: !root.busy;
        tooltip: "Send Preview to Program (" + root.label + ")";
        clicked => { root.go("go"); }
    }
    Button { text: "Cut"; kind: "ghost"; enabled: !root.busy; tooltip: "Switch instantly"; clicked => { root.go("cut"); } }
    Button { text: "Fade"; kind: "ghost"; enabled: !root.busy; tooltip: "Quick crossfade"; clicked => { root.go("fade"); } }
    Text {
        text: root.label;
        color: Theme.text-faint;
        font-size: Theme.font-xs;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}

/// Read-only view of the program output in studio mode.
export component ProgramView inherits Rectangle {
    in property <image> frame;
    in property <float> canvas-w: 1920;
    in property <float> canvas-h: 1080;
    property <float> fit: max(0.01, min((self.width - 48px) / 1px / canvas-w, (self.height - 48px) / 1px / canvas-h));

    background: Theme.bg;
    accessible-role: image;
    accessible-label: "Program output";
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.canvas-w * root.fit * 1px;
        height: root.canvas-h * root.fit * 1px;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.frame;
            image-fit: fill;
        }
        // Drawn over the image so the on-air frame is always visible.
        Rectangle {
            border-width: 2px;
            border-color: Theme.live;
        }
    }
    Rectangle {
        x: 12px;
        y: 10px;
        width: label.preferred-width + 14px;
        height: 20px;
        border-radius: 10px;
        background: Theme.live;
        label := Text { text: "PROGRAM"; color: Theme.on-accent; font-size: Theme.font-xs; font-weight: 700; }
    }
}

export component KindIcon inherits Icon {
    in property <string> kind;
    source: kind == "group" ? Icons.folder
        : kind == "color" ? Icons.palette
        : kind == "test_pattern" ? Icons.layout-dashboard
        : kind == "display_capture" ? Icons.monitor
        : kind == "window_capture" ? Icons.app-window
        : kind == "game_capture" ? Icons.gamepad
        : kind == "camera" ? Icons.camera
        : kind == "audio_input" ? Icons.mic
        : kind == "audio_output" || kind == "app_audio" || kind == "audio_test_tone" ? Icons.volume
        : kind == "image" ? Icons.image
        : kind == "text" ? Icons.type
        : kind == "browser" ? Icons.globe
        : kind == "media" ? Icons.film
        : Icons.square;
}

export component SourcesPanel inherits Panel {
    in property <[LayerRow]> layers;
    callback select(string);
    callback toggle-visible(string);
    callback toggle-lock(string);
    callback add();
    callback remove();
    callback move-up();
    callback move-down();
    callback group();

    PanelHeader {
        title: "SOURCES";
        icon: Icons.layers;
        IconButton { icon: Icons.chevron-up; tooltip: "Move up (Ctrl+])"; clicked => { root.move-up(); } }
        IconButton { icon: Icons.chevron-down; tooltip: "Move down (Ctrl+[)"; clicked => { root.move-down(); } }
        IconButton { icon: Icons.folder; tooltip: "Group (Ctrl+G)"; clicked => { root.group(); } }
        IconButton { icon: Icons.trash; tooltip: "Delete (Del)"; clicked => { root.remove(); } }
        IconButton { icon: Icons.plus; tooltip: "Add source (Ctrl+N)"; clicked => { root.add(); } }
    }
    if root.layers.length == 0: EmptyState {
        vertical-stretch: 1;
        icon: Icons.sparkles;
        title: "This scene is empty";
        body: "Add a source to start building your scene.";
        HorizontalLayout {
            alignment: center;
            Button { text: "Add source"; kind: "primary"; has-icon: true; icon: Icons.plus; clicked => { root.add(); } }
        }
    }
    if root.layers.length > 0: Flickable {
        vertical-stretch: 1;
        content-height: rows.preferred-height;
        rows := VerticalLayout {
            padding: 6px;
            spacing: 2px;
            alignment: start;
            for layer in root.layers: Rectangle {
                height: 34px;
                border-radius: Theme.radius-m;
                background: layer.selected ? Theme.accent-soft : layer-ta.has-hover ? Theme.hover : transparent;
                accessible-role: list-item;
                accessible-label: layer.name;
                accessible-item-selected: layer.selected;
                accessible-action-default => { root.select(layer.id); }
                layer-ta := TouchArea {
                    clicked => { root.select(layer.id); }
                }
                HorizontalLayout {
                    padding-left: 8px + layer.depth * 18px;
                    padding-right: 4px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        KindIcon {
                            kind: layer.kind;
                            size: 15px;
                            tint: layer.selected ? Theme.accent : Theme.text-muted;
                        }
                    }
                    Text {
                        text: layer.name;
                        color: !layer.visible ? Theme.text-faint : layer.selected ? Theme.text : Theme.text-muted;
                        font-size: Theme.font-m;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if layer.problem != "": VerticalLayout {
                        alignment: center;
                        Badge { text: "Unavailable"; tone: Theme.warn; }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: layer.locked ? Icons.lock : Icons.lock-open;
                            tooltip: layer.locked ? "Unlock" : "Lock";
                            size: 24px;
                            icon-size: 13px;
                            tint: layer.locked ? Theme.warn : Theme.text-faint;
                            opacity: layer.locked || layer-ta.has-hover ? 1 : 0;
                            clicked => { root.toggle-lock(layer.id); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: layer.visible ? Icons.eye : Icons.eye-off;
                            tooltip: layer.visible ? "Hide" : "Show";
                            size: 24px;
                            icon-size: 13px;
                            tint: layer.visible ? Theme.text-muted : Theme.text-faint;
                            clicked => { root.toggle-visible(layer.id); }
                        }
                    }
                }
            }
        }
    }
}

// Editor for one generic source property.
component PropEditor inherits VerticalLayout {
    in property <PropRow> prop;
    callback set-flag(bool);
    callback set-number(float);
    callback set-text(string);
    callback set-color(color);
    callback set-index(int);
    callback browse();
    callback commit();

    spacing: 4px;
    if prop.kind != "bool": Text {
        text: root.prop.label;
        color: Theme.text-muted;
        font-size: Theme.font-s;
    }
    if prop.kind == "bool": Toggle {
        label: root.prop.label;
        checked: root.prop.flag;
        toggled(v) => { root.set-flag(v); }
    }
    if prop.kind == "int" || prop.kind == "float": NumberField {
        label: "";
        value: root.prop.number;
        minimum: root.prop.minimum;
        maximum: root.prop.maximum;
        step: root.prop.step;
        decimals: root.prop.decimals;
        changed(v) => { root.set-number(v); }
        committed => { root.commit(); }
    }
    if prop.kind == "text": TextField {
        text: root.prop.text;
        label: root.prop.label;
        edited(t) => { root.set-text(t); }
        accepted => { root.commit(); }
    }
    if prop.kind == "multiline": TextArea {
        text: root.prop.text;
        label: root.prop.label;
        edited(t) => { root.set-text(t); }
    }
    if prop.kind == "select": Select {
        label: root.prop.label;
        options: root.prop.options;
        current-index: root.prop.index;
        selected(i) => { root.set-index(i); }
    }
    if prop.kind == "path": HorizontalLayout {
        spacing: 6px;
        TextField {
            text: root.prop.text;
            label: root.prop.label;
            placeholder: "No file selected";
            accepted(t) => { root.set-text(t); }
        }
        Button { text: "Browse…"; clicked => { root.browse(); } }
    }
    if prop.kind == "color": HorizontalLayout {
        spacing: 6px;
        Rectangle {
            width: 28px;
            height: 28px;
            border-radius: Theme.radius-s;
            background: root.prop.color;
            border-width: 1px;
            border-color: Theme.border-strong;
        }
        TextField {
            text: root.prop.text;
            label: root.prop.label;
            placeholder: "#rrggbb or #rrggbbaa";
            accepted(t) => { root.set-text(t); }
        }
    }
    if prop.kind == "color": HorizontalLayout {
        spacing: 6px;
        for swatch in [#ffffff, #000000, #6c8cff, #f0435a, #3dd68c, #f2b84b, #b06cff, #00b5d8]: Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 10px;
            background: swatch;
            border-width: 1px;
            border-color: Theme.border-strong;
            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.set-color(swatch); }
            }
        }
    }
    if prop.hint != "": Text {
        text: root.prop.hint;
        color: Theme.text-faint;
        font-size: Theme.font-xs;
        wrap: word-wrap;
    }
}

export component InspectorPanel inherits Panel {
    in property <Inspect> sel;
    in property <string> canvas-info;
    in property <string> gpu-info;
    callback edit(string, float);
    callback edit-text(string, string);
    callback edit-color(color);
    callback select-option(string, int);
    callback toggle(string, bool);
    in property <[PropRow]> props;
    in property <AudioInspect> audio;
    callback audio-set(string, float);
    callback filter-add(int);
    callback filter-remove(string);
    callback filter-toggle(string, bool);
    callback filter-param(string, string, float);
    callback filter-move(string, bool);
    in property <[VideoFilterRow]> video-filters;
    in property <MediaInspect> media;
    callback media-control(string);
    callback media-seek(float);
    in property <bool> browser: false;
    in property <string> browser-status;
    callback browser-reload();
    in property <[string]> video-filter-kinds;
    callback vfilter-add(int);
    callback vfilter-remove(string);
    callback vfilter-toggle(string, bool);
    callback vfilter-param(string, string, float);
    callback vfilter-move(string, bool);
    callback vfilter-browse(string);
    callback vfilter-code(string);
    callback commit();
    callback action(string);
    callback prop-flag(string, bool);
    callback prop-number(string, float);
    callback prop-text(string, string);
    callback prop-color(string, color);
    callback prop-index(string, int);
    callback prop-browse(string);
    callback prop-refresh();

    PanelHeader {
        title: "INSPECTOR";
        icon: Icons.sliders-horizontal;
    }

    if !root.sel.has: EmptyState {
        vertical-stretch: 1;
        icon: Icons.square;
        title: "Nothing selected";
        body: "Click a source in the preview or the list to edit its position, size, crop and appearance.";
        VerticalLayout {
            padding-top: 12px;
            spacing: 4px;
            Text { text: root.canvas-info; color: Theme.text-muted; font-size: Theme.font-s; horizontal-alignment: center; }
            Text { text: root.gpu-info; color: Theme.text-faint; font-size: Theme.font-xs; horizontal-alignment: center; wrap: word-wrap; }
        }
    }

    if root.sel.has: Flickable {
        vertical-stretch: 1;
        content-height: body.preferred-height;
        body := VerticalLayout {
            padding: 14px;
            spacing: 14px;
            alignment: start;

            // Identity
            HorizontalLayout {
                spacing: 10px;
                Rectangle {
                    width: 34px;
                    height: 34px;
                    border-radius: Theme.radius-m;
                    background: Theme.surface-3;
                    KindIcon { kind: root.sel.kind; size: 16px; tint: Theme.accent; }
                }
                VerticalLayout {
                    spacing: 3px;
                    TextField {
                        text: root.sel.name;
                        label: "Name";
                        accepted(t) => { root.edit-text("name", t); }
                    }
                    Text { text: root.sel.kind-label; color: Theme.text-faint; font-size: Theme.font-xs; }
                }
            }
            if root.sel.problem != "": Rectangle {
                border-radius: Theme.radius-m;
                background: Theme.warn.with-alpha(0.12);
                height: problem-text.preferred-height + 16px;
                problem-text := Text {
                    x: 10px;
                    width: parent.width - 20px;
                    text: root.sel.problem;
                    color: Theme.warn;
                    font-size: Theme.font-s;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
            }
            if !root.sel.no-video: HorizontalLayout {
                spacing: 16px;
                Toggle { label: "Visible"; checked: root.sel.visible; toggled(v) => { root.toggle("visible", v); } }
                Toggle { label: "Locked"; checked: root.sel.locked; toggled(v) => { root.toggle("locked", v); } }
            }

            // Transform
            if !root.sel.no-video: VerticalLayout {
                spacing: 8px;
                SectionTitle { text: "TRANSFORM"; }
                HorizontalLayout {
                    spacing: 8px;
                    NumberField { label: "X"; value: root.sel.x; step: 1; changed(v) => { root.edit("x", v); } committed => { root.commit(); } }
                    NumberField { label: "Y"; value: root.sel.y; step: 1; changed(v) => { root.edit("y", v); } committed => { root.commit(); } }
                }
                if !root.sel.group: HorizontalLayout {
                    spacing: 8px;
                    NumberField { label: "W"; value: root.sel.w; step: 1; minimum: 1; changed(v) => { root.edit("w", v); } committed => { root.commit(); } }
                    NumberField { label: "H"; value: root.sel.h; step: 1; minimum: 1; changed(v) => { root.edit("h", v); } committed => { root.commit(); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    NumberField { label: "R"; value: root.sel.rotation; step: 1; decimals: 1; suffix: "°"; minimum: -360; maximum: 360; changed(v) => { root.edit("rotation", v); } committed => { root.commit(); } }
                    if !root.sel.group: Select {
                        label: "Size mode";
                        options: ["Free scale", "Stretch", "Fit", "Fill"];
                        current-index: root.sel.size-mode;
                        selected(i) => { root.select-option("size-mode", i); }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Button { text: "Fit"; kind: "ghost"; tooltip: "Fit to canvas (Ctrl+F)"; clicked => { root.action("transform.fit"); } }
                    Button { text: "Stretch"; kind: "ghost"; tooltip: "Stretch to canvas"; clicked => { root.action("transform.stretch"); } }
                    Button { text: "Center"; kind: "ghost"; tooltip: "Center on canvas (Ctrl+E)"; clicked => { root.action("transform.center"); } }
                    Button { text: "Reset"; kind: "ghost"; tooltip: "Reset transform (Ctrl+R)"; clicked => { root.action("transform.reset"); } }
                }
            }

            // Crop
            if !root.sel.group && !root.sel.no-video: VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    SectionTitle { text: "CROP"; horizontal-stretch: 1; }
                    Text { text: "Alt-drag edges in the preview"; color: Theme.text-faint; font-size: Theme.font-xs; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    NumberField { label: "L"; value: root.sel.crop-l; minimum: 0; changed(v) => { root.edit("crop-l", v); } committed => { root.commit(); } }
                    NumberField { label: "R"; value: root.sel.crop-r; minimum: 0; changed(v) => { root.edit("crop-r", v); } committed => { root.commit(); } }
                }
                HorizontalLayout {
                    spacing: 8px;
                    NumberField { label: "T"; value: root.sel.crop-t; minimum: 0; changed(v) => { root.edit("crop-t", v); } committed => { root.commit(); } }
                    NumberField { label: "B"; value: root.sel.crop-b; minimum: 0; changed(v) => { root.edit("crop-b", v); } committed => { root.commit(); } }
                }
            }

            // Appearance
            if !root.sel.no-video: VerticalLayout {
                spacing: 8px;
                SectionTitle { text: "APPEARANCE"; }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Opacity"; color: Theme.text-muted; font-size: Theme.font-s; vertical-alignment: center; width: 56px; }
                    Slider {
                        label: "Opacity";
                        value: root.sel.opacity;
                        changed(v) => { root.edit("opacity", v); }
                        committed => { root.commit(); }
                    }
                    Text { text: round(root.sel.opacity * 100) + "%"; color: Theme.text-muted; font-size: Theme.font-s; vertical-alignment: center; width: 36px; horizontal-alignment: right; }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Blend"; color: Theme.text-muted; font-size: Theme.font-s; vertical-alignment: center; width: 56px; }
                    Select {
                        label: "Blend mode";
                        options: ["Normal", "Additive", "Multiply", "Screen"];
                        current-index: root.sel.blend;
                        selected(i) => { root.select-option("blend", i); }
                    }
                }
            }

            // Audio (sources that produce sound)
            if root.audio.has: VerticalLayout {
                spacing: 10px;
                SectionTitle { text: "AUDIO"; }
                HorizontalLayout {
                    spacing: 8px;
                    NumberField { label: "dB"; value: root.audio.volume-db; step: 0.5; decimals: 1; minimum: -100; maximum: 26; changed(v) => { root.audio-set("volume", v); } committed => { root.commit(); } }
                    Toggle { label: "Mute"; checked: root.audio.muted; toggled(v) => { root.audio-set("muted", v ? 1 : 0); } }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Balance"; color: Theme.text-muted; font-size: Theme.font-s; vertical-alignment: center; width: 56px; }
                    Slider { label: "Balance"; value: root.audio.balance; changed(v) => { root.audio-set("balance", v); } committed => { root.commit(); } }
                    Text {
                        text: abs(root.audio.balance - 0.5) < 0.01 ? "C" : root.audio.balance < 0.5 ? "L" + round((0.5 - root.audio.balance) * 200) : "R" + round((root.audio.balance - 0.5) * 200);
                        color: Theme.text-muted; font-size: Theme.font-s; vertical-alignment: center; width: 36px; horizontal-alignment: right;
                    }
                }
                HorizontalLayout {
                    spacing: 16px;
                    Toggle { label: "Mono"; checked: root.audio.mono; toggled(v) => { root.audio-set("mono", v ? 1 : 0); } }
                    Toggle { label: "All scenes"; checked: root.audio.global; toggled(v) => { root.audio-set("global", v ? 1 : 0); } }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Sync offset"; color: Theme.text-muted; font-size: Theme.font-s; vertical-alignment: center; width: 80px; }
                    NumberField { label: "ms"; value: root.audio.sync-ms; step: 10; minimum: 0; maximum: 2000; changed(v) => { root.audio-set("sync", v); } committed => { root.commit(); } }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Monitoring"; color: Theme.text-muted; font-size: Theme.font-s; vertical-alignment: center; width: 80px; }
                    Select {
                        label: "Monitoring";
                        options: ["Off", "Monitor only (mute output)", "Monitor and output"];
                        current-index: root.audio.monitoring;
                        selected(i) => { root.audio-set("monitoring", i); }
                    }
                }
                HorizontalLayout {
                    spacing: 4px;
                    Text { text: "Tracks"; color: Theme.text-muted; font-size: Theme.font-s; vertical-alignment: center; width: 80px; }
                    for t in [0, 1, 2, 3, 4, 5]: Rectangle {
                        property <bool> on: mod(floor(root.audio.tracks / pow(2, t)), 2) == 1;
                        width: 26px;
                        height: 24px;
                        border-radius: Theme.radius-s;
                        background: on ? Theme.accent : Theme.surface-3;
                        accessible-role: checkbox;
                        accessible-label: "Track " + (t + 1);
                        accessible-checked: on;
                        Text { text: t + 1; color: on ? Theme.on-accent : Theme.text-muted; font-size: Theme.font-s; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.audio-set("tracks", on ? root.audio.tracks - pow(2, t) : root.audio.tracks + pow(2, t)); }
                        }
                    }
                }
                HorizontalLayout {
                    SectionTitle { text: "FILTERS"; horizontal-stretch: 1; vertical-alignment: center; }
                    Select {
                        width: 150px;
                        label: "Add filter";
                        options: ["+ Add filter…", "Noise suppression", "Noise gate", "Compressor", "Limiter", "Gain"];
                        current-index: 0;
                        selected(i) => { if (i > 0) { root.filter-add(i - 1); } }
                    }
                }
                if root.audio.filters.length == 0: Text {
                    text: "No filters. Noise suppression and a limiter are a good start for microphones.";
                    color: Theme.text-faint;
                    font-size: Theme.font-xs;
                    wrap: word-wrap;
                }
                for filter in root.audio.filters: Rectangle {
                    border-radius: Theme.radius-m;
                    background: Theme.surface-2;
                    border-width: 1px;
                    border-color: Theme.border;
                    height: filter-body.preferred-height;
                    filter-body := VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 2px;
                            Toggle { checked: filter.enabled; toggled(v) => { root.filter-toggle(filter.id, v); } }
                            Text { text: filter.name; color: filter.enabled ? Theme.text : Theme.text-faint; font-size: Theme.font-s; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                            IconButton { icon: Icons.chevron-up; tooltip: "Move up"; size: 22px; icon-size: 12px; clicked => { root.filter-move(filter.id, true); } }
                            IconButton { icon: Icons.chevron-down; tooltip: "Move down"; size: 22px; icon-size: 12px; clicked => { root.filter-move(filter.id, false); } }
                            IconButton { icon: Icons.trash; tooltip: "Remove filter"; size: 22px; icon-size: 12px; clicked => { root.filter-remove(filter.id); } }
                        }
                        for param in filter.params: HorizontalLayout {
                            spacing: 8px;
                            Text { text: param.label; color: Theme.text-muted; font-size: Theme.font-xs; vertical-alignment: center; width: 96px; }
                            NumberField {
                                label: "";
                                value: param.value;
                                minimum: param.minimum;
                                maximum: param.maximum;
                                step: param.step;
                                decimals: param.step < 1 ? 1 : 0;
                                suffix: param.unit;
                                changed(v) => { root.filter-param(filter.id, param.key, v); }
                                committed => { root.commit(); }
                            }
                        }
                    }
                }
            }

            // Source settings (generic, from the source type's schema)
            if !root.sel.group && root.props.length > 0: VerticalLayout {
                spacing: 10px;
                HorizontalLayout {
                    SectionTitle { text: "SOURCE"; horizontal-stretch: 1; vertical-alignment: center; }
                    IconButton {
                        icon: Icons.refresh;
                        tooltip: "Refresh devices and windows";
                        size: 22px;
                        icon-size: 13px;
                        clicked => { root.prop-refresh(); }
                    }
                }
                for prop in root.props: PropEditor {
                    prop: prop;
                    set-flag(v) => { root.prop-flag(prop.key, v); }
                    set-number(v) => { root.prop-number(prop.key, v); }
                    set-text(v) => { root.prop-text(prop.key, v); }
                    set-color(v) => { root.prop-color(prop.key, v); }
                    set-index(i) => { root.prop-index(prop.key, i); }
                    browse => { root.prop-browse(prop.key); }
                    commit => { root.commit(); }
                }
            }

            // Browser page status and refresh
            if root.browser: VerticalLayout {
                spacing: 8px;
                SectionTitle { text: "PAGE"; }
                HorizontalLayout {
                    spacing: 8px;
                    Text { text: root.browser-status; color: Theme.text-muted; font-size: Theme.font-xs; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                    Button { text: "Refresh"; icon: Icons.refresh; has-icon: true; tooltip: "Reload the page"; clicked => { root.browser-reload(); } }
                }
            }

            // Media playback controls
            if root.media.has: VerticalLayout {
                spacing: 8px;
                SectionTitle { text: "MEDIA"; }
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: root.media.item; color: Theme.text; font-size: Theme.font-s; font-weight: 600; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                    if root.media.index != "": Badge { text: root.media.index; }
                }
                // Seek bar
                Rectangle {
                    height: 14px;
                    seek-ta := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { root.media-seek(clamp(self.mouse-x / self.width, 0, 1)); }
                    }
                    Rectangle {
                        y: (parent.height - 4px) / 2;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.surface-3;
                    }
                    Rectangle {
                        x: 0;
                        y: (parent.height - 4px) / 2;
                        width: parent.width * clamp(root.media.progress, 0, 1);
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.accent;
                    }
                }
                HorizontalLayout {
                    spacing: 2px;
                    IconButton { icon: Icons.skip-back; tooltip: "Previous item"; size: 26px; icon-size: 13px; clicked => { root.media-control("previous"); } }
                    IconButton { icon: root.media.paused || root.media.ended ? Icons.play : Icons.pause; tooltip: root.media.paused ? "Play" : root.media.ended ? "Play again" : "Pause"; size: 26px; icon-size: 13px; clicked => { root.media-control(root.media.ended ? "restart" : "toggle"); } }
                    IconButton { icon: Icons.refresh; tooltip: "Restart"; size: 26px; icon-size: 13px; clicked => { root.media-control("restart"); } }
                    IconButton { icon: Icons.skip-forward; tooltip: "Next item"; size: 26px; icon-size: 13px; clicked => { root.media-control("next"); } }
                    Text { text: root.media.time; color: Theme.text-muted; font-size: Theme.font-xs; horizontal-alignment: right; vertical-alignment: center; horizontal-stretch: 1; }
                }
            }

            // Video filters of the selected item's source
            if !root.sel.group && !root.sel.no-video && root.video-filter-kinds.length > 0: VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    SectionTitle { text: "VIDEO FILTERS"; horizontal-stretch: 1; vertical-alignment: center; }
                    Select {
                        width: 150px;
                        label: "Add video filter";
                        options: root.video-filter-kinds;
                        current-index: 0;
                        selected(i) => { if (i > 0) { root.vfilter-add(i - 1); } }
                    }
                }
                if root.video-filters.length == 0: Text {
                    text: "No filters. Try a chroma key for green screens or color correction to match cameras.";
                    color: Theme.text-faint;
                    font-size: Theme.font-xs;
                    wrap: word-wrap;
                }
                for filter in root.video-filters: Rectangle {
                    border-radius: Theme.radius-m;
                    background: Theme.surface-2;
                    border-width: 1px;
                    border-color: Theme.border;
                    height: vfilter-body.preferred-height;
                    vfilter-body := VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 2px;
                            Toggle { checked: filter.enabled; toggled(v) => { root.vfilter-toggle(filter.id, v); } }
                            Text { text: filter.name; color: filter.enabled ? Theme.text : Theme.text-faint; font-size: Theme.font-s; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                            IconButton { icon: Icons.chevron-up; tooltip: "Move up"; size: 22px; icon-size: 12px; clicked => { root.vfilter-move(filter.id, true); } }
                            IconButton { icon: Icons.chevron-down; tooltip: "Move down"; size: 22px; icon-size: 12px; clicked => { root.vfilter-move(filter.id, false); } }
                            IconButton { icon: Icons.trash; tooltip: "Remove filter"; size: 22px; icon-size: 12px; clicked => { root.vfilter-remove(filter.id); } }
                        }
                        if filter.file-label != "": HorizontalLayout {
                            spacing: 8px;
                            Text { text: filter.file-label; color: Theme.text-muted; font-size: Theme.font-xs; vertical-alignment: center; width: 96px; wrap: word-wrap; }
                            Text {
                                text: filter.file != "" ? filter.file : "No file chosen";
                                color: filter.file != "" ? Theme.text : Theme.text-faint;
                                font-size: Theme.font-xs;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            Button { text: "Browse…"; kind: "ghost"; clicked => { root.vfilter-browse(filter.id); } }
                        }
                        if filter.code: Button {
                            text: "Edit shader…";
                            has-icon: true;
                            icon: Icons.sparkles;
                            kind: "ghost";
                            clicked => { root.vfilter-code(filter.id); }
                        }
                        for param in filter.params: HorizontalLayout {
                            spacing: 8px;
                            Text { text: param.label; color: Theme.text-muted; font-size: Theme.font-xs; vertical-alignment: center; width: 96px; }
                            NumberField {
                                label: "";
                                value: param.value;
                                minimum: param.minimum;
                                maximum: param.maximum;
                                step: param.step;
                                decimals: param.step < 0.1 ? 2 : param.step < 1 ? 1 : 0;
                                suffix: param.unit;
                                changed(v) => { root.vfilter-param(filter.id, param.key, v); }
                                committed => { root.commit(); }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Horizontal stereo level meter (-60..0 dB): RMS body, peak tip, peak-hold tick.
component LevelMeter inherits Rectangle {
    in property <float> level-l;
    in property <float> level-r;
    in property <float> rms-l;
    in property <float> rms-r;
    in property <float> hold-l;
    in property <float> hold-r;
    in property <bool> dim;

    height: 11px;
    property <brush> fill: @linear-gradient(90deg, Theme.ok 0%, Theme.ok 66%, Theme.warn 85%, Theme.live 100%);

    for ch in [
        { y: 0px, level: root.level-l, rms: root.rms-l, hold: root.hold-l },
        { y: 6px, level: root.level-r, rms: root.rms-r, hold: root.hold-r },
    ]: Rectangle {
        y: ch.y;
        height: 5px;
        border-radius: 1px;
        background: Theme.surface-3;
        clip: true;
        // Peak (faint) then RMS (solid), both revealing the same gradient.
        Rectangle {
            x: 0;
            width: parent.width * clamp(ch.level, 0, 1);
            clip: true;
            Rectangle { x: 0; width: root.width; background: root.fill; opacity: root.dim ? 0.2 : 0.45; }
        }
        Rectangle {
            x: 0;
            width: parent.width * clamp(ch.rms, 0, 1);
            clip: true;
            Rectangle { x: 0; width: root.width; background: root.fill; opacity: root.dim ? 0.35 : 1; }
        }
        if ch.hold > 0.001: Rectangle {
            x: parent.width * clamp(ch.hold, 0, 1) - 1px;
            width: 2px;
            background: ch.hold > 0.95 ? Theme.live : Theme.text;
        }
    }
}

component MixerRow inherits Rectangle {
    in property <MixerStrip> strip;
    in property <bool> master;
    callback select();
    callback fader(float);
    callback commit();
    callback toggle-mute();

    height: 52px;
    border-radius: Theme.radius-m;
    background: strip.selected ? Theme.accent-soft : row-ta.has-hover ? Theme.hover : transparent;
    row-ta := TouchArea { clicked => { root.select(); } }

    VerticalLayout {
        padding-left: 10px;
        padding-right: 6px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.strip.name;
                color: root.strip.muted ? Theme.text-faint : Theme.text;
                font-size: Theme.font-s;
                font-weight: root.master ? 700 : 500;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            if root.strip.global: Text { text: "ALL SCENES"; color: Theme.text-faint; font-size: 9px; font-weight: 700; vertical-alignment: center; }
            if root.strip.monitoring: Icon { source: Icons.volume; size: 12px; tint: Theme.accent; y: 2px; }
            if root.strip.problem != "": Text { text: "●"; color: Theme.warn; font-size: Theme.font-s; vertical-alignment: center; }
            if !root.master: Text {
                text: root.strip.muted ? "Muted" : root.strip.volume-db <= -60 ? "-∞ dB" : root.strip.volume-db.to-fixed(1) + " dB";
                color: root.strip.muted ? Theme.live : Theme.text-muted;
                font-size: Theme.font-xs;
                width: 52px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 3px;
                LevelMeter {
                    level-l: root.strip.level-l;
                    level-r: root.strip.level-r;
                    rms-l: root.strip.rms-l;
                    rms-r: root.strip.rms-r;
                    hold-l: root.strip.hold-l;
                    hold-r: root.strip.hold-r;
                    dim: root.strip.muted;
                }
                if !root.master: Slider {
                    height: 12px;
                    label: root.strip.name + " volume";
                    value: root.strip.fader;
                    changed(v) => { root.fader(v); }
                    committed => { root.commit(); }
                }
            }
            if !root.master: VerticalLayout {
                alignment: center;
                IconButton {
                    icon: root.strip.muted ? Icons.volume-x : Icons.volume;
                    tooltip: root.strip.muted ? "Unmute" : "Mute";
                    toggled: root.strip.muted;
                    tint: root.strip.muted ? Theme.live : Theme.text-muted;
                    size: 26px;
                    icon-size: 14px;
                    clicked => { root.toggle-mute(); }
                }
            }
        }
    }
}

export component MixerPanel inherits Panel {
    in property <[MixerStrip]> strips;
    in property <MixerStrip> master;
    callback select(string);
    callback fader(string, float);
    callback commit();
    callback toggle-mute(string);
    callback add();

    PanelHeader {
        title: "AUDIO MIXER";
        icon: Icons.volume;
        IconButton { icon: Icons.plus; tooltip: "Add audio source"; clicked => { root.add(); } }
    }
    VerticalLayout {
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 6px;
        MixerRow { strip: root.master; master: true; }
        Rectangle { height: 1px; background: Theme.border; }
    }
    if root.strips.length == 0: EmptyState {
        vertical-stretch: 1;
        icon: Icons.mic;
        title: "No audio sources";
        body: "Add a microphone, desktop audio or an application.";
    }
    if root.strips.length > 0: Flickable {
        vertical-stretch: 1;
        content-height: strip-list.preferred-height;
        strip-list := VerticalLayout {
            padding: 6px;
            spacing: 2px;
            alignment: start;
            for strip in root.strips: MixerRow {
                strip: strip;
                select => { root.select(strip.id); }
                fader(v) => { root.fader(strip.id, v); }
                commit => { root.commit(); }
                toggle-mute => { root.toggle-mute(strip.id); }
            }
        }
    }
}
export component StatusBar inherits Rectangle {
    in property <float> fps;
    in property <float> target-fps;
    in property <float> render-ms;
    in property <int> lagged;
    in property <string> gpu;
    in property <string> message;
    /// Live stream summary; `stream-health` 0 = not streaming, 1 good, 2 congested, 3 failing.
    in property <string> stream-info;
    in property <int> stream-health;

    height: 28px;
    background: Theme.bg;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;
        HorizontalLayout {
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: root.lagged > 0 ? Theme.warn : Theme.ok;
                }
            }
            Text {
                text: root.fps.to-fixed(1) + " / " + root.target-fps.to-fixed(root.target-fps == round(root.target-fps) ? 0 : 2) + " fps";
                color: Theme.text-muted;
                font-size: Theme.font-xs;
                vertical-alignment: center;
            }
        }
        Text { text: "render " + root.render-ms.to-fixed(2) + " ms"; color: Theme.text-muted; font-size: Theme.font-xs; vertical-alignment: center; }
        Text {
            text: root.lagged + " lagged";
            color: root.lagged > 0 ? Theme.warn : Theme.text-muted;
            font-size: Theme.font-xs;
            font-weight: root.lagged > 0 ? 700 : 400;
            vertical-alignment: center;
        }
        Text { text: root.gpu; color: Theme.text-faint; font-size: Theme.font-xs; vertical-alignment: center; overflow: elide; }
        Rectangle { horizontal-stretch: 1; }
        if root.stream-health > 0: HorizontalLayout {
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: root.stream-health == 1 ? Theme.ok : root.stream-health == 2 ? Theme.warn : Theme.live;
                }
            }
            Text {
                text: root.stream-info;
                color: root.stream-health == 1 ? Theme.text-muted : root.stream-health == 2 ? Theme.warn : Theme.live;
                font-size: Theme.font-xs;
                vertical-alignment: center;
            }
        }
        Text { text: root.message; color: Theme.text-faint; font-size: Theme.font-xs; vertical-alignment: center; }
    }
}

/// One tab per canvas above the preview, plus a picker to add canvases.
export component CanvasTabs inherits HorizontalLayout {
    in property <[CanvasTab]> tabs;
    in property <[string]> presets;
    in-out property <string> renaming;
    callback select(string);
    callback add(int);
    callback remove(string);
    callback rename(string, string);

    spacing: 4px;
    height: 34px;
    for ct in root.tabs: Rectangle {
        property <bool> hovered: tab-ta.has-hover;
        width: tab-row.preferred-width;
        border-radius: Theme.radius-m;
        background: ct.active ? Theme.surface-2 : hovered ? Theme.hover : transparent;
        border-width: ct.active ? 1px : 0px;
        border-color: Theme.border;
        accessible-role: tab;
        accessible-label: ct.name;
        accessible-item-selected: ct.active;
        tab-ta := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.select(ct.id); }
            double-clicked => { root.renaming = ct.id; }
        }
        tab-row := HorizontalLayout {
            padding-left: 12px;
            padding-right: 6px;
            spacing: 8px;
            if root.renaming == ct.id: VerticalLayout {
                alignment: center;
                TextField {
                    width: 140px;
                    text: ct.name;
                    label: "Canvas name";
                    init => { self.focus(); }
                    accepted(t) => {
                        root.rename(ct.id, t);
                        root.renaming = "";
                    }
                    changed has-focus => {
                        if (!self.has-focus && root.renaming == ct.id) {
                            root.rename(ct.id, self.text);
                            root.renaming = "";
                        }
                    }
                }
            }
            if root.renaming != ct.id: Text {
                text: ct.name;
                color: ct.active ? Theme.text : Theme.text-muted;
                font-size: Theme.font-s;
                font-weight: ct.active ? 600 : 400;
                vertical-alignment: center;
            }
            if root.renaming != ct.id: Text {
                text: ct.info;
                color: Theme.text-faint;
                font-size: Theme.font-xs;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.x;
                    tooltip: "Remove canvas " + ct.name;
                    size: 20px;
                    icon-size: 11px;
                    enabled: root.tabs.length > 1;
                    opacity: (hovered || ct.active) && root.tabs.length > 1 ? 1 : 0;
                    clicked => { root.remove(ct.id); }
                }
            }
        }
    }
    VerticalLayout {
        alignment: center;
        Select {
            width: 150px;
            label: "Add canvas";
            options: root.presets;
            current-index: 0;
            selected(i) => { if (i > 0) { root.add(i - 1); } }
        }
    }
    Rectangle { horizontal-stretch: 1; }
}

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { CanvasTab, SceneRow, LayerRow, MixerStrip } from "types.slint";
import {
    Button, IconButton, Icon, TextField, NumberField, Slider, Select, Panel, PanelHeader, Badge,
    EmptyState, Hint,
} from "widgets.slint";

/// One row of a popup menu.
export component MenuRow inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> danger;
    in property <bool> enabled: true;
    /// A row under the one before it (no icon of its own).
    in property <bool> indent;
    callback clicked();

    height: 28px;
    border-radius: Theme.radius-s;
    background: ta.has-hover && root.enabled ? Theme.hover : transparent;
    opacity: root.enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            width: 14px;
            if !root.indent: Icon { source: root.icon; size: 14px; tint: root.danger ? Theme.live : Theme.text-muted; }
        }
        Text {
            text: root.label;
            color: root.danger ? Theme.live : root.indent ? Theme.text-muted : Theme.text;
            font-size: Theme.font-m;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// The open setup (scenes, sources and audio) as a menu: switch, new, rename, duplicate, delete.
component SetupMenu inherits Rectangle {
    in property <string> name;
    in property <bool> dirty;
    /// Short canvas tag ("1080p60") and the full description for the tooltip.
    in property <string> canvas-tag;
    in property <string> canvas-info;
    in property <[string]> setups;
    in property <int> current;
    callback pick(int);
    callback act(string);

    property <string> tip: "Your setup: scenes, sources and audio. Click to switch or manage setups. Canvas: " + root.canvas-info;
    height: 28px;
    width: row.preferred-width;
    border-radius: Theme.radius-s;
    background: ta.has-hover || popup-open ? Theme.hover : Theme.surface-2;
    accessible-role: combobox;
    accessible-label: "Setup";
    accessible-value: root.name;
    property <bool> popup-open: false;

    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Icon { source: Icons.layers; size: 14px; }
        }
        Text {
            text: root.name + (root.dirty ? " •" : "");
            color: Theme.text;
            font-size: Theme.font-s;
            font-weight: 600;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                height: 18px;
                width: tag.preferred-width + 10px;
                border-radius: 4px;
                background: Theme.surface-3;
                tag := Text {
                    text: root.canvas-tag;
                    color: Theme.text-muted;
                    font-size: Theme.font-xs;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Icon { source: Icons.chevron-down; size: 14px; }
        }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            Hint.text = "";
            popup.show();
        }
        changed has-hover => {
            if (self.has-hover) {
                Hint.text = root.tip;
                Hint.x = root.absolute-position.x + root.width / 2;
                Hint.y = root.absolute-position.y + root.height + 6px;
            } else if (Hint.text == root.tip) {
                Hint.text = "";
            }
        }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: max(root.width, 240px);
        Rectangle {
            background: Theme.surface-3;
            border-radius: Theme.radius-m;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000060;
            VerticalLayout {
                padding: 4px;
                HorizontalLayout {
                    padding-left: 8px;
                    Text {
                        text: "SETUPS";
                        color: Theme.text-faint;
                        font-size: Theme.font-xs;
                        font-weight: 700;
                        height: 24px;
                        vertical-alignment: center;
                    }
                }
                for setup[i] in root.setups: Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-s;
                    background: setup-ta.has-hover ? Theme.hover : transparent;
                    accessible-role: button;
                    accessible-label: setup;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            width: 14px;
                            if i == root.current: Icon { source: Icons.check; size: 14px; tint: Theme.accent; }
                        }
                        Text {
                            text: setup;
                            color: Theme.text;
                            font-size: Theme.font-m;
                            font-weight: i == root.current ? 600 : 400;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    setup-ta := TouchArea {
                        clicked => { root.pick(i); }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                for item in [
                    { id: "new", label: "New setup…", icon: Icons.plus, danger: false },
                    { id: "rename", label: "Rename…", icon: Icons.pencil, danger: false },
                    { id: "duplicate", label: "Duplicate", icon: Icons.copy, danger: false },
                    { id: "delete", label: "Delete…", icon: Icons.trash, danger: true },
                ]: Rectangle {
                    // Deleting the only setup isn't possible.
                    property <bool> enabled: item.id != "delete" || root.setups.length > 1;
                    height: 28px;
                    border-radius: Theme.radius-s;
                    background: item-ta.has-hover && self.enabled ? Theme.hover : transparent;
                    opacity: self.enabled ? 1 : 0.4;
                    accessible-role: button;
                    accessible-label: item.label;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            width: 14px;
                            Icon { source: item.icon; size: 14px; tint: item.danger ? Theme.live : Theme.text-muted; }
                        }
                        Text {
                            text: item.label;
                            color: item.danger ? Theme.live : Theme.text;
                            font-size: Theme.font-m;
                            vertical-alignment: center;
                        }
                    }
                    item-ta := TouchArea {
                        enabled: parent.enabled;
                        clicked => { root.act(item.id); }
                    }
                }
            }
        }
    }
}

export component TopBar inherits Rectangle {
    in property <string> collection-name;
    in property <string> canvas-info;
    in property <string> canvas-tag;
    in property <[string]> setups;
    in property <int> setup-index;
    callback setup-pick(int);
    callback setup-action(string);
    in property <bool> dirty;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> recording;
    in property <string> record-time;
    in property <bool> replay-active;
    in property <int> stream-state;
    /// 0 off, 1 starting or installing, 2 on, 3 in use by an app.
    in property <int> vcam-state;
    in property <string> vcam-tooltip;
    callback toggle-vcam();
    callback open-automation();
    callback open-clips();
    in property <string> stream-time;
    callback open-palette();
    callback toggle-stream();
    callback show-deck();
    in property <bool> studio-mode;
    /// The version an update is ready to install ("" = none).
    in property <string> update-ready;
    callback update-restart();
    callback toggle-studio();
    callback open-destinations();
    in property <bool> live-panel-open;
    callback undo();
    callback redo();
    callback toggle-theme();
    callback toggle-record();
    callback toggle-replay();
    callback save-replay();
    callback open-settings();

    height: 52px;
    background: Theme.bg;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 12px;
        spacing: 8px;

        // Brand
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Image { source: Icons.logo; width: 26px; height: 26px; }
            }
            Text {
                text: "CLUTCH";
                color: Theme.text;
                font-family: Theme.font-display;
                font-size: 17px;
                font-weight: 600;
                letter-spacing: 2px;
                vertical-alignment: center;
            }
        }
        Rectangle { width: 10px; }
        VerticalLayout {
            alignment: center;
            SetupMenu {
                name: root.collection-name;
                dirty: root.dirty;
                canvas-tag: root.canvas-tag;
                canvas-info: root.canvas-info;
                setups: root.setups;
                current: root.setup-index;
                pick(i) => { root.setup-pick(i); }
                act(id) => { root.setup-action(id); }
            }
        }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 2px;
                IconButton { icon: Icons.undo; tooltip: "Undo (Ctrl+Z)"; enabled: root.can-undo; clicked => { root.undo(); } }
                IconButton { icon: Icons.redo; tooltip: "Redo (Ctrl+Shift+Z)"; enabled: root.can-redo; clicked => { root.redo(); } }
            }
        }

        Rectangle { horizontal-stretch: 1; }

        // Command palette launcher
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 260px;
                height: 30px;
                border-radius: Theme.radius-s;
                background: palette-ta.has-hover ? Theme.surface-3 : Theme.surface-2;
                border-width: 1px;
                border-color: Theme.border;
                accessible-role: button;
                accessible-label: "Open command palette";
                accessible-action-default => { root.open-palette(); }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 6px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Icon { source: Icons.search; size: 14px; tint: Theme.text-faint; }
                    }
                    Text {
                        text: "Search actions, scenes, sources…";
                        color: Theme.text-faint;
                        font-size: Theme.font-s;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        alignment: center;
                        Badge { text: "Ctrl K"; }
                    }
                }
                palette-ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.open-palette(); }
                }
            }
        }

        Rectangle { horizontal-stretch: 1; }

        if root.update-ready != "": VerticalLayout {
            alignment: center;
            Button {
                text: "Restart to update";
                has-icon: true;
                icon: Icons.refresh;
                kind: "ghost";
                tooltip: "Clutch " + root.update-ready + " is ready. It also installs when you close Clutch.";
                clicked => { root.update-restart(); }
            }
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: "Studio mode";
                has-icon: true;
                icon: Icons.layout-dashboard;
                kind: root.studio-mode ? "primary" : "ghost";
                tooltip: root.studio-mode ? "Leave studio mode (Ctrl+Shift+T)" : "Prepare scenes off-air (Ctrl+Shift+T)";
                clicked => { root.toggle-studio(); }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Theme.dark ? Icons.sun : Icons.moon;
                tooltip: Theme.dark ? "Switch to light theme" : "Switch to dark theme";
                clicked => { root.toggle-theme(); }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.zap;
                tooltip: "Automation: hotkeys, macros and triggers";
                clicked => { root.open-automation(); }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.film;
                tooltip: "Clips: your saved highlights";
                clicked => { root.open-clips(); }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.settings;
                tooltip: "Settings (Ctrl+,)";
                clicked => { root.open-settings(); }
            }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: vcam-button.width;
                height: vcam-button.height;
                vcam-button := IconButton {
                    icon: Icons.camera;
                    toggled: root.vcam-state >= 2;
                    tooltip: root.vcam-tooltip;
                    clicked => { root.toggle-vcam(); }
                }
                // Live dot while an app is receiving the camera.
                if root.vcam-state == 3: Rectangle {
                    x: parent.width - 9px;
                    y: 3px;
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: Theme.live;
                }
                // Pulsing ring while starting or installing.
                if root.vcam-state == 1: Rectangle {
                    border-radius: Theme.radius-s;
                    border-width: 1px;
                    border-color: Theme.accent.with-alpha(0.4 + 0.4 * Math.sin(animation-tick() / 300ms * 1rad));
                }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.rotate-cw;
                toggled: root.replay-active;
                tooltip: root.replay-active ? "Stop replay buffer" : "Start replay buffer";
                clicked => { root.toggle-replay(); }
            }
        }
        if root.replay-active: VerticalLayout {
            alignment: center;
            Button {
                text: "Save clip";
                kind: "ghost";
                tooltip: "Save the last seconds to your clips (Ctrl+Shift+R or the clip hotkey)";
                clicked => { root.save-replay(); }
            }
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: root.recording ? root.record-time : "Record";
                has-icon: true;
                icon: root.recording ? Icons.square : Icons.circle;
                kind: root.recording ? "live" : "default";
                active: root.recording;
                tooltip: root.recording ? "Stop recording" : "Start recording";
                clicked => { root.toggle-record(); }
            }
        }
        // While live and editing: back to the Live deck.
        if root.stream-state != 0: VerticalLayout {
            alignment: center;
            Button {
                text: "Live deck";
                kind: "primary";
                has-icon: true;
                icon: Icons.layout-dashboard;
                tooltip: "Back to the live controls";
                clicked => { root.show-deck(); }
            }
        }
        VerticalLayout {
            alignment: center;
            // stream-state: 0 off, 1 connecting, 2 live, 3 reconnecting
            Button {
                text: root.stream-state == 0 ? "Go Live"
                    : root.stream-state == 1 ? "Connecting…"
                    : root.stream-state == 3 ? "Reconnecting…"
                    : root.stream-time;
                has-icon: true;
                icon: root.stream-state == 2 ? Icons.square : Icons.radio;
                kind: root.stream-state == 3 ? "danger" : root.stream-state == 1 ? "default" : "live";
                active: root.stream-state == 2;
                tooltip: root.stream-state == 0 ? "Go live on all enabled destinations" : "End the stream everywhere";
                clicked => { root.toggle-stream(); }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.chevron-down;
                toggled: root.live-panel-open;
                tooltip: "Destinations";
                clicked => { root.open-destinations(); }
            }
        }
    }
}

/// Transition used when the program scene changes (bottom of the Scenes panel).
export component TransitionBar inherits Rectangle {
    // kind: 0 cut, 1 fade, 2 fade to black, 3 slide, 4 swipe, 5 wipe, 6 custom shader, 7 stinger
    in property <int> kind;
    in property <int> direction;
    in property <float> duration;
    /// Stinger video file name and switch point (ms).
    in property <string> file;
    in property <float> point;
    callback set(string, float);
    callback edit-shader();

    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        Text { text: "TRANSITION"; color: Theme.text-faint; font-size: Theme.font-xs; font-weight: 700; }
        HorizontalLayout {
            spacing: 6px;
            Select {
                label: "Transition";
                options: ["Cut", "Fade", "Fade to black", "Slide", "Swipe", "Wipe", "Custom shader…", "Stinger…"];
                current-index: root.kind;
                selected(i) => { root.set("kind", i); }
            }
            if root.kind != 0: NumberField {
                width: 92px;
                label: "";
                value: root.duration;
                minimum: 50;
                maximum: 10000;
                step: 50;
                suffix: "ms";
                changed(v) => { root.set("duration", v); }
            }
        }
        if root.kind >= 3 && root.kind <= 5: Select {
            label: "Direction";
            options: ["Towards the left", "Towards the right", "Upwards", "Downwards"];
            current-index: root.direction;
            selected(i) => { root.set("direction", i); }
        }
        if root.kind == 6: Button {
            text: "Edit shader…";
            has-icon: true;
            icon: Icons.sparkles;
            kind: "ghost";
            clicked => { root.edit-shader(); }
        }
        if root.kind == 7: HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.file != "" ? root.file : "No video chosen";
                color: root.file != "" ? Theme.text : Theme.text-faint;
                font-size: Theme.font-xs;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Button { text: "Video…"; kind: "ghost"; clicked => { root.set("stinger-file", 0); } }
        }
        if root.kind == 7: HorizontalLayout {
            spacing: 6px;
            Text { text: "Switch at"; color: Theme.text-muted; font-size: Theme.font-xs; vertical-alignment: center; horizontal-stretch: 1; }
            NumberField {
                width: 92px;
                label: "";
                value: root.point;
                minimum: 0;
                maximum: root.duration;
                step: 50;
                suffix: "ms";
                changed(v) => { root.set("point", v); }
            }
        }
    }
}

export component ScenesPanel inherits Panel {
    in property <[SceneRow]> scenes;
    in-out property <string> renaming;
    callback activate(string);
    callback add();
    callback duplicate(string);
    callback remove(string);
    callback rename(string, string);
    in property <bool> studio-mode;
    in property <int> transition-kind;
    in property <int> transition-direction;
    in property <float> transition-duration;
    in property <string> transition-file;
    in property <float> transition-point;
    callback transition-set(string, float);
    callback edit-shader();

    PanelHeader {
        title: "SCENES";
        icon: Icons.layers;
        IconButton { icon: Icons.plus; tooltip: "New scene (Ctrl+Shift+N)"; clicked => { root.add(); } }
    }
    Flickable {
        vertical-stretch: 1;
        content-height: list.preferred-height;
        list := VerticalLayout {
            padding: 6px;
            spacing: 2px;
            alignment: start;
            for scene in root.scenes: Rectangle {
                height: 36px;
                border-radius: Theme.radius-m;
                background: scene.active ? Theme.accent-soft : row-ta.has-hover ? Theme.hover : transparent;
                accessible-role: list-item;
                accessible-label: scene.name;
                accessible-item-selected: scene.active;
                accessible-action-default => { root.activate(scene.id); }

                // The row lives inside its TouchArea, which stays hovered over the buttons; beside it,
                // moving onto a button removed the buttons and they flickered.
                row-ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.activate(scene.id); }
                    double-clicked => { root.renaming = scene.id; }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 4px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: scene.active ? Theme.accent : Theme.text-faint.with-alpha(0.5);
                            }
                        }
                        if root.renaming == scene.id: VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            TextField {
                                text: scene.name;
                                label: "Scene name";
                                init => { self.focus(); }
                                accepted(t) => {
                                    root.rename(scene.id, t);
                                    root.renaming = "";
                                }
                                changed has-focus => {
                                    if (!self.has-focus && root.renaming == scene.id) {
                                        root.rename(scene.id, self.text);
                                        root.renaming = "";
                                    }
                                }
                            }
                        }
                        if root.renaming != scene.id: Text {
                            text: scene.name;
                            color: scene.active ? Theme.text : Theme.text-muted;
                            font-size: Theme.font-m;
                            font-weight: scene.active ? 600 : 400;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        if root.renaming != scene.id && (row-ta.has-hover || scene.active): HorizontalLayout {
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: Icons.pencil; tooltip: "Rename (F2)"; size: 24px; icon-size: 13px;
                                    clicked => { root.renaming = scene.id; }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: Icons.copy; tooltip: "Duplicate scene"; size: 24px; icon-size: 13px;
                                    clicked => { root.duplicate(scene.id); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: Icons.trash; tooltip: "Delete scene"; size: 24px; icon-size: 13px;
                                    enabled: root.scenes.length > 1;
                                    clicked => { root.remove(scene.id); }
                                }
                            }
                        }
                        if root.studio-mode && scene.live: VerticalLayout {
                            alignment: center;
                            Badge { text: "LIVE"; tone: Theme.live; }
                        }
                    }
                }
            }
        }
    }
    TransitionBar {
        kind: root.transition-kind;
        direction: root.transition-direction;
        duration: root.transition-duration;
        file: root.transition-file;
        point: root.transition-point;
        set(k, v) => { root.transition-set(k, v); }
        edit-shader => { root.edit-shader(); }
    }
}

/// Between Preview and Program in studio mode.
export component TransitionColumn inherits VerticalLayout {
    in property <string> label;
    in property <bool> busy;
    callback go(string);

    width: 116px;
    alignment: center;
    spacing: 8px;
    padding: 8px;
    Button {
        text: "Transition";
        kind: "primary";
        enabled: !root.busy;
        tooltip: "Send Preview to Program (" + root.label + ")";
        clicked => { root.go("go"); }
    }
    Button { text: "Cut"; kind: "ghost"; enabled: !root.busy; tooltip: "Switch instantly"; clicked => { root.go("cut"); } }
    Button { text: "Fade"; kind: "ghost"; enabled: !root.busy; tooltip: "Quick crossfade"; clicked => { root.go("fade"); } }
    Text {
        text: root.label;
        color: Theme.text-faint;
        font-size: Theme.font-xs;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}

/// Read-only view of the program output in studio mode.
export component ProgramView inherits Rectangle {
    in property <image> frame;
    in property <float> canvas-w: 1920;
    in property <float> canvas-h: 1080;
    property <float> fit: max(0.01, min((self.width - 48px) / 1px / canvas-w, (self.height - 48px) / 1px / canvas-h));

    background: Theme.bg;
    accessible-role: image;
    accessible-label: "Program output";
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.canvas-w * root.fit * 1px;
        height: root.canvas-h * root.fit * 1px;
        Image {
            width: parent.width;
            height: parent.height;
            source: root.frame;
            image-fit: fill;
        }
        // Drawn over the image so the on-air frame is always visible.
        Rectangle {
            border-width: 2px;
            border-color: Theme.live;
        }
    }
    Rectangle {
        x: 12px;
        y: 10px;
        width: label.preferred-width + 14px;
        height: 20px;
        border-radius: 10px;
        background: Theme.live;
        label := Text { text: "PROGRAM"; color: Theme.on-accent; font-size: Theme.font-xs; font-weight: 700; }
    }
}

export component KindIcon inherits Icon {
    in property <string> kind;
    source: kind == "group" ? Icons.folder
        : kind == "color" ? Icons.palette
        : kind == "test_pattern" ? Icons.layout-dashboard
        : kind == "display_capture" ? Icons.monitor
        : kind == "window_capture" ? Icons.app-window
        : kind == "game_capture" ? Icons.gamepad
        : kind == "camera" ? Icons.camera
        : kind == "audio_input" ? Icons.mic
        : kind == "audio_output" || kind == "app_audio" || kind == "audio_test_tone" ? Icons.volume
        : kind == "image" ? Icons.image
        : kind == "text" ? Icons.type
        : kind == "browser" ? Icons.globe
        : kind == "media" ? Icons.film
        : kind == "music" ? Icons.music
        : kind == "alerts" ? Icons.bell
        : kind == "chat_overlay" ? Icons.message-square
        : Icons.square;
}

export component SourcesPanel inherits Panel {
    in property <[LayerRow]> layers;
    callback select(string);
    callback toggle-visible(string);
    callback toggle-lock(string);
    callback add();
    callback remove();
    callback move-up();
    callback move-down();
    callback group();

    PanelHeader {
        title: "IN THIS SCENE";
        icon: Icons.layers;
        IconButton { icon: Icons.chevron-up; tooltip: "Move up (Ctrl+])"; clicked => { root.move-up(); } }
        IconButton { icon: Icons.chevron-down; tooltip: "Move down (Ctrl+[)"; clicked => { root.move-down(); } }
        IconButton { icon: Icons.folder; tooltip: "Group (Ctrl+G)"; clicked => { root.group(); } }
        IconButton { icon: Icons.trash; tooltip: "Delete (Del)"; clicked => { root.remove(); } }
        IconButton { icon: Icons.plus; tooltip: "Add source (Ctrl+N)"; clicked => { root.add(); } }
    }
    if root.layers.length == 0: EmptyState {
        vertical-stretch: 1;
        icon: Icons.sparkles;
        title: "This scene is empty";
        body: "Add a source to start building your scene.";
        HorizontalLayout {
            alignment: center;
            Button { text: "Add source"; kind: "primary"; has-icon: true; icon: Icons.plus; clicked => { root.add(); } }
        }
    }
    if root.layers.length > 0: Flickable {
        vertical-stretch: 1;
        content-height: rows.preferred-height;
        rows := VerticalLayout {
            padding: 6px;
            spacing: 2px;
            alignment: start;
            for layer in root.layers: Rectangle {
                height: 34px;
                border-radius: Theme.radius-m;
                background: layer.selected ? Theme.accent-soft : layer-ta.has-hover ? Theme.hover : transparent;
                accessible-role: list-item;
                accessible-label: layer.name;
                accessible-item-selected: layer.selected;
                accessible-action-default => { root.select(layer.id); }
                layer-ta := TouchArea {
                    clicked => { root.select(layer.id); }
                }
                HorizontalLayout {
                    padding-left: 8px + layer.depth * 18px;
                    padding-right: 4px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        KindIcon {
                            kind: layer.kind;
                            size: 15px;
                            tint: layer.selected ? Theme.accent : Theme.text-muted;
                        }
                    }
                    Text {
                        text: layer.name;
                        color: !layer.visible ? Theme.text-faint : layer.selected ? Theme.text : Theme.text-muted;
                        font-size: Theme.font-m;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if layer.problem != "": VerticalLayout {
                        alignment: center;
                        Badge { text: "Unavailable"; tone: Theme.warn; }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: layer.locked ? Icons.lock : Icons.lock-open;
                            tooltip: layer.locked ? "Unlock" : "Lock";
                            size: 24px;
                            icon-size: 13px;
                            tint: layer.locked ? Theme.warn : Theme.text-faint;
                            clicked => { root.toggle-lock(layer.id); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: layer.visible ? Icons.eye : Icons.eye-off;
                            tooltip: layer.visible ? "Hide" : "Show";
                            size: 24px;
                            icon-size: 13px;
                            tint: layer.visible ? Theme.text-muted : Theme.text-faint;
                            clicked => { root.toggle-visible(layer.id); }
                        }
                    }
                }
            }
        }
    }
}

// Horizontal stereo level meter (-60..0 dB): RMS body, peak tip, peak-hold tick.
component LevelMeter inherits Rectangle {
    in property <float> level-l;
    in property <float> level-r;
    in property <float> rms-l;
    in property <float> rms-r;
    in property <float> hold-l;
    in property <float> hold-r;
    in property <bool> dim;

    height: 11px;
    property <brush> fill: @linear-gradient(90deg, Theme.ok 0%, Theme.ok 66%, Theme.warn 85%, Theme.live 100%);

    for ch in [
        { y: 0px, level: root.level-l, rms: root.rms-l, hold: root.hold-l },
        { y: 6px, level: root.level-r, rms: root.rms-r, hold: root.hold-r },
    ]: Rectangle {
        y: ch.y;
        height: 5px;
        border-radius: 1px;
        background: Theme.surface-3;
        clip: true;
        // Peak (faint) then RMS (solid), both revealing the same gradient.
        Rectangle {
            x: 0;
            width: parent.width * clamp(ch.level, 0, 1);
            clip: true;
            Rectangle { x: 0; width: root.width; background: root.fill; opacity: root.dim ? 0.2 : 0.45; }
        }
        Rectangle {
            x: 0;
            width: parent.width * clamp(ch.rms, 0, 1);
            clip: true;
            Rectangle { x: 0; width: root.width; background: root.fill; opacity: root.dim ? 0.35 : 1; }
        }
        if ch.hold > 0.001: Rectangle {
            x: parent.width * clamp(ch.hold, 0, 1) - 1px;
            width: 2px;
            background: ch.hold > 0.95 ? Theme.live : Theme.text;
        }
    }
}

component MixerRow inherits Rectangle {
    in property <MixerStrip> strip;
    in property <bool> master;
    callback select();
    callback fader(float);
    callback commit();
    callback toggle-mute();

    height: 52px;
    border-radius: Theme.radius-m;
    background: strip.selected ? Theme.accent-soft : row-ta.has-hover ? Theme.hover : transparent;
    row-ta := TouchArea { clicked => { root.select(); } }

    VerticalLayout {
        padding-left: 10px;
        padding-right: 6px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.strip.name;
                color: root.strip.muted ? Theme.text-faint : Theme.text;
                font-size: Theme.font-s;
                font-weight: root.master ? 700 : 500;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            if root.strip.global: Text { text: "ALL SCENES"; color: Theme.text-faint; font-size: 9px; font-weight: 700; vertical-alignment: center; }
            if root.strip.monitoring: Icon { source: Icons.volume; size: 12px; tint: Theme.accent; y: 2px; }
            if root.strip.problem != "": Text { text: "●"; color: Theme.warn; font-size: Theme.font-s; vertical-alignment: center; }
            if !root.master: Text {
                text: root.strip.muted ? "Muted" : root.strip.volume-db <= -60 ? "-∞ dB" : root.strip.volume-db.to-fixed(1) + " dB";
                color: root.strip.muted ? Theme.live : Theme.text-muted;
                font-size: Theme.font-xs;
                width: 52px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 3px;
                LevelMeter {
                    level-l: root.strip.level-l;
                    level-r: root.strip.level-r;
                    rms-l: root.strip.rms-l;
                    rms-r: root.strip.rms-r;
                    hold-l: root.strip.hold-l;
                    hold-r: root.strip.hold-r;
                    dim: root.strip.muted;
                }
                if !root.master: Slider {
                    height: 12px;
                    label: root.strip.name + " volume";
                    value: root.strip.fader;
                    changed(v) => { root.fader(v); }
                    committed => { root.commit(); }
                }
            }
            if !root.master: VerticalLayout {
                alignment: center;
                IconButton {
                    icon: root.strip.muted ? Icons.volume-x : Icons.volume;
                    tooltip: root.strip.muted ? "Unmute" : "Mute";
                    toggled: root.strip.muted;
                    tint: root.strip.muted ? Theme.live : Theme.text-muted;
                    size: 26px;
                    icon-size: 14px;
                    clicked => { root.toggle-mute(); }
                }
            }
        }
    }
}

export component MixerPanel inherits Panel {
    in property <[MixerStrip]> strips;
    in property <MixerStrip> master;
    callback select(string);
    callback fader(string, float);
    callback commit();
    callback toggle-mute(string);
    callback add();

    PanelHeader {
        title: "AUDIO MIXER";
        icon: Icons.volume;
        IconButton { icon: Icons.plus; tooltip: "Add audio source"; clicked => { root.add(); } }
    }
    VerticalLayout {
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 6px;
        MixerRow { strip: root.master; master: true; }
        Rectangle { height: 1px; background: Theme.border; }
    }
    if root.strips.length == 0: EmptyState {
        vertical-stretch: 1;
        icon: Icons.mic;
        title: "No audio sources";
        body: "Add a microphone, desktop audio or an application.";
    }
    if root.strips.length > 0: Flickable {
        vertical-stretch: 1;
        content-height: strip-list.preferred-height;
        strip-list := VerticalLayout {
            padding: 6px;
            spacing: 2px;
            alignment: start;
            for strip in root.strips: MixerRow {
                strip: strip;
                select => { root.select(strip.id); }
                fader(v) => { root.fader(strip.id, v); }
                commit => { root.commit(); }
                toggle-mute => { root.toggle-mute(strip.id); }
            }
        }
    }
}
export component StatusBar inherits Rectangle {
    in property <float> fps;
    in property <float> target-fps;
    in property <float> render-ms;
    in property <int> lagged;
    in property <string> gpu;
    in property <string> message;
    /// Live stream summary; `stream-health` 0 = not streaming, 1 good, 2 congested, 3 failing.
    in property <string> stream-info;
    in property <int> stream-health;
    /// Overall health: 0 good, 1 warning, 2 problem; `health-text` is the main alert.
    in property <int> health;
    in property <string> health-text;
    /// "Clutch 0.4.0 beta 1", at the far right.
    in property <string> version;
    callback open-stats();
    callback open-about();

    height: 28px;
    background: Theme.bg;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;
        HorizontalLayout {
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: root.health == 2 ? Theme.live : root.health == 1 ? Theme.warn : Theme.ok;
                }
            }
            Text {
                text: root.fps.to-fixed(1) + " / " + root.target-fps.to-fixed(root.target-fps == round(root.target-fps) ? 0 : 2) + " fps";
                color: Theme.text-muted;
                font-size: Theme.font-xs;
                vertical-alignment: center;
                TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.open-stats(); }
                }
            }
        }
        Text { text: "render " + root.render-ms.to-fixed(2) + " ms"; color: Theme.text-muted; font-size: Theme.font-xs; vertical-alignment: center; }
        Text {
            text: root.health-text;
            color: root.health == 2 ? Theme.live : root.health == 1 ? Theme.warn : Theme.text-muted;
            font-size: Theme.font-xs;
            font-weight: root.health > 0 ? 700 : 400;
            vertical-alignment: center;
            overflow: elide;
            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.open-stats(); }
            }
        }
        Text { text: root.gpu; color: Theme.text-faint; font-size: Theme.font-xs; vertical-alignment: center; overflow: elide; }
        Rectangle { horizontal-stretch: 1; }
        if root.stream-health > 0: HorizontalLayout {
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: root.stream-health == 1 ? Theme.ok : root.stream-health == 2 ? Theme.warn : Theme.live;
                }
            }
            Text {
                text: root.stream-info;
                color: root.stream-health == 1 ? Theme.text-muted : root.stream-health == 2 ? Theme.warn : Theme.live;
                font-size: Theme.font-xs;
                vertical-alignment: center;
            }
        }
        Text { text: root.message; color: Theme.text-faint; font-size: Theme.font-xs; vertical-alignment: center; }
        if root.version != "": Text {
            text: root.version;
            color: Theme.text-faint;
            font-size: Theme.font-xs;
            vertical-alignment: center;
            accessible-role: button;
            accessible-label: root.version + ", about Clutch";
            TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.open-about(); }
            }
        }
    }
}

/// One tab per canvas above the preview, plus a picker to add canvases.
export component CanvasTabs inherits HorizontalLayout {
    in property <[CanvasTab]> tabs;
    in property <[string]> presets;
    /// Canvas presets to duplicate as.
    in property <[string]> sizes;
    in-out property <string> renaming;
    callback select(string);
    callback add(int);
    /// (canvas id, "outputs" | "duplicate" | "rename" | "remove", preset index or -1)
    callback menu(string, string, int);
    callback rename(string, string);

    spacing: 4px;
    height: 34px;
    for ct in root.tabs: Rectangle {
        property <bool> hovered: tab-ta.has-hover;
        width: tab-row.preferred-width;
        border-radius: Theme.radius-m;
        background: ct.active ? Theme.surface-2 : hovered ? Theme.hover : transparent;
        border-width: ct.active ? 1px : 0px;
        border-color: Theme.border;
        accessible-role: tab;
        accessible-label: ct.name;
        accessible-item-selected: ct.active;
        tab-ta := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.select(ct.id); }
            double-clicked => { root.renaming = ct.id; }
        }
        tab-row := HorizontalLayout {
            padding-left: 12px;
            padding-right: 6px;
            spacing: 8px;
            if root.renaming == ct.id: VerticalLayout {
                alignment: center;
                TextField {
                    width: 140px;
                    text: ct.name;
                    label: "Canvas name";
                    init => { self.focus(); }
                    accepted(t) => {
                        root.rename(ct.id, t);
                        root.renaming = "";
                    }
                    changed has-focus => {
                        if (!self.has-focus && root.renaming == ct.id) {
                            root.rename(ct.id, self.text);
                            root.renaming = "";
                        }
                    }
                }
            }
            if root.renaming != ct.id: Text {
                text: ct.name;
                color: ct.active ? Theme.text : Theme.text-muted;
                font-size: Theme.font-s;
                font-weight: ct.active ? 600 : 400;
                vertical-alignment: center;
            }
            if root.renaming != ct.id: Text {
                text: ct.info;
                color: Theme.text-faint;
                font-size: Theme.font-xs;
                vertical-alignment: center;
            }
            // What goes out from this canvas, so the tab being edited isn't taken for it.
            if ct.outputs != "": VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 18px;
                    width: outputs-text.preferred-width + 10px;
                    border-radius: 4px;
                    background: ct.live ? Theme.live : Theme.surface-3;
                    outputs-text := Text {
                        text: ct.outputs;
                        color: ct.live ? Theme.on-accent : Theme.text-muted;
                        font-size: Theme.font-xs;
                        font-weight: ct.live ? 700 : 400;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.chevron-down;
                    tooltip: "Canvas menu: outputs, duplicate, rename, remove";
                    size: 20px;
                    icon-size: 12px;
                    opacity: hovered || ct.active ? 1 : 0.5;
                    clicked => { menu.show(); }
                }
            }
        }
        menu := PopupWindow {
            x: 0;
            y: 38px;
            width: 260px;
            Rectangle {
                background: Theme.surface-3;
                border-radius: Theme.radius-m;
                border-width: 1px;
                border-color: Theme.border-strong;
                drop-shadow-blur: 16px;
                drop-shadow-color: #00000060;
                VerticalLayout {
                    padding: 4px;
                    MenuRow {
                        label: ct.feeds-all ? "Streaming and recording this canvas" : "Stream and record this canvas";
                        icon: ct.feeds-all ? Icons.check : Icons.radio;
                        enabled: !ct.feeds-all;
                        clicked => { root.menu(ct.id, "outputs", -1); }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    MenuRow {
                        label: "Duplicate";
                        icon: Icons.copy;
                        clicked => { root.menu(ct.id, "duplicate", -1); }
                    }
                    for size[i] in root.sizes: MenuRow {
                        label: "Duplicate as " + size;
                        indent: true;
                        clicked => { root.menu(ct.id, "duplicate", i); }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    MenuRow {
                        label: "Rename…";
                        icon: Icons.pencil;
                        clicked => { root.menu(ct.id, "rename", -1); }
                    }
                    MenuRow {
                        label: "Remove";
                        icon: Icons.trash;
                        danger: true;
                        enabled: root.tabs.length > 1;
                        clicked => { root.menu(ct.id, "remove", -1); }
                    }
                }
            }
        }
    }
    VerticalLayout {
        alignment: center;
        Select {
            width: 150px;
            label: "Add canvas";
            options: root.presets;
            current-index: 0;
            selected(i) => { if (i > 0) { root.add(i - 1); } }
        }
    }
    Rectangle { horizontal-stretch: 1; }
}

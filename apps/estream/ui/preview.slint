// Live canvas preview with on-canvas editing overlay.
// Zoom and pan live here; selection/drag logic lives in Rust (interact.rs).

import { Theme } from "theme.slint";
import { CanvasBox, Guide, MaskEditView } from "types.slint";
import { Button } from "widgets.slint";
import { ColorPicking } from "color.slint";

export component Preview inherits Rectangle {
    in property <image> frame;
    in property <float> canvas-w: 1920;
    in property <float> canvas-h: 1080;
    in property <CanvasBox> selection;
    in property <CanvasBox> hover;
    in property <[Guide]> guides;
    /// The mask editor, while a mask is being edited.
    in property <MaskEditView> mask;
    // Cursor requested by Rust for the current hover target.
    in property <string> cursor: "default";
    in property <bool> space-down;
    in property <bool> scroll-pan: false;
    in-out property <float> zoom: 1;
    in-out property <length> pan-x;
    in-out property <length> pan-y;
    /// Room the floating panels take on each side; the canvas is fitted beside them while
    /// it still gets at least half the width (else over the whole preview, as before).
    in property <length> inset-left;
    in property <length> inset-right;

    // kind: "down" | "move" | "up"; x/y in canvas pixels; px = canvas px per screen px.
    callback pointer(kind: string, x: float, y: float, px: float, shift: bool, alt: bool, ctrl: bool);
    /// The wheel at canvas x/y; true if an interactive page took it.
    callback wheel(x: float, y: float, dx: float, dy: float) -> bool;
    /// The mask editor's toolbar (`mask.*` actions).
    callback action(string);

    property <float> fit-all: max(0.01, min((self.width - 48px) / 1px / canvas-w, (self.height - 48px) / 1px / canvas-h));
    property <length> free-w: self.width - inset-left - inset-right;
    property <float> fit-free: max(0.01, min((free-w - 48px) / 1px / canvas-w, (self.height - 48px) / 1px / canvas-h));
    property <bool> beside: (inset-left > 0 || inset-right > 0) && canvas-w * fit-free * 1px >= self.width * 0.5;
    out property <float> fit: beside ? fit-free : fit-all;
    // The middle of the area the canvas is fitted into.
    property <length> mid-x: beside ? inset-left + free-w / 2 : self.width / 2;
    out property <float> scale: fit * zoom;
    property <length> img-w: canvas-w * scale * 1px;
    property <length> img-h: canvas-h * scale * 1px;
    property <length> img-x: mid-x - img-w / 2 + pan-x;
    property <length> img-y: (self.height - img-h) / 2 + pan-y;
    property <bool> panning;
    property <length> pan-start-x;
    property <length> pan-start-y;

    public function zoom-fit() {
        zoom = 1;
        pan-x = 0;
        pan-y = 0;
    }
    public function zoom-actual() {
        zoom = 1 / fit;
        pan-x = 0;
        pan-y = 0;
    }

    background: Theme.canvas-bg;
    clip: true;
    accessible-role: image;
    accessible-label: "Canvas preview";

    // Canvas frame and shadow.
    Rectangle {
        x: img-x - 1px;
        y: img-y - 1px;
        width: img-w + 2px;
        height: img-h + 2px;
        background: #000000;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 30px;
        drop-shadow-color: #00000070;
    }
    Image {
        x: img-x;
        y: img-y;
        width: img-w;
        height: img-h;
        source: root.frame;
        image-fit: fill;
    }

    // Snap guides.
    for g in root.guides: Rectangle {
        x: g.vertical ? img-x + g.pos * scale * 1px : img-x;
        y: g.vertical ? img-y : img-y + g.pos * scale * 1px;
        width: g.vertical ? 1px : img-w;
        height: g.vertical ? img-h : 1px;
        background: #ff4fd8;
    }

    // Hover outline.
    if hover.visible && !(selection.visible && hover.cx == selection.cx && hover.cy == selection.cy): Rectangle {
        x: img-x + (hover.cx - hover.w / 2) * scale * 1px;
        y: img-y + (hover.cy - hover.h / 2) * scale * 1px;
        width: hover.w * scale * 1px;
        height: hover.h * scale * 1px;
        transform-rotation: hover.rotation * 1deg;
        border-width: 1px;
        border-color: Theme.accent.with-alpha(0.55);
    }

    // Selection box with handles.
    if selection.visible: Rectangle {
        x: img-x + (selection.cx - selection.w / 2) * scale * 1px;
        y: img-y + (selection.cy - selection.h / 2) * scale * 1px;
        width: selection.w * scale * 1px;
        height: selection.h * scale * 1px;
        transform-rotation: selection.rotation * 1deg;
        border-width: 1.5px;
        border-color: selection.locked ? Theme.warn : Theme.accent;

        if selection.handles && !selection.locked: Rectangle {
            // Rotation handle stem and knob.
            Rectangle {
                x: (parent.width - 1px) / 2;
                y: -28px;
                width: 1px;
                height: 28px;
                background: Theme.accent;
            }
            Rectangle {
                x: parent.width / 2 - 6px;
                y: -28px - 6px;
                width: 12px;
                height: 12px;
                border-radius: 6px;
                background: #ffffff;
                border-width: 1.5px;
                border-color: Theme.accent;
            }
            for h in [
                { fx: 0, fy: 0 }, { fx: 0.5, fy: 0 }, { fx: 1, fy: 0 }, { fx: 1, fy: 0.5 },
                { fx: 1, fy: 1 }, { fx: 0.5, fy: 1 }, { fx: 0, fy: 1 }, { fx: 0, fy: 0.5 },
            ]: Rectangle {
                x: parent.width * h.fx - 4.5px;
                y: parent.height * h.fy - 4.5px;
                width: 9px;
                height: 9px;
                border-radius: 2px;
                background: #ffffff;
                border-width: 1.5px;
                border-color: Theme.accent;
            }
        }
    }

    // Mask editor: dims what the mask hides, outlines the shapes and shows the selected shape's
    // handles, in the box of the item's picture.
    if mask.visible: Rectangle {
        x: img-x + (mask.cx - mask.w / 2) * scale * 1px;
        y: img-y + (mask.cy - mask.h / 2) * scale * 1px;
        width: mask.w * scale * 1px;
        height: mask.h * scale * 1px;
        transform-rotation: mask.rotation * 1deg;
        border-width: 1px;
        border-color: #ffffff80;
        Image {
            width: parent.width;
            height: parent.height;
            source: mask.dim;
            image-fit: fill;
        }
        for o in mask.outlines: Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 1000;
            viewbox-height: 1000;
            commands: o.commands;
            fill: transparent;
            stroke: o.selected ? Theme.accent : o.cut ? #ff7a7a : #ffffff;
            stroke-width: o.selected ? 2px : 1.5px;
        }
        if mask.draft != "": Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 1000;
            viewbox-height: 1000;
            commands: mask.draft;
            fill: transparent;
            stroke: Theme.accent;
            stroke-width: 1.5px;
        }
        for h in mask.handles: Rectangle {
            x: parent.width * h.u - 4.5px;
            y: parent.height * h.v - 4.5px;
            width: 9px;
            height: 9px;
            border-radius: 2px;
            background: h.active ? Theme.accent : #ffffff;
            border-width: 1.5px;
            border-color: Theme.accent;
        }
    }

    ta := TouchArea {
        mouse-cursor: root.panning || root.space-down ? (root.panning ? MouseCursor.grabbing : MouseCursor.grab)
            : root.cursor == "move" ? MouseCursor.move
            : root.cursor == "nwse" ? MouseCursor.nwse-resize
            : root.cursor == "nesw" ? MouseCursor.nesw-resize
            : root.cursor == "ew" ? MouseCursor.ew-resize
            : root.cursor == "ns" ? MouseCursor.ns-resize
            : root.cursor == "rotate" ? MouseCursor.crosshair
            : root.cursor == "crosshair" ? MouseCursor.crosshair
            : root.cursor == "pointer" ? MouseCursor.pointer
            : MouseCursor.default;

        function canvas-x() -> float { return (self.mouse-x - root.img-x) / 1px / root.scale; }
        function canvas-y() -> float { return (self.mouse-y - root.img-y) / 1px / root.scale; }

        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                if (e.button == PointerEventButton.middle || (e.button == PointerEventButton.left && root.space-down)) {
                    root.panning = true;
                    root.pan-start-x = root.pan-x - self.mouse-x;
                    root.pan-start-y = root.pan-y - self.mouse-y;
                } else if (e.button == PointerEventButton.left) {
                    root.pointer("down", canvas-x(), canvas-y(), 1 / root.scale,
                        e.modifiers.shift, e.modifiers.alt, e.modifiers.control);
                }
            } else if (e.kind == PointerEventKind.up) {
                if (root.panning) {
                    root.panning = false;
                } else {
                    root.pointer("up", canvas-x(), canvas-y(), 1 / root.scale,
                        e.modifiers.shift, e.modifiers.alt, e.modifiers.control);
                }
            } else if (e.kind == PointerEventKind.move) {
                if (root.panning) {
                    root.pan-x = root.pan-start-x + self.mouse-x;
                    root.pan-y = root.pan-start-y + self.mouse-y;
                } else {
                    root.pointer("move", canvas-x(), canvas-y(), 1 / root.scale,
                        e.modifiers.shift, e.modifiers.alt, e.modifiers.control);
                }
            }
        }

        double-clicked => {
            root.pointer("double", canvas-x(), canvas-y(), 1 / root.scale, false, false, false);
        }

        scroll-event(e) => {
            // An interactive browser source under the pointer scrolls instead of the preview.
            if (!e.modifiers.control && !e.modifiers.shift
                && root.wheel(canvas-x(), canvas-y(), e.delta-x / 1px, e.delta-y / 1px)) {
                return EventResult.accept;
            }
            if (e.modifiers.control) {
                // Zoom around the cursor.
                let cx = (self.mouse-x - root.img-x) / root.scale;
                let cy = (self.mouse-y - root.img-y) / root.scale;
                let factor = e.delta-y > 0 ? 1.15 : 1 / 1.15;
                let new-zoom = clamp(root.zoom * factor, 0.1, 16);
                let new-scale = root.fit * new-zoom;
                root.zoom = new-zoom;
                root.pan-x = self.mouse-x - cx * new-scale - (root.mid-x - root.canvas-w * new-scale * 1px / 2);
                root.pan-y = self.mouse-y - cy * new-scale - (root.height - root.canvas-h * new-scale * 1px) / 2;
            } else if (root.scroll-pan) {
                if (e.modifiers.shift) {
                    root.pan-x += e.delta-y;
                } else {
                    root.pan-x += e.delta-x;
                    root.pan-y += e.delta-y;
                }
            }
            return EventResult.accept;
        }
    }

    // Picking a color: a crosshair, a magnified look at the pixels under it, and a click that
    // reports the spot as a fraction of the canvas.
    if ColorPicking.from-preview: pick := TouchArea {
        mouse-cursor: MouseCursor.crosshair;
        property <float> fx: (self.mouse-x - root.img-x) / root.img-w;
        property <float> fy: (self.mouse-y - root.img-y) / root.img-h;
        property <bool> inside: self.has-hover && self.fx >= 0 && self.fx < 1 && self.fy >= 0 && self.fy < 1;
        clicked => {
            if (self.inside) { ColorPicking.preview-picked(self.fx, self.fy); }
        }
        // 11 × 11 frame pixels, 9 times larger, centered on the pointer.
        if pick.inside: Rectangle {
            property <int> px: floor(pick.fx * root.frame.width);
            property <int> py: floor(pick.fy * root.frame.height);
            x: pick.mouse-x + 18px;
            y: pick.mouse-y + 18px;
            width: 99px;
            height: 99px;
            border-radius: 6px;
            border-width: 2px;
            border-color: #ffffff;
            background: #000000;
            clip: true;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000090;
            Image {
                x: 0;
                y: 0;
                width: 99px;
                height: 99px;
                source: root.frame;
                source-clip-x: parent.px - 5;
                source-clip-y: parent.py - 5;
                source-clip-width: 11;
                source-clip-height: 11;
                image-fit: fill;
                image-rendering: pixelated;
            }
            // The pixel that a click takes.
            Rectangle {
                x: 45px;
                y: 45px;
                width: 9px;
                height: 9px;
                border-width: 1px;
                border-color: #ffffff;
            }
        }
    }

    // Mask editor toolbar: the drawing tools, keep or cut, and Done (Esc).
    if mask.visible: VerticalLayout {
        x: (root.width - self.preferred-width) / 2;
        y: 12px;
        width: self.preferred-width;
        height: self.preferred-height;
        spacing: 6px;
        Rectangle {
            border-radius: Theme.radius-m;
            background: Theme.surface.with-alpha(0.96);
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000050;
            accessible-role: groupbox;
            accessible-label: "Mask tools";
            HorizontalLayout {
                padding: 5px;
                spacing: 3px;
                for t[i] in [
                    { name: "select", label: "Select", key: "V" },
                    { name: "rect", label: "Rectangle", key: "R" },
                    { name: "ellipse", label: "Ellipse", key: "E" },
                    { name: "polygon", label: "Polygon", key: "P" },
                    { name: "freehand", label: "Freehand", key: "F" },
                ]: Button {
                    text: t.label;
                    kind: root.mask.tool == i ? "primary" : "ghost";
                    tooltip: t.label + " (" + t.key + ")";
                    clicked => { root.action("mask.tool." + t.name); }
                }
                Rectangle { width: 1px; background: Theme.border; }
                Button {
                    text: "Keep";
                    kind: !root.mask.cut ? "primary" : "ghost";
                    tooltip: "New shapes keep that part of the picture (X switches)";
                    clicked => { root.action("mask.keep"); }
                }
                Button {
                    text: "Cut";
                    kind: root.mask.cut ? "primary" : "ghost";
                    tooltip: "New shapes cut that part of the picture away (X switches)";
                    clicked => { root.action("mask.cut"); }
                }
                Rectangle { width: 1px; background: Theme.border; }
                Button {
                    text: "Done";
                    tooltip: "Stop editing the mask (Esc)";
                    clicked => { root.action("mask.done"); }
                }
            }
        }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                border-radius: 10px;
                background: #000000b0;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 3px;
                    padding-bottom: 3px;
                    Text {
                        text: root.mask.hint;
                        color: #ffffff;
                        font-size: Theme.font-xs;
                        accessible-role: text;
                    }
                }
            }
        }
    }

    // Zoom indicator.
    Rectangle {
        x: parent.width - self.width - 12px;
        y: parent.height - self.height - 12px;
        width: zoom-label.preferred-width + 16px;
        height: 22px;
        border-radius: 11px;
        background: Theme.surface.with-alpha(0.85);
        border-width: 1px;
        border-color: Theme.border;
        zoom-label := Text {
            text: round(root.scale * 100) + "%";
            color: Theme.text-muted;
            font-size: Theme.font-xs;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { PaletteEntry, Preset, SourceType, SettingsForm, DestinationRow, LiveRow } from "types.slint";
import { Button, IconButton, Icon, Badge, TextField, TextArea, NumberField, Select, Toggle, SectionTitle } from "widgets.slint";
import { KindIcon } from "panels.slint";

// Full-window scrim with a centered card. Clicking the scrim calls `dismiss`.
component Modal inherits Rectangle {
    in property <length> card-width: 520px;
    in property <length> card-top: -1px;
    in property <bool> dismissable: true;
    out property <length> inner-width: card.width;
    callback dismiss();

    background: Theme.scrim;
    TouchArea {
        clicked => { if (root.dismissable) { root.dismiss(); } }
    }
    card := Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.card-top >= 0 ? root.card-top : (parent.height - self.height) / 2;
        width: min(root.card-width, parent.width - 40px);
        height: content.preferred-height;
        background: Theme.surface;
        border-radius: Theme.radius-l;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 40px;
        drop-shadow-offset-y: 12px;
        drop-shadow-color: #00000080;
        clip: true;
        accessible-role: groupbox;
        TouchArea { }
        content := VerticalLayout {
            @children
        }
    }
}

export component CommandPalette inherits Modal {
    in property <[PaletteEntry]> entries;
    in-out property <int> current;
    in-out property <string> query;
    callback query-changed(string);
    callback run(string);

    card-width: 620px;
    card-top: 80px;

    keys := FocusScope {
        capture-key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.dismiss();
                return EventResult.accept;
            }
            if (e.text == Key.DownArrow) {
                root.current = min(root.current + 1, root.entries.length - 1);
                return EventResult.accept;
            }
            if (e.text == Key.UpArrow) {
                root.current = max(0, root.current - 1);
                return EventResult.accept;
            }
            if (e.text == Key.Return) {
                if (root.entries.length > 0) {
                    root.run(root.entries[root.current].id);
                }
                return EventResult.accept;
            }
            return EventResult.reject;
        }
        HorizontalLayout {
            height: 52px;
            padding-left: 16px;
            padding-right: 16px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Icon { source: Icons.search; size: 18px; tint: Theme.text-muted; }
            }
            input := TextInput {
                text <=> root.query;
                single-line: true;
                vertical-alignment: center;
                color: Theme.text;
                font-size: Theme.font-l;
                accessible-label: "Search commands";
                init => { self.focus(); }
                edited => {
                    root.current = 0;
                    root.query-changed(self.text);
                }
            }
            if root.query == "": Text {
                text: "Type a command, scene or source…";
                color: Theme.text-faint;
                font-size: Theme.font-l;
                vertical-alignment: center;
            }
        }
    }
    Rectangle { height: 1px; background: Theme.border; }
    if root.entries.length == 0: Text {
        height: 64px;
        text: "No matches";
        color: Theme.text-faint;
        font-size: Theme.font-m;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    VerticalLayout {
        padding: 6px;
        spacing: 1px;
        for entry[i] in root.entries: Rectangle {
            height: 36px;
            border-radius: Theme.radius-m;
            background: i == root.current ? Theme.accent-soft : entry-ta.has-hover ? Theme.hover : transparent;
            accessible-role: list-item;
            accessible-label: entry.title;
            accessible-item-selected: i == root.current;
            entry-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.run(entry.id); }
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                Text {
                    text: entry.title;
                    color: i == root.current ? Theme.text : Theme.text-muted;
                    font-size: Theme.font-m;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Text {
                    text: entry.category;
                    color: Theme.text-faint;
                    font-size: Theme.font-xs;
                    vertical-alignment: center;
                }
                if entry.hint != "": VerticalLayout {
                    alignment: center;
                    Badge { text: entry.hint; }
                }
            }
        }
    }
}

export component AddSourceDialog inherits Modal {
    in property <[SourceType]> types;
    callback pick(string);

    card-width: 560px;

    FocusScope {
        height: 0px;
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.dismiss();
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }
    HorizontalLayout {
        padding: 18px;
        padding-bottom: 6px;
        Text {
            text: "Add a source";
            color: Theme.text;
            font-size: Theme.font-xl;
            font-weight: 700;
            horizontal-stretch: 1;
        }
        Button { text: "Close"; kind: "ghost"; clicked => { root.dismiss(); } }
    }
    Text {
        x: 18px;
        text: "Sources are reusable: add the same source to several scenes.";
        color: Theme.text-muted;
        font-size: Theme.font-s;
    }
    VerticalLayout {
        padding: 12px;
        spacing: 4px;
        for t in root.types: Rectangle {
            height: 54px;
            border-radius: Theme.radius-m;
            background: t.available && type-ta.has-hover ? Theme.hover : transparent;
            opacity: t.available ? 1 : 0.55;
            accessible-role: button;
            accessible-label: t.title;
            accessible-enabled: t.available;
            accessible-action-default => { if (t.available) { root.pick(t.kind); } }
            type-ta := TouchArea {
                enabled: t.available;
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.pick(t.kind); }
            }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: Theme.radius-m;
                        background: t.available ? Theme.accent-soft : Theme.surface-3;
                        KindIcon { kind: t.kind; size: 17px; tint: t.available ? Theme.accent : Theme.text-faint; }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text { text: t.title; color: Theme.text; font-size: Theme.font-m; font-weight: 600; }
                    Text { text: t.description; color: Theme.text-muted; font-size: Theme.font-s; overflow: elide; }
                }
                if !t.available: VerticalLayout {
                    alignment: center;
                    Badge { text: "Soon"; }
                }
            }
        }
    }
}

export component SetupWizard inherits Modal {
    in property <[Preset]> presets;
    in property <string> gpu;
    in property <string> encoders;
    in-out property <int> current;
    callback create(int);

    card-width: 600px;
    dismissable: false;

    VerticalLayout {
        padding: 28px;
        spacing: 18px;
        HorizontalLayout {
            spacing: 14px;
            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 12px;
                background: @linear-gradient(135deg, Theme.accent 0%, #b06cff 100%);
                Icon { source: Icons.radio; size: 22px; tint: #ffffff; }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text { text: "Welcome to eStream"; color: Theme.text; font-size: 22px; font-weight: 700; }
                Text { text: "Let's set up your canvas. You can change it any time."; color: Theme.text-muted; font-size: Theme.font-m; }
            }
        }
        Rectangle {
            height: hw.preferred-height + 20px;
            border-radius: Theme.radius-m;
            background: Theme.surface-2;
            hw := VerticalLayout {
                padding: 10px;
                padding-left: 14px;
                spacing: 4px;
                HorizontalLayout {
                    spacing: 8px;
                    Icon { source: Icons.gauge; size: 14px; tint: Theme.ok; }
                    Text { text: "GPU: " + root.gpu; color: Theme.text; font-size: Theme.font-s; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Icon { source: Icons.film; size: 14px; tint: Theme.text-muted; }
                    Text { text: "Hardware encoding: " + root.encoders; color: Theme.text-muted; font-size: Theme.font-s; wrap: word-wrap; }
                }
            }
        }
        VerticalLayout {
            spacing: 4px;
            for preset[i] in root.presets: Rectangle {
                height: 46px;
                border-radius: Theme.radius-m;
                border-width: 1px;
                border-color: i == root.current ? Theme.accent : Theme.border;
                background: i == root.current ? Theme.accent-soft : preset-ta.has-hover ? Theme.hover : transparent;
                accessible-role: radio-button;
                accessible-label: preset.label;
                accessible-checked: i == root.current;
                preset-ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.current = i; }
                    double-clicked => { root.create(i); }
                }
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 16px;
                            height: 16px;
                            border-radius: 8px;
                            border-width: 2px;
                            border-color: i == root.current ? Theme.accent : Theme.border-strong;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: i == root.current ? Theme.accent : transparent;
                            }
                        }
                    }
                    Text { text: preset.label; color: Theme.text; font-size: Theme.font-m; font-weight: 600; vertical-alignment: center; }
                    Text { text: preset.detail; color: Theme.text-muted; font-size: Theme.font-s; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: right; }
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            Button {
                text: "Create scene collection";
                kind: "primary";
                clicked => { root.create(root.current); }
            }
        }
    }
}

export component RecoveryPrompt inherits Modal {
    callback restore();
    callback discard();

    card-width: 460px;
    dismissable: false;
    VerticalLayout {
        padding: 24px;
        spacing: 14px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: start;
                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 18px;
                    background: Theme.warn.with-alpha(0.16);
                    Icon { source: Icons.triangle-alert; size: 18px; tint: Theme.warn; }
                }
            }
            VerticalLayout {
                spacing: 6px;
                Text { text: "Restore unsaved changes?"; color: Theme.text; font-size: Theme.font-l; font-weight: 700; }
                Text {
                    text: "eStream didn't shut down cleanly last time. Your most recent autosave can be restored.";
                    color: Theme.text-muted;
                    font-size: Theme.font-m;
                    wrap: word-wrap;
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button { text: "Discard"; kind: "ghost"; clicked => { root.discard(); } }
            Button { text: "Restore"; kind: "primary"; clicked => { root.restore(); } }
        }
    }
}

export component Toast inherits Rectangle {
    in property <string> text;
    in property <bool> error;
    height: 38px;
    width: label.preferred-width + 44px;
    border-radius: 19px;
    background: Theme.dark ? #2b303b : #1d2129;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000060;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 16px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.error ? Theme.live : Theme.ok;
            }
        }
        label := Text {
            text: root.text;
            color: #f1f3f7;
            font-size: Theme.font-m;
            vertical-alignment: center;
        }
    }
}

component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: 12px;
    VerticalLayout {
        width: 170px;
        alignment: center;
        Text { text: root.label; color: Theme.text; font-size: Theme.font-m; }
        if root.hint != "": Text { text: root.hint; color: Theme.text-faint; font-size: Theme.font-xs; wrap: word-wrap; }
    }
    @children
}

// Editor for the selected streaming destination.
component DestinationEditor inherits VerticalLayout {
    in property <SettingsForm> form;
    callback set(string, float);
    callback set-text(string, string);

    spacing: 12px;

    // Typing breaks the text fields' bindings; re-sync them when another destination is
    // selected or a preset changes the server.
    property <int> selected: root.form.dest-selected;
    property <string> server: root.form.stream-server;
    changed selected => {
        name-field.text = root.form.dest-name;
        server-field.text = root.form.stream-server;
        key-field.text = "";
    }
    changed server => {
        if (server-field.text != self.server) {
            server-field.text = self.server;
        }
    }

    SettingRow {
        label: "Name";
        name-field := TextField {
            text: root.form.dest-name;
            label: "Destination name";
            edited(t) => { root.set-text("dest-name", t); }
        }
    }
    SettingRow {
        label: "Service";
        Select {
            label: "Streaming service";
            options: root.form.stream-services;
            current-index: root.form.stream-service;
            selected(i) => { root.set("stream-service", i); }
        }
    }
    SettingRow {
        label: "Server";
        hint: root.form.stream-protocol != "" ? "Detected: " + root.form.stream-protocol : "rtmp(s)://, srt://, rist:// or https:// (WHIP)";
        server-field := TextField {
            text: root.form.stream-server;
            label: "Stream server";
            placeholder: "rtmps://…";
            edited(t) => { root.set-text("stream-server", t); }
        }
    }
    SettingRow {
        label: "Stream key";
        hint: "Stored encrypted for your Windows account";
        key-field := TextField {
            input-type: InputType.password;
            label: "Stream key";
            placeholder: root.form.stream-key-set ? "Saved — type to replace" : "Paste your stream key";
            edited(t) => { root.set-text("stream-key", t); }
        }
    }
    if root.form.canvas-names.length > 1: SettingRow {
        label: "Canvas";
        hint: "Which canvas this destination streams";
        Select {
            label: "Destination canvas";
            options: root.form.canvas-names;
            current-index: root.form.dest-canvas;
            selected(i) => { root.set("dest-canvas", i); }
        }
    }
    SettingRow {
        label: "Video";
        Select {
            label: "Stream codec";
            options: ["H.264", "HEVC (Enhanced RTMP / SRT)", "AV1 (Enhanced RTMP / SRT)"];
            current-index: root.form.stream-codec;
            selected(i) => { root.set("stream-codec", i); }
        }
    }
    SettingRow {
        label: "Encoder";
        hint: "Destinations with identical video and audio settings share one encoder";
        Select {
            label: "Stream encoder";
            options: root.form.stream-encoders;
            current-index: root.form.stream-encoder;
            selected(i) => { root.set("stream-encoder", i); }
        }
    }
    SettingRow {
        label: "Bitrate";
        hint: "Constant bitrate; keep the total below ~75% of your upload speed";
        NumberField { label: ""; value: root.form.stream-bitrate; minimum: 500; maximum: 50000; step: 500; suffix: "kbps"; changed(v) => { root.set("stream-bitrate", v); } }
    }
    SettingRow {
        label: "Audio";
        NumberField { label: ""; value: root.form.stream-audio-bitrate; minimum: 64; maximum: 320; step: 32; suffix: "kbps"; changed(v) => { root.set("stream-audio-bitrate", v); } }
        Select {
            label: "Audio track to stream";
            options: ["Track 1", "Track 2", "Track 3", "Track 4", "Track 5", "Track 6"];
            current-index: root.form.stream-track;
            selected(i) => { root.set("stream-track", i); }
        }
    }
    SettingRow {
        label: "Reconnect";
        hint: "Retry automatically if the connection drops";
        Toggle { checked: root.form.stream-reconnect; toggled(v) => { root.set("stream-reconnect", v ? 1 : 0); } }
    }
    if root.form.stream-warning != "": Text {
        text: root.form.stream-warning;
        color: Theme.warn;
        font-size: Theme.font-s;
        wrap: word-wrap;
    }
}

export component SettingsDialog inherits Modal {
    in property <SettingsForm> form;
    in property <string> remote-status;
    property <bool> reveal-password: false;
    callback set(string, float);
    callback set-text(string, string);
    callback browse();


    card-width: 640px;
    card-top: 40px;

    FocusScope {
        height: 0px;
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.dismiss();
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }
    HorizontalLayout {
        padding: 18px;
        padding-bottom: 4px;
        Text { text: "Settings"; color: Theme.text; font-size: Theme.font-xl; font-weight: 700; horizontal-stretch: 1; }
        Button { text: "Done"; kind: "primary"; clicked => { root.dismiss(); } }
    }
    scroller := Flickable {
        height: min(content.preferred-height, 640px);
        width: root.inner-width;
        content-width: root.inner-width;
        content-height: content.preferred-height;
        content := VerticalLayout {
            width: root.inner-width;
            padding: 18px;
            padding-top: 8px;
            spacing: 12px;

            SectionTitle { text: "STREAM DESTINATIONS"; }
            Text {
                text: "Go Live streams to every enabled destination at once.";
                color: Theme.text-faint;
                font-size: Theme.font-s;
                wrap: word-wrap;
            }
            for d[i] in root.form.destinations: Rectangle {
                height: 36px;
                border-radius: Theme.radius-s;
                background: i == root.form.dest-selected ? Theme.accent.with-alpha(0.14) : row-ta.has-hover ? Theme.hover : transparent;
                border-width: i == root.form.dest-selected ? 1px : 0px;
                border-color: Theme.accent.with-alpha(0.5);
                accessible-role: list-item;
                accessible-label: d.name;
                row-ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.set("dest-select", i); }
                }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 6px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Toggle { checked: d.enabled; toggled(v) => { root.set("dest-enable", i); } }
                    }
                    Text { text: d.name; color: d.enabled ? Theme.text : Theme.text-faint; font-size: Theme.font-m; vertical-alignment: center; horizontal-alignment: left; horizontal-stretch: 1; overflow: elide; }
                    if d.protocol != "": VerticalLayout {
                        alignment: center;
                        Badge { text: d.protocol; }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton { icon: Icons.trash; tooltip: "Remove " + d.name; clicked => { root.set("dest-remove", i); } }
                    }
                }
            }
            HorizontalLayout {
                alignment: start;
                Button { text: "Add destination"; has-icon: true; icon: Icons.plus; kind: "ghost"; clicked => { root.set("dest-add", 0); } }
            }
            if root.form.dest-selected >= 0: DestinationEditor {
                form: root.form;
                set(k, v) => { root.set(k, v); }
                set-text(k, v) => { root.set-text(k, v); }
            }

            SectionTitle { text: "RECORDING"; }
            SettingRow {
                label: "Folder";
                TextField { text: root.form.folder; label: "Recording folder"; accepted(t) => { root.set-text("folder", t); } }
                Button { text: "Browse…"; clicked => { root.browse(); } }
            }
            SettingRow {
                label: "File name";
                hint: "Date codes like %Y-%m-%d %H-%M-%S";
                TextField { text: root.form.filename; label: "File name pattern"; accepted(t) => { root.set-text("filename", t); } }
            }
            if root.form.canvas-names.length > 1: SettingRow {
                label: "Canvas";
                hint: "Also used by the replay buffer";
                Select {
                    label: "Canvas to record";
                    options: root.form.rec-canvas-names;
                    current-index: root.form.rec-canvas;
                    selected(i) => { root.set("rec-canvas", i); }
                }
            }
            SettingRow {
                label: "Format";
                Select {
                    label: "Format";
                    options: ["MKV (crash-safe)", "Fragmented MP4 (crash-safe)", "MP4", "MOV"];
                    current-index: root.form.container;
                    selected(i) => { root.set("container", i); }
                }
            }
            SettingRow {
                label: "Remux to MP4";
                hint: "After an MKV recording stops";
                Toggle { checked: root.form.auto-remux; toggled(v) => { root.set("auto-remux", v ? 1 : 0); } }
            }

            SectionTitle { text: "VIDEO ENCODER"; }
            SettingRow {
                label: "Codec";
                Select {
                    label: "Codec";
                    options: ["H.264", "HEVC (H.265)", "AV1"];
                    current-index: root.form.codec;
                    selected(i) => { root.set("codec", i); }
                }
            }
            SettingRow {
                label: "Encoder";
                hint: "Automatic uses your GPU when possible";
                Select {
                    label: "Encoder";
                    options: root.form.encoders;
                    current-index: root.form.encoder;
                    selected(i) => { root.set("encoder", i); }
                }
            }
            SettingRow {
                label: "Rate control";
                Select {
                    label: "Rate control";
                    options: ["Constant bitrate (CBR)", "Variable bitrate (VBR)", "Constant quality"];
                    current-index: root.form.rate-control;
                    selected(i) => { root.set("rate-control", i); }
                }
            }
            if root.form.rate-control != 2: SettingRow {
                label: "Bitrate";
                NumberField { label: ""; value: root.form.bitrate; minimum: 500; maximum: 150000; step: 500; suffix: "kbps"; changed(v) => { root.set("bitrate", v); } }
            }
            if root.form.rate-control == 2: SettingRow {
                label: "Quality";
                hint: "Lower is better; 18–24 is visually lossless";
                NumberField { label: ""; value: root.form.quality; minimum: 1; maximum: 51; changed(v) => { root.set("quality", v); } }
            }
            SettingRow {
                label: "Preset";
                Select {
                    label: "Preset";
                    options: ["Performance", "Balanced", "Quality"];
                    current-index: root.form.preset;
                    selected(i) => { root.set("preset", i); }
                }
            }
            SettingRow {
                label: "Keyframe interval";
                NumberField { label: ""; value: root.form.keyframe; minimum: 1; maximum: 10; suffix: "s"; changed(v) => { root.set("keyframe", v); } }
            }

            SectionTitle { text: "AUDIO"; }
            SettingRow {
                label: "Codec";
                Select {
                    label: "Audio codec";
                    options: ["AAC", "Opus"];
                    current-index: root.form.audio-codec;
                    selected(i) => { root.set("audio-codec", i); }
                }
            }
            SettingRow {
                label: "Bitrate per track";
                NumberField { label: ""; value: root.form.audio-bitrate; minimum: 64; maximum: 512; step: 32; suffix: "kbps"; changed(v) => { root.set("audio-bitrate", v); } }
            }
            SettingRow {
                label: "Tracks to record";
                HorizontalLayout {
                    spacing: 4px;
                    for t in [0, 1, 2, 3, 4, 5]: Rectangle {
                        property <bool> on: mod(floor(root.form.tracks / pow(2, t)), 2) == 1;
                        width: 28px;
                        height: 26px;
                        border-radius: Theme.radius-s;
                        background: on ? Theme.accent : Theme.surface-3;
                        accessible-role: checkbox;
                        accessible-label: "Record track " + (t + 1);
                        accessible-checked: on;
                        Text { text: t + 1; color: on ? Theme.on-accent : Theme.text-muted; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.set("tracks", on ? root.form.tracks - pow(2, t) : root.form.tracks + pow(2, t)); }
                        }
                    }
                }
            }

            SectionTitle { text: "REPLAY BUFFER"; }
            SettingRow {
                label: "Length";
                NumberField { label: ""; value: root.form.replay-seconds; minimum: 5; maximum: 300; step: 5; suffix: "s"; changed(v) => { root.set("replay-seconds", v); } }
            }

            SectionTitle { text: "VIRTUAL CAMERA"; }
            Text {
                text: "Shows a canvas as “eStream Virtual Camera” in Zoom, Teams, Discord, Meet and other apps (Windows 11).";
                color: Theme.text-faint;
                font-size: Theme.font-s;
                wrap: word-wrap;
            }
            SettingRow {
                label: "Canvas";
                Select {
                    label: "Virtual camera canvas";
                    options: root.form.canvas-names;
                    current-index: root.form.vcam-canvas;
                    selected(i) => { root.set("vcam-canvas", i); }
                }
            }
            SettingRow {
                label: "Camera component";
                hint: root.form.vcam-status;
                HorizontalLayout {
                    alignment: start;
                    Button {
                        text: root.form.vcam-installed ? "Reinstall" : "Install";
                        kind: "ghost";
                        tooltip: "Registers the camera with Windows (asks for permission)";
                        clicked => { root.set("vcam-install", 0); }
                    }
                }
            }

            SectionTitle { text: "REMOTE CONTROL"; }
            Text {
                text: "Lets Stream Deck, Touch Portal, Streamer.bot and other obs-websocket tools control eStream.";
                color: Theme.text-faint;
                font-size: Theme.font-s;
                wrap: word-wrap;
            }
            SettingRow {
                label: "Enable server";
                hint: root.remote-status;
                HorizontalLayout {
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Toggle { checked: root.form.remote-enabled; toggled(v) => { root.set("remote-enable", v ? 1 : 0); } }
                    }
                }
            }
            SettingRow {
                label: "Port";
                NumberField { label: ""; value: root.form.remote-port; minimum: 1024; maximum: 65535; step: 1; changed(v) => { root.set("remote-port", v); } committed => { root.set("remote-apply", 0); } }
            }
            SettingRow {
                label: "Require password";
                hint: "Recommended: anyone on your network could connect otherwise.";
                HorizontalLayout {
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Toggle { checked: root.form.remote-auth; toggled(v) => { root.set("remote-auth", v ? 1 : 0); } }
                    }
                }
            }
            if root.form.remote-auth: SettingRow {
                label: "Password";
                HorizontalLayout {
                    spacing: 6px;
                    TextField {
                        label: "Password";
                        text: root.form.remote-password;
                        input-type: root.reveal-password ? InputType.text : InputType.password;
                        accepted(t) => { root.set-text("remote-password", t); }
                        edited(t) => { root.set-text("remote-password-draft", t); }
                    }
                    IconButton {
                        icon: root.reveal-password ? Icons.eye-off : Icons.eye;
                        tooltip: root.reveal-password ? "Hide password" : "Show password";
                        clicked => { root.reveal-password = !root.reveal-password; }
                    }
                    Button { text: "Generate"; kind: "ghost"; tooltip: "Make a new random password"; clicked => { root.set("remote-generate", 0); } }
                }
            }

            SectionTitle { text: "APPEARANCE"; }
            SettingRow {
                label: "Theme";
                Select {
                    label: "Theme";
                    options: ["Dark", "Light", "Follow system"];
                    current-index: root.form.theme;
                    selected(i) => { root.set("theme", i); }
                }
            }
            Text { text: root.form.ffmpeg; color: Theme.text-faint; font-size: Theme.font-xs; }
        }
    }
}
/// Live destinations, opened from the chevron next to Go Live.
export component LivePanel inherits Rectangle {
    in property <[LiveRow]> rows;
    callback toggle(int);
    callback manage();
    callback dismiss();

    // Click-away layer.
    TouchArea {
        clicked => { root.dismiss(); }
    }
    Rectangle {
        x: parent.width - self.width - 12px;
        y: 56px;
        width: 360px;
        height: body.preferred-height;
        background: Theme.surface;
        border-radius: Theme.radius-l;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #00000066;
        accessible-role: groupbox;
        accessible-label: "Stream destinations";
        TouchArea { }
        body := VerticalLayout {
            padding: 12px;
            spacing: 6px;
            HorizontalLayout {
                Text { text: "Destinations"; color: Theme.text; font-size: Theme.font-m; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                Button { text: "Manage…"; kind: "ghost"; clicked => { root.manage(); } }
            }
            if root.rows.length == 0: Text {
                text: "No destinations yet. Add one in Settings.";
                color: Theme.text-faint;
                font-size: Theme.font-s;
                wrap: word-wrap;
            }
            for r[i] in root.rows: HorizontalLayout {
                spacing: 10px;
                padding-top: 4px;
                padding-bottom: 4px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: r.state == 0 ? Theme.text-faint
                            : r.health == 1 ? Theme.ok
                            : r.health == 2 ? Theme.warn
                            : Theme.live;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text { text: r.name; color: Theme.text; font-size: Theme.font-m; overflow: elide; }
                    Text { text: r.info; color: r.state == 4 ? Theme.live : Theme.text-muted; font-size: Theme.font-xs; wrap: word-wrap; }
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: r.state == 0 || r.state == 4 ? "Start" : "Stop";
                        kind: r.state == 0 || r.state == 4 ? "default" : "ghost";
                        tooltip: (r.state == 0 || r.state == 4 ? "Go live on " : "End the stream on ") + r.name;
                        clicked => { root.toggle(i); }
                    }
                }
            }
        }
    }
}

/// Editor for a custom WGSL transition.
export component ShaderDialog inherits Modal {
    in property <string> code;
    in property <string> error;
    in property <string> title: "Custom transition shader";
    in property <string> help;
    callback apply(string);
    callback example();

    // Typing breaks the editor's binding; "Load example" replaces the code.
    changed code => { editor.text = root.code; }

    card-width: 720px;
    card-top: 60px;

    HorizontalLayout {
        padding: 18px;
        padding-bottom: 4px;
        spacing: 8px;
        Text { text: root.title; color: Theme.text; font-size: Theme.font-xl; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
        Button { text: "Load example"; kind: "ghost"; clicked => { root.example(); } }
    }
    VerticalLayout {
        padding: 18px;
        padding-top: 4px;
        spacing: 10px;
        Text {
            text: root.help;
            color: Theme.text-muted;
            font-size: Theme.font-s;
            wrap: word-wrap;
        }
        editor := TextArea {
            height: 300px;
            label: "Shader code";
            text: root.code;
        }
        if root.error != "": Rectangle {
            border-radius: Theme.radius-s;
            background: Theme.live.with-alpha(0.12);
            height: err.preferred-height + 16px;
            err := Text {
                x: 8px;
                width: parent.width - 16px;
                text: root.error;
                color: Theme.live;
                font-size: Theme.font-s;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button { text: "Cancel"; kind: "ghost"; clicked => { root.dismiss(); } }
            Button { text: "Apply"; kind: "primary"; clicked => { root.apply(editor.text); } }
        }
    }
}

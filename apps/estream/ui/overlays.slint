import { Theme, Platform } from "theme.slint";
import { Icons } from "icons.slint";
import { PaletteEntry, Preset, SourceType, SettingsForm, DestinationRow, LiveRow } from "types.slint";
import { Button, IconButton, Icon, Badge, TextField, TextArea, NumberField, Select, Toggle, SectionTitle } from "widgets.slint";
import { KindIcon } from "panels.slint";

// Full-window scrim with a centered card. Clicking the scrim calls `dismiss`.
export component Modal inherits Rectangle {
    in property <length> card-width: 520px;
    in property <length> card-top: -1px;
    in property <bool> dismissable: true;
    /// Shown as a full page (beside the sidebar) instead of a card over the studio.
    in property <bool> as-page: false;
    out property <length> inner-width: card.width;
    callback dismiss();

    background: root.as-page ? Theme.bg : Theme.scrim;
    TouchArea {
        clicked => { if (root.dismissable) { root.dismiss(); } }
    }
    card := Rectangle {
        x: root.as-page ? 0px : (parent.width - self.width) / 2;
        y: root.as-page ? 0px : root.card-top >= 0 ? root.card-top : (parent.height - self.height) / 2;
        width: root.as-page ? parent.width : min(root.card-width, parent.width - 40px);
        height: root.as-page ? parent.height : content.preferred-height;
        background: root.as-page ? Theme.bg : Theme.surface;
        border-radius: root.as-page ? 0px : Theme.radius-l;
        border-width: root.as-page ? 0px : 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: root.as-page ? 0px : 40px;
        drop-shadow-offset-y: 12px;
        drop-shadow-color: #00000080;
        clip: true;
        accessible-role: groupbox;
        TouchArea { }
        content := VerticalLayout {
            alignment: start;
            @children
        }
    }
}

export component CommandPalette inherits Modal {
    in property <[PaletteEntry]> entries;
    in-out property <int> current;
    in-out property <string> query;
    callback query-changed(string);
    callback run(string);

    card-width: 620px;
    card-top: 80px;

    keys := FocusScope {
        capture-key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.dismiss();
                return EventResult.accept;
            }
            if (e.text == Key.DownArrow) {
                root.current = min(root.current + 1, root.entries.length - 1);
                return EventResult.accept;
            }
            if (e.text == Key.UpArrow) {
                root.current = max(0, root.current - 1);
                return EventResult.accept;
            }
            if (e.text == Key.Return) {
                if (root.entries.length > 0) {
                    root.run(root.entries[root.current].id);
                }
                return EventResult.accept;
            }
            return EventResult.reject;
        }
        HorizontalLayout {
            height: 52px;
            padding-left: 16px;
            padding-right: 16px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Icon { source: Icons.search; size: 18px; tint: Theme.text-muted; }
            }
            input := TextInput {
                text <=> root.query;
                single-line: true;
                vertical-alignment: center;
                color: Theme.text;
                font-size: Theme.font-l;
                accessible-label: "Search commands";
                init => { self.focus(); }
                edited => {
                    root.current = 0;
                    root.query-changed(self.text);
                }
            }
            if root.query == "": Text {
                text: "Type a command, scene or source…";
                color: Theme.text-faint;
                font-size: Theme.font-l;
                vertical-alignment: center;
            }
        }
    }
    Rectangle { height: 1px; background: Theme.border; }
    if root.entries.length == 0: Text {
        height: 64px;
        text: "No matches";
        color: Theme.text-faint;
        font-size: Theme.font-m;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    VerticalLayout {
        padding: 6px;
        spacing: 1px;
        for entry[i] in root.entries: Rectangle {
            height: 36px;
            border-radius: Theme.radius-m;
            background: i == root.current ? Theme.accent-soft : entry-ta.has-hover ? Theme.hover : transparent;
            accessible-role: list-item;
            accessible-label: entry.title;
            accessible-item-selected: i == root.current;
            entry-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.run(entry.id); }
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 10px;
                Text {
                    text: entry.title;
                    color: i == root.current ? Theme.text : Theme.text-muted;
                    font-size: Theme.font-m;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Text {
                    text: entry.category;
                    color: Theme.text-faint;
                    font-size: Theme.font-xs;
                    vertical-alignment: center;
                }
                if entry.hint != "": VerticalLayout {
                    alignment: center;
                    Badge { text: entry.hint; }
                }
            }
        }
    }
}

export component AddSourceDialog inherits Modal {
    in property <[SourceType]> types;
    callback pick(string);

    card-width: 560px;

    FocusScope {
        height: 0px;
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.dismiss();
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }
    HorizontalLayout {
        padding: 18px;
        padding-bottom: 6px;
        Text {
            text: "Add a source";
            color: Theme.text;
            font-size: Theme.font-xl;
            font-weight: 700;
            horizontal-stretch: 1;
        }
        Button { text: "Close"; kind: "ghost"; clicked => { root.dismiss(); } }
    }
    Text {
        x: 18px;
        text: "Sources are reusable: add the same source to several scenes.";
        color: Theme.text-muted;
        font-size: Theme.font-s;
    }
    VerticalLayout {
        padding: 12px;
        spacing: 4px;
        for t in root.types: Rectangle {
            height: 54px;
            border-radius: Theme.radius-m;
            background: t.available && type-ta.has-hover ? Theme.hover : transparent;
            opacity: t.available ? 1 : 0.55;
            accessible-role: button;
            accessible-label: t.title;
            accessible-enabled: t.available;
            accessible-action-default => { if (t.available) { root.pick(t.kind); } }
            type-ta := TouchArea {
                enabled: t.available;
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.pick(t.kind); }
            }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: Theme.radius-m;
                        background: t.available ? Theme.accent-soft : Theme.surface-3;
                        KindIcon { kind: t.kind; size: 17px; tint: t.available ? Theme.accent : Theme.text-faint; }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text { text: t.title; color: Theme.text; font-size: Theme.font-m; font-weight: 600; }
                    Text { text: t.description; color: Theme.text-muted; font-size: Theme.font-s; overflow: elide; }
                }
                if !t.available: VerticalLayout {
                    alignment: center;
                    Badge { text: "Soon"; }
                }
            }
        }
    }
}

export component SetupWizard inherits Modal {
    /// What the user wants to do (label + detail).
    in property <[Preset]> purposes;
    in-out property <int> purpose;
    /// What will be set up, from device detection.
    in property <[string]> summary;
    in property <[Preset]> presets;
    in-out property <int> current;
    /// Show the resolution list (otherwise the purpose decides).
    in-out property <bool> custom;
    /// A setup made from the menu (not the first run): another title, and Cancel.
    in property <string> setup-name;
    callback purpose-changed(int);
    callback create();
    callback cancel();

    card-width: 640px;
    dismissable: false;

    VerticalLayout {
        padding: 28px;
        spacing: 16px;
        HorizontalLayout {
            spacing: 14px;
            Image { source: Icons.logo; width: 44px; height: 44px; }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text { text: root.setup-name == "" ? "Welcome to Clutch" : "New setup: " + root.setup-name; color: Theme.text; font-size: 22px; font-weight: 700; }
                Text { text: "What will you use it for? We'll set everything up for you."; color: Theme.text-muted; font-size: Theme.font-m; }
            }
        }

        // Purpose cards, two per row.
        for row in [0, 2]: HorizontalLayout {
            spacing: 10px;
            for k in [0, 1]: Rectangle {
                property <int> i: row + k;
                property <bool> on: i == root.purpose;
                height: 74px;
                horizontal-stretch: 1;
                // Equal halves whatever the text length.
                min-width: 0px;
                preferred-width: 0px;
                border-radius: Theme.radius-m;
                border-width: on ? 2px : 1px;
                border-color: on ? Theme.accent : Theme.border;
                background: on ? Theme.accent-soft : card-ta.has-hover ? Theme.hover : Theme.surface-2;
                accessible-role: radio-button;
                accessible-label: i < root.purposes.length ? root.purposes[i].label : "";
                accessible-checked: on;
                card-ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => {
                        root.purpose = i;
                        root.purpose-changed(i);
                    }
                    double-clicked => {
                        root.purpose = i;
                        root.create();
                    }
                }
                HorizontalLayout {
                    padding: 14px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 10px;
                            background: on ? Theme.accent : Theme.surface-3;
                            Icon {
                                source: i == 0 ? Icons.gamepad : i == 1 ? Icons.camera : i == 2 ? Icons.film : Icons.scan;
                                size: 18px;
                                tint: on ? #ffffff : Theme.text-muted;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text { text: i < root.purposes.length ? root.purposes[i].label : ""; color: Theme.text; font-size: Theme.font-m; font-weight: 700; }
                        Text { text: i < root.purposes.length ? root.purposes[i].detail : ""; color: Theme.text-muted; font-size: Theme.font-s; overflow: elide; }
                    }
                }
            }
        }

        // What will be set up.
        Rectangle {
            height: found.preferred-height;
            border-radius: Theme.radius-m;
            background: Theme.surface-2;
            found := VerticalLayout {
                padding: 12px;
                padding-left: 14px;
                spacing: 5px;
                Text { text: "WE'LL SET UP"; color: Theme.text-faint; font-size: Theme.font-xs; font-weight: 700; }
                for line in root.summary: HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Icon { source: Icons.check; size: 13px; tint: Theme.ok; }
                    }
                    Text { text: line; color: Theme.text; font-size: Theme.font-s; overflow: elide; horizontal-stretch: 1; }
                }
            }
        }

        if root.custom: VerticalLayout {
            spacing: 4px;
            Text { text: "Resolution"; color: Theme.text-muted; font-size: Theme.font-s; }
            for preset[i] in root.presets: Rectangle {
                height: 36px;
                border-radius: Theme.radius-s;
                border-width: 1px;
                border-color: i == root.current ? Theme.accent : Theme.border;
                background: i == root.current ? Theme.accent-soft : preset-ta.has-hover ? Theme.hover : transparent;
                accessible-role: radio-button;
                accessible-label: preset.label;
                accessible-checked: i == root.current;
                preset-ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.current = i; }
                }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 10px;
                    Text { text: preset.label; color: Theme.text; font-size: Theme.font-s; font-weight: 600; vertical-alignment: center; }
                    Text { text: preset.detail; color: Theme.text-muted; font-size: Theme.font-xs; vertical-alignment: center; horizontal-stretch: 1; horizontal-alignment: right; }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Button {
                text: root.custom ? "Use the recommended resolution" : "Choose the resolution myself";
                kind: "ghost";
                clicked => { root.custom = !root.custom; }
            }
            Rectangle { horizontal-stretch: 1; }
            if root.setup-name != "": Button { text: "Cancel"; kind: "ghost"; clicked => { root.cancel(); } }
            Button {
                text: "Get started";
                kind: "primary";
                clicked => { root.create(); }
            }
        }
    }
}

// Names a new setup, renames one, or confirms deleting one.
export component SetupDialog inherits Modal {
    /// "new" | "rename" | "delete"
    in property <string> mode;
    /// The setup being renamed or deleted.
    in property <string> current-name;
    in-out property <string> name;
    in property <string> error;
    callback confirm(string);
    callback cancel();

    card-width: 420px;
    dismiss => { root.cancel(); }
    // Focus after the setup menu has closed (closing it gives focus back to the window).
    Timer {
        interval: 60ms;
        running: true;
        triggered => {
            self.running = false;
            field.focus();
        }
    }
    VerticalLayout {
        padding: 22px;
        spacing: 12px;
        Text {
            text: root.mode == "new" ? "New setup" : root.mode == "rename" ? "Rename setup" : "Delete “" + root.current-name + "”?";
            color: Theme.text;
            font-size: Theme.font-l;
            font-weight: 700;
        }
        Text {
            text: root.mode == "new"
                ? "A setup holds its own scenes, sources and audio. Give it a name, then pick what it's for."
                : root.mode == "rename" ? "The new name for “" + root.current-name + "”."
                : "Its scenes and sources go to the " + Platform.trash + ". Your recordings and clips are kept.";
            color: Theme.text-muted;
            font-size: Theme.font-m;
            wrap: word-wrap;
        }
        field := TextField {
            visible: root.mode != "delete";
            height: self.visible ? 28px : 0px;
            text <=> root.name;
            placeholder: "For example: Valorant, Just chatting";
            label: "Setup name";
            accepted(t) => { root.confirm(t); }
        }
        if root.error != "": Text { text: root.error; color: Theme.live; font-size: Theme.font-s; wrap: word-wrap; }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button { text: "Cancel"; kind: "ghost"; clicked => { root.cancel(); } }
            Button {
                text: root.mode == "new" ? "Next" : root.mode == "rename" ? "Rename" : "Delete";
                kind: root.mode == "delete" ? "danger" : "primary";
                clicked => { root.confirm(root.name); }
            }
        }
    }
}

export component RecoveryPrompt inherits Modal {
    callback restore();
    callback discard();

    card-width: 460px;
    dismissable: false;
    VerticalLayout {
        padding: 24px;
        spacing: 14px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: start;
                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 18px;
                    background: Theme.warn.with-alpha(0.16);
                    Icon { source: Icons.triangle-alert; size: 18px; tint: Theme.warn; }
                }
            }
            VerticalLayout {
                spacing: 6px;
                Text { text: "Restore unsaved changes?"; color: Theme.text; font-size: Theme.font-l; font-weight: 700; }
                Text {
                    text: "Clutch didn't shut down cleanly last time. Your most recent autosave can be restored.";
                    color: Theme.text-muted;
                    font-size: Theme.font-m;
                    wrap: word-wrap;
                }
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button { text: "Discard"; kind: "ghost"; clicked => { root.discard(); } }
            Button { text: "Restore"; kind: "primary"; clicked => { root.restore(); } }
        }
    }
}

export component Toast inherits Rectangle {
    in property <string> text;
    in property <bool> error;
    /// A button after the text ("" = none).
    in property <string> action;
    callback act();
    height: 38px;
    width: row.preferred-width;
    border-radius: 19px;
    background: Theme.dark ? #2b303b : #1d2129;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000060;
    row := HorizontalLayout {
        padding-left: 14px;
        padding-right: root.action != "" ? 6px : 16px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.error ? Theme.live : Theme.ok;
            }
        }
        Text {
            text: root.text;
            color: #f1f3f7;
            font-size: Theme.font-m;
            vertical-alignment: center;
        }
        if root.action != "": VerticalLayout {
            alignment: center;
            Button { text: root.action; kind: "primary"; clicked => { root.act(); } }
        }
    }
}

component SettingRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> hint;
    spacing: 12px;
    VerticalLayout {
        width: 170px;
        alignment: center;
        Text { text: root.label; color: Theme.text; font-size: Theme.font-m; }
        if root.hint != "": Text { width: 170px; text: root.hint; color: Theme.text-faint; font-size: Theme.font-xs; wrap: word-wrap; }
    }
    @children
}

// Editor for the selected streaming destination.
component DestinationEditor inherits VerticalLayout {
    in property <SettingsForm> form;
    callback set(string, float);
    callback set-text(string, string);

    spacing: 12px;

    // Typing breaks the text fields' bindings; re-sync them when another destination is
    // selected or a preset changes the server.
    property <int> selected: root.form.dest-selected;
    property <string> server: root.form.stream-server;
    changed selected => {
        name-field.text = root.form.dest-name;
        server-field.text = root.form.stream-server;
        key-field.text = "";
        channel-field.text = root.form.dest-channel;
    }
    changed server => {
        if (server-field.text != self.server) {
            server-field.text = self.server;
        }
    }

    SettingRow {
        label: "Name";
        name-field := TextField {
            text: root.form.dest-name;
            label: "Destination name";
            edited(t) => { root.set-text("dest-name", t); }
        }
    }
    SettingRow {
        label: "Service";
        Select {
            label: "Streaming service";
            options: root.form.stream-services;
            current-index: root.form.stream-service;
            selected(i) => { root.set("stream-service", i); }
        }
    }
    SettingRow {
        label: "Server";
        hint: root.form.stream-protocol != "" ? "Detected: " + root.form.stream-protocol : "rtmp(s)://, srt://, rist:// or https:// (WHIP)";
        server-field := TextField {
            text: root.form.stream-server;
            label: "Stream server";
            placeholder: "rtmps://…";
            edited(t) => { root.set-text("stream-server", t); }
        }
    }
    SettingRow {
        label: "Stream key";
        hint: Platform.key-storage;
        key-field := TextField {
            input-type: InputType.password;
            label: "Stream key";
            placeholder: root.form.stream-key-set ? "Saved — type to replace" : "Paste your stream key";
            edited(t) => { root.set-text("stream-key", t); }
        }
    }
    SettingRow {
        label: "Channel";
        hint: "For the chat tab: your channel name on Kick or Twitch, or your live link on YouTube";
        channel-field := TextField {
            text: root.form.dest-channel;
            label: "Channel for chat";
            placeholder: "Channel name or live link";
            edited(t) => { root.set-text("dest-channel", t); }
        }
    }
    if root.form.account-kind != "": account-row := SettingRow {
        property <string> platform: root.form.account-kind == "twitch" ? "Twitch" : "YouTube";
        label: "Account";
        hint: root.form.account-kind == "twitch" ? "Connect to see your viewer count and who's in chat" : "Connect to see your viewer count and open your live chat automatically";
        HorizontalLayout {
            spacing: 8px;
            if root.form.account-name != "": Text {
                text: "Connected as " + root.form.account-name;
                color: Theme.text;
                font-size: Theme.font-m;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if root.form.account-name != "": Button {
                text: "Disconnect";
                kind: "ghost";
                clicked => { root.set("account-disconnect", 0); }
            }
            if root.form.account-name == "" && root.form.account-connecting: Text {
                text: root.form.account-code != "" ? "Enter code " + root.form.account-code + " on the " + account-row.platform + " page" : root.form.account-kind == "youtube" ? "Finish signing in to Google in your browser" : "Contacting " + account-row.platform + "…";
                color: Theme.text;
                font-size: Theme.font-m;
                vertical-alignment: center;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
            if root.form.account-name == "" && (root.form.account-code != "" || (root.form.account-kind == "youtube" && root.form.account-connecting)): Button {
                text: "Open page";
                kind: "ghost";
                clicked => { root.set("account-open", 0); }
            }
            if root.form.account-name == "" && root.form.account-connecting: Button {
                text: "Cancel";
                kind: "ghost";
                clicked => { root.set("account-cancel", 0); }
            }
            if root.form.account-name == "" && !root.form.account-connecting: Button {
                text: "Connect " + account-row.platform;
                clicked => { root.set("account-connect", 0); }
            }
            if root.form.account-name == "" && !root.form.account-connecting: Rectangle { horizontal-stretch: 1; }
        }
    }
    if root.form.canvas-names.length > 1: SettingRow {
        label: "Canvas";
        hint: "Which canvas this destination streams";
        Select {
            label: "Destination canvas";
            options: root.form.canvas-names;
            current-index: root.form.dest-canvas;
            selected(i) => { root.set("dest-canvas", i); }
        }
    }
    SettingRow {
        label: "Video";
        Select {
            label: "Stream codec";
            options: ["H.264", "HEVC (Enhanced RTMP / SRT)", "AV1 (Enhanced RTMP / SRT)"];
            current-index: root.form.stream-codec;
            selected(i) => { root.set("stream-codec", i); }
        }
    }
    SettingRow {
        label: "Encoder";
        hint: "Destinations with identical video and audio settings share one encoder";
        Select {
            label: "Stream encoder";
            options: root.form.stream-encoders;
            current-index: root.form.stream-encoder;
            selected(i) => { root.set("stream-encoder", i); }
        }
    }
    SettingRow {
        label: "Bitrate";
        hint: "Constant bitrate; keep the total below ~75% of your upload speed";
        NumberField { label: ""; value: root.form.stream-bitrate; minimum: 500; maximum: 50000; step: 500; suffix: "kbps"; changed(v) => { root.set("stream-bitrate", v); } }
    }
    SettingRow {
        label: "Audio";
        NumberField { label: ""; value: root.form.stream-audio-bitrate; minimum: 64; maximum: 320; step: 32; suffix: "kbps"; changed(v) => { root.set("stream-audio-bitrate", v); } }
        Select {
            label: "Audio track to stream";
            options: ["Track 1", "Track 2", "Track 3", "Track 4", "Track 5", "Track 6"];
            current-index: root.form.stream-track;
            selected(i) => { root.set("stream-track", i); }
        }
    }
    SettingRow {
        label: "Reconnect";
        hint: "Retry automatically if the connection drops";
        Toggle { checked: root.form.stream-reconnect; toggled(v) => { root.set("stream-reconnect", v ? 1 : 0); } }
    }
    if root.form.stream-warning != "": Text {
        text: root.form.stream-warning;
        color: Theme.warn;
        font-size: Theme.font-s;
        wrap: word-wrap;
    }
}

/// One entry in the Settings page list.
component SettingsPageItem inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> current;
    callback clicked;
    height: 34px;
    border-radius: Theme.radius-s;
    background: root.current ? Theme.accent.with-alpha(0.14) : ta.has-hover ? Theme.hover : transparent;
    accessible-role: tab;
    accessible-label: root.label;
    accessible-checked: root.current;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon { source: root.icon; size: 16px; tint: root.current ? Theme.accent : Theme.text-muted; }
        }
        Text {
            text: root.label;
            color: root.current ? Theme.text : Theme.text-muted;
            font-size: Theme.font-m;
            font-weight: root.current ? 600 : 500;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

/// One profile on the Performance page.
component ProfileCard inherits Rectangle {
    in property <string> name;
    in property <string> detail;
    in property <bool> current;
    in property <bool> recommended;
    in property <bool> pending;
    /// The detail text's wrap width (set from outside: the card's own width comes from its row).
    in property <length> text-width;
    callback clicked;
    height: 132px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-m;
    border-width: root.pending || root.current ? 2px : 1px;
    border-color: root.pending ? Theme.accent : root.current ? Theme.accent.with-alpha(0.5) : Theme.border;
    background: ta.has-hover ? Theme.hover : Theme.surface-2;
    accessible-role: button;
    accessible-label: root.name + (root.current ? ", current" : "") + (root.recommended ? ", recommended" : "");
    accessible-action-default => { root.clicked(); }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
        VerticalLayout {
            padding: 12px;
            spacing: 6px;
            alignment: start;
            Text { text: root.name; color: Theme.text; font-size: Theme.font-m; font-weight: 700; }
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                height: 18px;
                if root.current: Badge { text: "Current"; tone: Theme.accent; }
                if root.recommended: Badge { text: "Recommended"; tone: Theme.ok; }
            }
            Text {
                width: root.text-width;
                text: root.detail;
                color: Theme.text-faint;
                font-size: Theme.font-s;
                wrap: word-wrap;
            }
        }
    }
}

// Settings in pages: a list on the left, one page at a time on the right.
export component SettingsDialog inherits Modal {
    in property <SettingsForm> form;
    in property <string> remote-status;
    /// The page shown: 0 Performance, 1 Stream, 2 Recording, 3 Clips, 4 Virtual camera,
    /// 5 Remote control, 6 Appearance.
    in-out property <int> page;
    property <bool> reveal-password: false;
    property <[{icon: image, label: string}]> pages: [
        { icon: Icons.gauge, label: "Performance" },
        { icon: Icons.radio, label: "Stream" },
        { icon: Icons.circle, label: "Recording" },
        { icon: Icons.scissors, label: "Clips" },
        { icon: Icons.camera, label: "Virtual camera" },
        { icon: Icons.globe, label: "Remote control" },
        { icon: Icons.palette, label: "Appearance" },
    ];
    callback set(string, float);
    callback set-text(string, string);
    callback browse();

    card-width: 820px;
    card-top: 40px;

    keys := FocusScope {
        height: 0px;
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.dismiss();
                return EventResult.accept;
            }
            if (e.text == Key.UpArrow && root.page > 0) {
                root.page -= 1;
                return EventResult.accept;
            }
            if (e.text == Key.DownArrow && root.page < root.pages.length - 1) {
                root.page += 1;
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }
    HorizontalLayout {
        padding: 18px;
        padding-bottom: 4px;
        Text { text: "Settings"; color: Theme.text; font-size: Theme.font-xl; font-weight: 700; horizontal-stretch: 1; }
        Button { text: "Done"; kind: "primary"; clicked => { root.dismiss(); } }
    }
    HorizontalLayout {
        // The same height on every page, so the window doesn't jump when switching.
        height: 600px;
        VerticalLayout {
            width: 190px;
            padding: 12px;
            padding-top: 8px;
            spacing: 2px;
            alignment: start;
            accessible-role: tab-list;
            accessible-label: "Settings pages";
            for p[i] in root.pages: SettingsPageItem {
                icon: p.icon;
                label: p.label;
                current: i == root.page;
                clicked => {
                    root.page = i;
                    keys.focus();
                }
            }
        }
        Rectangle { width: 1px; background: Theme.border; }
        scroller := Flickable {
            property <length> page-width: root.inner-width - 191px;
            width: self.page-width;
            content-width: self.page-width;
            content-height: content.preferred-height;
            content := VerticalLayout {
                width: scroller.page-width;
                padding: 18px;
                padding-top: 8px;
                spacing: 12px;
                alignment: start;

                if root.page == 0: VerticalLayout {
                    spacing: 12px;
                    SectionTitle { text: "PERFORMANCE"; }
                    Text {
                        text: "Recording, clips and streaming run next to your game. A profile sets how much of your PC they may use; your scenes, sources and keys stay as they are.";
                        color: Theme.text-faint;
                        font-size: Theme.font-s;
                        wrap: word-wrap;
                        width: scroller.page-width - 36px;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        for p[i] in [
                            { name: "Gaming", detail: "Lightest on your game: the encoder's fastest setting and a 60 s clip buffer." },
                            { name: "Balanced", detail: "Good quality at little cost to your game, with a 120 s clip buffer." },
                            { name: "Quality", detail: "Best-looking recordings for strong PCs; the encoder works harder." },
                        ]: ProfileCard {
                            name: p.name;
                            detail: p.detail;
                            current: i == root.form.perf-current;
                            recommended: i == root.form.perf-recommended;
                            pending: i == root.form.perf-pending;
                            text-width: (scroller.page-width - 36px - 20px) / 3 - 24px;
                            clicked => { root.set("perf-pick", i); }
                        }
                    }
                    if root.form.perf-current == -1: Text {
                        text: "Your settings don't match a profile because some were changed by hand (Custom). Pick a profile to use its settings again.";
                        color: Theme.text-muted;
                        font-size: Theme.font-s;
                        wrap: word-wrap;
                        width: scroller.page-width - 36px;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text { text: "This PC"; color: Theme.text; font-size: Theme.font-m; }
                            Text {
                                text: root.form.perf-found;
                                color: Theme.text-faint;
                                font-size: Theme.font-xs;
                                wrap: word-wrap;
                                width: scroller.page-width - 36px - 200px;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Button {
                                text: "Optimize for this PC";
                                kind: "primary";
                                has-icon: true;
                                icon: Icons.sparkles;
                                tooltip: "Recommends a profile from this PC's encoder, processor and memory";
                                clicked => { root.set("perf-optimize", 0); }
                            }
                        }
                    }
                    if root.form.perf-warning != "": Text {
                        text: root.form.perf-warning;
                        color: Theme.warn;
                        font-size: Theme.font-s;
                        wrap: word-wrap;
                        width: scroller.page-width - 36px;
                    }
                    // The chosen profile, waiting for confirmation, with what it would change.
                    if root.form.perf-pending >= 0: Rectangle {
                        height: confirm.preferred-height;
                        border-radius: Theme.radius-m;
                        background: Theme.accent.with-alpha(0.10);
                        border-width: 1px;
                        border-color: Theme.accent.with-alpha(0.4);
                        confirm := VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            Text {
                                property <string> name: root.form.perf-pending == 0 ? "Gaming" : root.form.perf-pending == 1 ? "Balanced" : "Quality";
                                text: root.form.perf-pending == root.form.perf-recommended
                                    ? "Recommended for this PC: " + self.name
                                    : root.form.perf-changes.length == 0 ? self.name : "Switch to " + self.name + "?";
                                color: Theme.text;
                                font-size: Theme.font-m;
                                font-weight: 700;
                            }
                            if root.form.perf-changes.length == 0: Text {
                                text: "Your settings already match this profile.";
                                color: Theme.text-muted;
                                font-size: Theme.font-s;
                            }
                            for c in root.form.perf-changes: Text {
                                text: "•  " + c;
                                color: Theme.text-muted;
                                font-size: Theme.font-s;
                                wrap: word-wrap;
                                width: scroller.page-width - 36px - 24px;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;
                                Button {
                                    text: root.form.perf-changes.length == 0 ? "Close" : "Cancel";
                                    kind: "ghost";
                                    clicked => { root.set("perf-cancel", 0); }
                                }
                                if root.form.perf-changes.length > 0: Button {
                                    text: "Apply";
                                    kind: "primary";
                                    clicked => { root.set("perf-apply", 0); }
                                }
                            }
                        }
                    }
                    if root.form.perf-can-revert: HorizontalLayout {
                        alignment: start;
                        Button {
                            text: "Undo last profile change";
                            kind: "ghost";
                            has-icon: true;
                            icon: Icons.undo;
                            clicked => { root.set("perf-revert", 0); }
                        }
                    }
                }

                if root.page == 1: VerticalLayout {
                    spacing: 12px;
                    SectionTitle { text: "STREAM DESTINATIONS"; }
                    Text {
                        text: "Go Live streams to every enabled destination at once.";
                        color: Theme.text-faint;
                        font-size: Theme.font-s;
                        wrap: word-wrap;
                        width: scroller.page-width - 36px;
                    }
                    for d[i] in root.form.destinations: Rectangle {
                        height: 36px;
                        border-radius: Theme.radius-s;
                        background: i == root.form.dest-selected ? Theme.accent.with-alpha(0.14) : row-ta.has-hover ? Theme.hover : transparent;
                        border-width: i == root.form.dest-selected ? 1px : 0px;
                        border-color: Theme.accent.with-alpha(0.5);
                        accessible-role: list-item;
                        accessible-label: d.name;
                        row-ta := TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.set("dest-select", i); }
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 6px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                Toggle { checked: d.enabled; toggled(v) => { root.set("dest-enable", i); } }
                            }
                            Text { text: d.name; color: d.enabled ? Theme.text : Theme.text-faint; font-size: Theme.font-m; vertical-alignment: center; horizontal-alignment: left; horizontal-stretch: 1; overflow: elide; }
                            if d.protocol != "": VerticalLayout {
                                alignment: center;
                                Badge { text: d.protocol; }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton { icon: Icons.trash; tooltip: "Remove " + d.name; clicked => { root.set("dest-remove", i); } }
                            }
                        }
                    }
                    HorizontalLayout {
                        alignment: start;
                        Button { text: "Add destination"; has-icon: true; icon: Icons.plus; kind: "ghost"; clicked => { root.set("dest-add", 0); } }
                    }
                    if root.form.dest-selected >= 0: DestinationEditor {
                        form: root.form;
                        set(k, v) => { root.set(k, v); }
                        set-text(k, v) => { root.set-text(k, v); }
                    }
                }

                if root.page == 2: VerticalLayout {
                    spacing: 12px;
                    SectionTitle { text: "RECORDING"; }
                    SettingRow {
                        label: "Folder";
                        TextField { text: root.form.folder; label: "Recording folder"; accepted(t) => { root.set-text("folder", t); } }
                        Button { text: "Browse…"; clicked => { root.browse(); } }
                    }
                    SettingRow {
                        label: "File name";
                        hint: "Date codes like %Y-%m-%d %H-%M-%S";
                        TextField { text: root.form.filename; label: "File name pattern"; accepted(t) => { root.set-text("filename", t); } }
                    }
                    if root.form.canvas-names.length > 1: SettingRow {
                        label: "Canvas";
                        hint: "Also used by the replay buffer";
                        Select {
                            label: "Canvas to record";
                            options: root.form.rec-canvas-names;
                            current-index: root.form.rec-canvas;
                            selected(i) => { root.set("rec-canvas", i); }
                        }
                    }
                    SettingRow {
                        label: "Format";
                        Select {
                            label: "Format";
                            options: ["MKV (crash-safe)", "Fragmented MP4 (crash-safe)", "MP4", "MOV"];
                            current-index: root.form.container;
                            selected(i) => { root.set("container", i); }
                        }
                    }
                    SettingRow {
                        label: "Remux to MP4";
                        hint: "After an MKV recording stops";
                        Toggle { checked: root.form.auto-remux; toggled(v) => { root.set("auto-remux", v ? 1 : 0); } }
                    }

                    SectionTitle { text: "VIDEO ENCODER"; }
                    SettingRow {
                        label: "Codec";
                        Select {
                            label: "Codec";
                            options: ["H.264", "HEVC (H.265)", "AV1"];
                            current-index: root.form.codec;
                            selected(i) => { root.set("codec", i); }
                        }
                    }
                    SettingRow {
                        label: "Encoder";
                        hint: "Automatic uses your GPU when possible";
                        Select {
                            label: "Encoder";
                            options: root.form.encoders;
                            current-index: root.form.encoder;
                            selected(i) => { root.set("encoder", i); }
                        }
                    }
                    SettingRow {
                        label: "Rate control";
                        Select {
                            label: "Rate control";
                            options: ["Constant bitrate (CBR)", "Variable bitrate (VBR)", "Constant quality"];
                            current-index: root.form.rate-control;
                            selected(i) => { root.set("rate-control", i); }
                        }
                    }
                    if root.form.rate-control != 2: SettingRow {
                        label: "Bitrate";
                        NumberField { label: ""; value: root.form.bitrate; minimum: 500; maximum: 150000; step: 500; suffix: "kbps"; changed(v) => { root.set("bitrate", v); } }
                    }
                    if root.form.rate-control == 2: SettingRow {
                        label: "Quality";
                        hint: "Lower is better; 18–24 is visually lossless";
                        NumberField { label: ""; value: root.form.quality; minimum: 1; maximum: 51; changed(v) => { root.set("quality", v); } }
                    }
                    SettingRow {
                        label: "Preset";
                        Select {
                            label: "Preset";
                            options: ["Performance", "Balanced", "Quality"];
                            current-index: root.form.preset;
                            selected(i) => { root.set("preset", i); }
                        }
                    }
                    SettingRow {
                        label: "Keyframe interval";
                        NumberField { label: ""; value: root.form.keyframe; minimum: 1; maximum: 10; suffix: "s"; changed(v) => { root.set("keyframe", v); } }
                    }

                    SectionTitle { text: "AUDIO"; }
                    SettingRow {
                        label: "Codec";
                        Select {
                            label: "Audio codec";
                            options: ["AAC", "Opus"];
                            current-index: root.form.audio-codec;
                            selected(i) => { root.set("audio-codec", i); }
                        }
                    }
                    SettingRow {
                        label: "Bitrate per track";
                        NumberField { label: ""; value: root.form.audio-bitrate; minimum: 64; maximum: 512; step: 32; suffix: "kbps"; changed(v) => { root.set("audio-bitrate", v); } }
                    }
                    SettingRow {
                        label: "Tracks to record";
                        HorizontalLayout {
                            spacing: 4px;
                            for t in [0, 1, 2, 3, 4, 5]: Rectangle {
                                property <bool> on: mod(floor(root.form.tracks / pow(2, t)), 2) == 1;
                                width: 28px;
                                height: 26px;
                                border-radius: Theme.radius-s;
                                background: on ? Theme.accent : Theme.surface-3;
                                accessible-role: checkbox;
                                accessible-label: "Record track " + (t + 1);
                                accessible-checked: on;
                                Text { text: t + 1; color: on ? Theme.on-accent : Theme.text-muted; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                TouchArea {
                                    mouse-cursor: MouseCursor.pointer;
                                    clicked => { root.set("tracks", on ? root.form.tracks - pow(2, t) : root.form.tracks + pow(2, t)); }
                                }
                            }
                        }
                    }
                }

                if root.page == 3: VerticalLayout {
                    spacing: 12px;
                    SectionTitle { text: "REPLAY BUFFER"; }
                    SettingRow {
                        label: "Length";
                        NumberField { label: ""; value: root.form.replay-seconds; minimum: 5; maximum: 300; step: 5; suffix: "s"; changed(v) => { root.set("replay-seconds", v); } }
                    }

                    SectionTitle { text: "CLIPS"; }
                    Text {
                        text: "Save your best moments without streaming or recording: Clutch keeps the last minutes in memory while you play, and the clip hotkey saves them.";
                        color: Theme.text-faint;
                        font-size: Theme.font-s;
                        wrap: word-wrap;
                        width: scroller.page-width - 36px;
                    }
                    if root.form.clip-ask != "": Rectangle {
                        height: ask.preferred-height + 16px;
                        border-radius: Theme.radius-s;
                        background: Theme.accent.with-alpha(0.12);
                        ask := HorizontalLayout {
                            padding: 8px;
                            spacing: 8px;
                            Text { text: "Is " + root.form.clip-ask + " a game? Clip mode will follow it."; color: Theme.text; font-size: Theme.font-s; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                            Button { text: "It's a game"; kind: "primary"; clicked => { root.set("clip-ask-yes", 0); } }
                            Button { text: "Not a game"; kind: "ghost"; clicked => { root.set("clip-ask-no", 0); } }
                        }
                    }
                    SettingRow {
                        label: "Clip mode";
                        hint: "Runs the replay buffer by itself while a game is open";
                        HorizontalLayout {
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Toggle { checked: root.form.clip-mode; toggled(v) => { root.set("clip-mode", v ? 1 : 0); } }
                            }
                        }
                    }
                    SettingRow {
                        label: "Keep in memory";
                        hint: "How much the buffer holds in clip mode";
                        NumberField { label: ""; value: root.form.clip-buffer; minimum: 30; maximum: 600; step: 30; suffix: "s"; changed(v) => { root.set("clip-buffer", v); } }
                    }
                    SettingRow {
                        label: "Clip hotkey";
                        hint: Platform.hotkeys-note != "" ? Platform.hotkeys-note : "Works in games, e.g. F8 or Ctrl+Shift+C";
                        TextField { text: root.form.clip-hotkey; label: "Clip hotkey"; accepted(t) => { root.set-text("clip-hotkey", t); } }
                        NumberField { width: 110px; label: ""; value: root.form.clip-seconds; minimum: 5; maximum: 600; step: 5; suffix: "s"; changed(v) => { root.set("clip-seconds", v); } }
                    }
                    SettingRow {
                        label: "Longest clip";
                        hint: "Events close together merge into one clip up to this length";
                        NumberField { label: ""; value: root.form.clip-max; minimum: 15; maximum: 300; step: 15; suffix: "s"; changed(v) => { root.set("clip-max", v); } }
                    }
                    SettingRow {
                        label: "Sound when saved";
                        HorizontalLayout {
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Toggle { checked: root.form.clip-sound; toggled(v) => { root.set("clip-sound", v ? 1 : 0); } }
                            }
                        }
                    }
                    SettingRow {
                        label: "Clips folder";
                        TextField { text: root.form.clip-folder; label: "Clips folder"; accepted(t) => { root.set-text("clip-folder", t); } }
                    }
                    SettingRow {
                        label: "Storage limit";
                        hint: "Oldest automatic clips are deleted past this; favorites and your own clips never are";
                        NumberField { label: ""; value: root.form.clip-cap; minimum: 1; maximum: 2000; step: 5; suffix: "GB"; changed(v) => { root.set("clip-cap", v); } }
                    }

                    Text { text: "AUTO-CLIP"; color: Theme.text-muted; font-size: Theme.font-xs; font-weight: 600; }
                    Text {
                        text: "Connect a game to clip kills, wins and objectives automatically. Clutch uses each game's official local event API, so nothing touches the game itself.";
                        color: Theme.text-faint;
                        font-size: Theme.font-s;
                        wrap: word-wrap;
                        width: scroller.page-width - 36px;
                    }
                    for g[i] in root.form.clip-integrations: HorizontalLayout {
                        spacing: 10px;
                        height: 32px;
                        Text { text: g.name; color: Theme.text; font-size: Theme.font-m; vertical-alignment: center; width: 170px; }
                        Text { text: g.status; color: g.connected ? Theme.text-muted : Theme.text-faint; font-size: Theme.font-s; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                        Button {
                            text: g.connected ? "Disconnect" : "Connect";
                            kind: g.connected ? "ghost" : "default";
                            tooltip: g.connected ? "Stop listening to this game" : "Set up auto-clip for this game";
                            clicked => { root.set(g.connected ? "clip-disconnect" : "clip-connect", i); }
                        }
                    }
                    SettingRow {
                        label: "Rules for";
                        Select {
                            label: "Game";
                            options: root.form.clip-rule-games;
                            current-index: root.form.clip-rule-game;
                            selected(i) => { root.set("clip-rule-game", i); }
                        }
                    }
                    for r[i] in root.form.clip-rules: HorizontalLayout {
                        spacing: 10px;
                        height: 30px;
                        VerticalLayout {
                            alignment: center;
                            Toggle { checked: r.enabled; toggled(v) => { root.set("clip-rule-enable", i); } }
                        }
                        Text { text: r.event; color: r.enabled ? Theme.text : Theme.text-faint; font-size: Theme.font-m; vertical-alignment: center; width: 140px; }
                        NumberField { width: 110px; label: ""; enabled: r.enabled; value: r.pre; minimum: 1; maximum: 120; suffix: "s before"; changed(v) => { root.set("clip-rule-pre:" + i, v); } }
                        NumberField { width: 110px; label: ""; enabled: r.enabled; value: r.post; minimum: 0; maximum: 60; suffix: "s after"; changed(v) => { root.set("clip-rule-post:" + i, v); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    SettingRow {
                        label: "Hype: game audio";
                        hint: "Any game: clip when it suddenly gets loud";
                        HorizontalLayout {
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Toggle { checked: root.form.hype-game; toggled(v) => { root.set("hype-game", v ? 1 : 0); } }
                            }
                        }
                    }
                    SettingRow {
                        label: "Hype: microphone";
                        hint: "Clip when you shout or cheer";
                        HorizontalLayout {
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Toggle { checked: root.form.hype-mic; toggled(v) => { root.set("hype-mic", v ? 1 : 0); } }
                            }
                        }
                    }
                    if root.form.hype-game || root.form.hype-mic: SettingRow {
                        label: "Hype sensitivity";
                        Select {
                            label: "Hype sensitivity";
                            options: ["Low (only big moments)", "Medium", "High (more clips)"];
                            current-index: root.form.hype-sensitivity;
                            selected(i) => { root.set("hype-sensitivity", i); }
                        }
                    }
                }

                if root.page == 4: VerticalLayout {
                    spacing: 12px;
                    SectionTitle { text: "VIRTUAL CAMERA"; }
                    Text {
                        text: "Shows a canvas as a camera in Zoom, Teams, Discord, Meet and other apps (Windows 11, or Linux with v4l2loopback).";
                        color: Theme.text-faint;
                        font-size: Theme.font-s;
                        wrap: word-wrap;
                        width: scroller.page-width - 36px;
                    }
                    SettingRow {
                        label: "Canvas";
                        Select {
                            label: "Virtual camera canvas";
                            options: root.form.canvas-names;
                            current-index: root.form.vcam-canvas;
                            selected(i) => { root.set("vcam-canvas", i); }
                        }
                    }
                    SettingRow {
                        label: Platform.vcam-installable ? "Camera component" : "Camera device";
                        hint: root.form.vcam-status;
                        if Platform.vcam-installable: HorizontalLayout {
                            alignment: start;
                            Button {
                                text: root.form.vcam-installed ? "Reinstall" : "Install";
                                kind: "ghost";
                                tooltip: "Registers the camera with Windows (asks for permission)";
                                clicked => { root.set("vcam-install", 0); }
                            }
                        }
                    }
                }

                if root.page == 5: VerticalLayout {
                    spacing: 12px;
                    SectionTitle { text: "REMOTE CONTROL"; }
                    Text {
                        text: "Lets Stream Deck, Touch Portal, Streamer.bot and other obs-websocket tools control Clutch.";
                        color: Theme.text-faint;
                        font-size: Theme.font-s;
                        wrap: word-wrap;
                        width: scroller.page-width - 36px;
                    }
                    SettingRow {
                        label: "Enable server";
                        hint: root.remote-status;
                        HorizontalLayout {
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Toggle { checked: root.form.remote-enabled; toggled(v) => { root.set("remote-enable", v ? 1 : 0); } }
                            }
                        }
                    }
                    SettingRow {
                        label: "Port";
                        NumberField { label: ""; value: root.form.remote-port; minimum: 1024; maximum: 65535; step: 1; changed(v) => { root.set("remote-port", v); } committed => { root.set("remote-apply", 0); } }
                    }
                    SettingRow {
                        label: "Require password";
                        hint: "Recommended: anyone on your network could connect otherwise.";
                        HorizontalLayout {
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Toggle { checked: root.form.remote-auth; toggled(v) => { root.set("remote-auth", v ? 1 : 0); } }
                            }
                        }
                    }
                    if root.form.remote-auth: SettingRow {
                        label: "Password";
                        HorizontalLayout {
                            spacing: 6px;
                            TextField {
                                label: "Password";
                                text: root.form.remote-password;
                                input-type: root.reveal-password ? InputType.text : InputType.password;
                                accepted(t) => { root.set-text("remote-password", t); }
                                edited(t) => { root.set-text("remote-password-draft", t); }
                            }
                            IconButton {
                                icon: root.reveal-password ? Icons.eye-off : Icons.eye;
                                tooltip: root.reveal-password ? "Hide password" : "Show password";
                                clicked => { root.reveal-password = !root.reveal-password; }
                            }
                            Button { text: "Generate"; kind: "ghost"; tooltip: "Make a new random password"; clicked => { root.set("remote-generate", 0); } }
                        }
                    }
                }

                if root.page == 6: VerticalLayout {
                    spacing: 12px;
                    SectionTitle { text: "APPEARANCE"; }
                    SettingRow {
                        label: "Theme";
                        Select {
                            label: "Theme";
                            options: ["Dark", "Light", "Follow system"];
                            current-index: root.form.theme;
                            selected(i) => { root.set("theme", i); }
                        }
                    }
                    Text { text: root.form.ffmpeg; color: Theme.text-faint; font-size: Theme.font-xs; }
                }
            }
        }
    }
}
/// Live destinations, opened from the chevron next to Go Live.
export component LivePanel inherits Rectangle {
    in property <[LiveRow]> rows;
    callback toggle(int);
    callback manage();
    callback add-platform();
    callback dismiss();

    // Click-away layer.
    TouchArea {
        clicked => { root.dismiss(); }
    }
    Rectangle {
        x: parent.width - self.width - 12px;
        y: 56px;
        width: 360px;
        height: body.preferred-height;
        background: Theme.surface;
        border-radius: Theme.radius-l;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: #00000066;
        accessible-role: groupbox;
        accessible-label: "Stream destinations";
        TouchArea { }
        body := VerticalLayout {
            padding: 12px;
            spacing: 6px;
            HorizontalLayout {
                Text { text: "Destinations"; color: Theme.text; font-size: Theme.font-m; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                Button { text: "Add platform"; kind: "ghost"; clicked => { root.add-platform(); } }
                Button { text: "Manage…"; kind: "ghost"; clicked => { root.manage(); } }
            }
            if root.rows.length == 0: Text {
                text: "No destinations yet. Click Add platform to stream to Twitch, YouTube, Kick or Facebook.";
                color: Theme.text-faint;
                font-size: Theme.font-s;
                wrap: word-wrap;
            }
            for r[i] in root.rows: HorizontalLayout {
                spacing: 10px;
                padding-top: 4px;
                padding-bottom: 4px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: r.state == 0 ? Theme.text-faint
                            : r.health == 1 ? Theme.ok
                            : r.health == 2 ? Theme.warn
                            : Theme.live;
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text { text: r.name; color: Theme.text; font-size: Theme.font-m; overflow: elide; }
                    Text { text: r.info; color: r.state == 4 ? Theme.live : Theme.text-muted; font-size: Theme.font-xs; wrap: word-wrap; }
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: r.state == 0 || r.state == 4 ? "Start" : "Stop";
                        kind: r.state == 0 || r.state == 4 ? "default" : "ghost";
                        tooltip: (r.state == 0 || r.state == 4 ? "Go live on " : "End the stream on ") + r.name;
                        clicked => { root.toggle(i); }
                    }
                }
            }
        }
    }
}

/// Editor for a custom WGSL transition.
export component ShaderDialog inherits Modal {
    in property <string> code;
    in property <string> error;
    in property <string> title: "Custom transition shader";
    in property <string> help;
    callback apply(string);
    callback example();

    // Typing breaks the editor's binding; "Load example" replaces the code.
    changed code => { editor.text = root.code; }

    card-width: 720px;
    card-top: 60px;

    HorizontalLayout {
        padding: 18px;
        padding-bottom: 4px;
        spacing: 8px;
        Text { text: root.title; color: Theme.text; font-size: Theme.font-xl; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
        Button { text: "Load example"; kind: "ghost"; clicked => { root.example(); } }
    }
    VerticalLayout {
        padding: 18px;
        padding-top: 4px;
        spacing: 10px;
        Text {
            text: root.help;
            color: Theme.text-muted;
            font-size: Theme.font-s;
            wrap: word-wrap;
        }
        editor := TextArea {
            height: 300px;
            label: "Shader code";
            text: root.code;
        }
        if root.error != "": Rectangle {
            border-radius: Theme.radius-s;
            background: Theme.live.with-alpha(0.12);
            height: err.preferred-height + 16px;
            err := Text {
                x: 8px;
                width: parent.width - 16px;
                text: root.error;
                color: Theme.live;
                font-size: Theme.font-s;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            Button { text: "Cancel"; kind: "ghost"; clicked => { root.dismiss(); } }
            Button { text: "Apply"; kind: "primary"; clicked => { root.apply(editor.text); } }
        }
    }
}

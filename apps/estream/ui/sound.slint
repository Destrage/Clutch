// Sound controls shared by the Stage and the Live deck: a knob per source, and a source's audio
// settings (volume, hearing it, tracks, filters).

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { MixerStrip, AudioInspect, InspectorFolds } from "types.slint";
import { Icon, IconButton, Toggle, Select, Hint, ValueSlider, FoldPanel, Segmented, FieldRow, ParamEditor } from "widgets.slint";

// A source's sound as a knob. The ring shows the volume (-60 dB to 0 dB) and the live level glows
// inside. Double-click mutes, dragging up/down or scrolling sets the volume, Ctrl+click goes back
// to 0 dB, and the name opens the sound's settings. A single click does nothing, so grabbing the
// knob to change the volume never mutes it by accident.
export component SoundKnob inherits Rectangle {
    in property <MixerStrip> strip;
    in property <length> size: 52px;
    callback fader(float);
    callback commit();
    callback toggle-mute();
    callback open-settings();

    property <float> level: root.strip.muted ? 0 : max(root.strip.level-l, root.strip.level-r);
    // Dragging: where it started, and whether the pointer moved far enough to count.
    property <float> start-fader;
    property <length> start-y;
    property <bool> dragging;
    // The release that ends a drag isn't also a click.
    property <bool> drag-ended;
    // Ctrl was held when the press began (Ctrl+click resets to 0 dB).
    property <bool> ctrl-press;
    property <bool> scrolled;
    // How far to drag for the whole range.
    property <length> travel: 160px;
    property <float> f: clamp(root.strip.fader, 0, 1);
    property <color> tone: root.strip.muted ? Theme.text-faint : root.level > 0.92 ? Theme.live : Theme.accent;

    pure function db-text() -> string {
        if (root.strip.fader <= 0.005) { return "-∞ dB"; }
        return round(root.strip.volume-db * 10) / 10 + " dB";
    }

    width: max(root.size + 20px, 76px);
    accessible-role: slider;
    accessible-label: root.strip.name + " volume";
    accessible-value: root.strip.muted ? "muted" : root.db-text();
    accessible-action-default => { root.toggle-mute(); }
    accessible-action-increment => { root.fader(min(1, root.f + 0.05)); root.commit(); }
    accessible-action-decrement => { root.fader(max(0, root.f - 0.05)); root.commit(); }

    VerticalLayout {
        spacing: 4px;
        alignment: start;
        HorizontalLayout {
            alignment: center;
            dial := Rectangle {
                width: root.size;
                height: root.size;
                // The ring: 270°, open at the bottom.
                Path {
                    width: 100%;
                    height: 100%;
                    viewbox-width: 100;
                    viewbox-height: 100;
                    commands: "M 18.9 81.1 A 44 44 0 1 1 81.1 81.1";
                    stroke: Theme.surface-3;
                    stroke-width: 4px;
                    fill: transparent;
                }
                // The volume, along the ring.
                if root.f > 0.005: Path {
                    property <angle> end: (135 + 270 * root.f) * 1deg;
                    width: 100%;
                    height: 100%;
                    viewbox-width: 100;
                    viewbox-height: 100;
                    commands: "M 18.9 81.1 A 44 44 0 " + (root.f > 2 / 3 ? 1 : 0) + " 1 " + (50 + 44 * cos(self.end)) + " " + (50 + 44 * sin(self.end));
                    stroke: root.tone;
                    stroke-width: 4px;
                    fill: transparent;
                }
                // The face, glowing with the live level.
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: parent.width - 16px;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: ta.has-hover || root.dragging ? Theme.surface-2 : Theme.surface;
                    border-width: 2px;
                    border-color: root.strip.muted ? Theme.border : root.level > 0.02 ? Theme.ok.with-alpha(0.35 + 0.65 * root.level) : Theme.border-strong;
                    drop-shadow-blur: root.level > 0.02 ? 10px * root.level : 0px;
                    drop-shadow-color: Theme.ok.with-alpha(0.5);
                    Icon {
                        source: root.strip.muted ? Icons.volume-x
                            : root.strip.kind == "audio_input" ? Icons.mic
                            : root.strip.kind == "game_capture" ? Icons.gamepad
                            : Icons.volume;
                        size: root.size * 0.36;
                        tint: root.strip.muted ? Theme.live : Theme.text;
                    }
                }
                // Something needs attention (unavailable, or heard twice).
                if root.strip.problem != "": Rectangle {
                    x: parent.width - 12px;
                    y: 2px;
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: Theme.warn;
                }
                ta := TouchArea {
                    mouse-cursor: root.dragging ? MouseCursor.ns-resize : MouseCursor.pointer;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                            root.start-fader = root.f;
                            root.start-y = self.mouse-y;
                            root.dragging = false;
                            root.drag-ended = false;
                            root.ctrl-press = e.modifiers.control;
                        } else if (e.kind == PointerEventKind.up && root.dragging) {
                            root.dragging = false;
                            root.drag-ended = true;
                            root.commit();
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            if (!root.dragging && abs(self.mouse-y - root.start-y) > 3px) {
                                root.dragging = true;
                                Hint.text = "";
                            }
                            if (root.dragging) {
                                root.fader(clamp(root.start-fader + (root.start-y - self.mouse-y) / root.travel, 0, 1));
                            }
                        }
                    }
                    clicked => {
                        if (!root.drag-ended && root.ctrl-press) {
                            root.fader(1);
                            root.commit();
                        }
                    }
                    double-clicked => {
                        if (!root.ctrl-press) {
                            root.toggle-mute();
                        }
                    }
                    scroll-event(e) => {
                        root.fader(clamp(root.f + (e.delta-y > 0 ? 0.03 : -0.03), 0, 1));
                        root.scrolled = true;
                        return EventResult.accept;
                    }
                    changed has-hover => {
                        if (self.has-hover && !root.dragging) {
                            Hint.text = root.strip.problem != "" ? root.strip.problem
                                : root.strip.name + " · " + root.db-text() + " · double-click to " + (root.strip.muted ? "unmute" : "mute") + ", drag for volume";
                            Hint.x = root.absolute-position.x + root.width / 2;
                            Hint.y = root.absolute-position.y - 28px;
                        } else {
                            Hint.text = "";
                        }
                    }
                }
            }
        }
        // The name opens the settings; while dragging it shows the volume.
        Rectangle {
            height: name.preferred-height + 4px;
            border-radius: Theme.radius-s;
            background: name-ta.has-hover ? Theme.hover : transparent;
            accessible-role: button;
            accessible-label: root.strip.name + " settings";
            accessible-action-default => { root.open-settings(); }
            name := Text {
                width: parent.width - 4px;
                text: root.dragging || root.scrolled ? root.db-text() : root.strip.name;
                color: root.strip.muted ? Theme.text-muted : Theme.text;
                font-size: Theme.font-xs;
                horizontal-alignment: center;
                overflow: elide;
            }
            name-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.open-settings(); }
            }
        }
    }

    // Scrolling ends as one undo step, shortly after the last turn.
    Timer {
        interval: 600ms;
        running: root.scrolled;
        triggered => {
            root.scrolled = false;
            root.commit();
        }
    }
}

// A source's sound settings in panels: volume and balance, who hears it, voice effects, filters,
// and the rarely changed rest under Advanced. Shared by the inspector's Sound tab and the Live
// deck; `folds` is the window's fold state.
export component AudioSettings inherits VerticalLayout {
    in property <AudioInspect> audio;
    in-out property <InspectorFolds> folds;
    callback audio-set(string, float);
    callback filter-add(int);
    callback filter-remove(string);
    callback filter-toggle(string, bool);
    callback filter-param(string, string, float);
    callback filter-move(string, bool);
    callback commit();

    property <[string]> voices: ["Off", "Deeper", "Higher", "Robot", "Radio", "Cave", "Echo"];
    property <[string]> hearing: ["Stream only", "Stream + me", "Only me"];
    // Monitoring is 0 off, 1 monitor only, 2 monitor and output; this is its place in `hearing`.
    property <int> hearing-index: root.audio.monitoring == 2 ? 1 : root.audio.monitoring == 1 ? 2 : 0;

    // The level stays readable while muted; the mute button beside it is red then.
    pure function volume-text() -> string {
        if (root.audio.volume-db <= -60) { return "-∞ dB"; }
        return (root.audio.volume-db > 0 ? "+" : "") + root.audio.volume-db.to-fixed(1) + " dB";
    }
    pure function balance-text() -> string {
        if (abs(root.audio.balance - 0.5) < 0.01) { return "Center"; }
        return root.audio.balance < 0.5 ? "L " + round((0.5 - root.audio.balance) * 200) : "R " + round((root.audio.balance - 0.5) * 200);
    }

    spacing: 8px;

    FoldPanel {
        title: "Volume";
        folded: root.folds.volume;
        note: root.folds.volume ? (root.audio.muted ? "Muted" : root.volume-text()) : "";
        toggle-fold => { root.folds.volume = !root.folds.volume; }
        if root.audio.problem != "": Rectangle {
            border-radius: Theme.radius-s;
            background: Theme.warn.with-alpha(0.12);
            height: problem-text.preferred-height + 16px;
            problem-text := Text {
                x: 8px;
                width: parent.width - 16px;
                text: root.audio.problem;
                color: Theme.text;
                font-size: Theme.font-xs;
                wrap: word-wrap;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            spacing: 6px;
            ValueSlider {
                label: "Volume";
                value: max(root.audio.volume-db, -60);
                minimum: -60;
                maximum: 26;
                step: 0.5;
                decimals: 1;
                origin: -60;
                mark: 0;
                display: root.volume-text();
                // The bottom is silence, as on the mixer fader.
                changed(v) => { root.audio-set("volume", v <= -60 ? -100 : v); }
                committed => { root.commit(); }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: root.audio.muted ? Icons.volume-x : Icons.volume;
                    tooltip: root.audio.muted ? "Unmute" : "Mute";
                    toggled: root.audio.muted;
                    tint: root.audio.muted ? Theme.live : Theme.text-muted;
                    size: 26px;
                    icon-size: 14px;
                    clicked => { root.audio-set("muted", root.audio.muted ? 0 : 1); }
                }
            }
        }
        ValueSlider {
            label: "Balance";
            value: root.audio.balance;
            minimum: 0;
            maximum: 1;
            step: 0.01;
            origin: 0.5;
            mark: 0.5;
            display: root.balance-text();
            changed(v) => { root.audio-set("balance", v); }
            committed => { root.commit(); }
        }
    }

    FoldPanel {
        title: "Who hears it";
        folded: root.folds.hearing;
        note: root.folds.hearing ? root.hearing[root.hearing-index] : "";
        toggle-fold => { root.folds.hearing = !root.folds.hearing; }
        Segmented {
            label: "Who hears it";
            options: root.hearing;
            current: root.hearing-index;
            selected(i) => { root.audio-set("monitoring", i == 1 ? 2 : i == 2 ? 1 : 0); }
        }
        Text {
            text: root.audio.monitoring == 1 ? "Only you hear this on your speakers; it isn't sent to the stream or recordings."
                : root.audio.monitoring == 2 ? "Viewers hear it, and so do you on your speakers. Headphones avoid echo."
                : "Viewers and recordings hear it; it isn't played on your speakers.";
            color: Theme.text-faint;
            font-size: Theme.font-xs;
            wrap: word-wrap;
        }
    }

    FoldPanel {
        title: "Voice";
        folded: root.folds.voice;
        note: root.folds.voice && root.audio.voice > 0 ? root.voices[root.audio.voice] : "";
        toggle-fold => { root.folds.voice = !root.folds.voice; }
        for row in [[0, 1, 2, 3], [4, 5, 6]]: HorizontalLayout {
            spacing: 6px;
            for i in row: Rectangle {
                property <bool> on: i == root.audio.voice;
                horizontal-stretch: 1;
                height: 28px;
                border-radius: Theme.radius-s;
                background: on ? Theme.accent-soft : chip-ta.has-hover ? Theme.surface-3.mix(Theme.text, 0.92) : Theme.surface-3;
                border-width: 1px;
                border-color: on ? Theme.accent : transparent;
                accessible-role: radio-button;
                accessible-label: root.voices[i] + " voice";
                accessible-checked: on;
                accessible-action-default => { root.audio-set("voice", i); }
                Text {
                    text: root.voices[i];
                    color: on ? Theme.accent-strong : Theme.text;
                    font-size: Theme.font-s;
                    font-weight: on ? 600 : 400;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                chip-ta := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.audio-set("voice", i); }
                }
            }
            // The short row's buttons stay as wide as the full row's.
            if row.length < 4: Rectangle { horizontal-stretch: 4 - row.length; }
        }
        if root.audio.voice > 0 && root.audio.monitoring == 0: Text {
            text: "To try it, choose Stream + me under Who hears it (headphones avoid feedback).";
            color: Theme.text-faint;
            font-size: Theme.font-xs;
            wrap: word-wrap;
        }
    }

    FoldPanel {
        title: "Filters";
        folded: root.folds.filters;
        note: root.audio.filters.length > 0 ? root.audio.filters.length : "";
        toggle-fold => { root.folds.filters = !root.folds.filters; }
        Select {
            label: "Add filter";
            options: ["+ Add filter…", "Noise suppression", "Noise gate", "Compressor", "Limiter", "Gain", "Pitch shift", "Robot voice", "Radio voice", "Echo", "Reverb"];
            current-index: 0;
            selected(i) => { if (i > 0) { root.filter-add(i - 1); } }
        }
        if root.audio.filters.length == 0: Text {
            text: "No filters. Noise suppression and a limiter are a good start for microphones.";
            color: Theme.text-faint;
            font-size: Theme.font-xs;
            wrap: word-wrap;
        }
        for filter in root.audio.filters: FoldPanel {
            property <bool> closed;
            sub: true;
            title: filter.name;
            folded: self.closed;
            has-switch: true;
            switch-on: filter.enabled;
            has-moves: true;
            toggle-fold => { self.closed = !self.closed; }
            switched(v) => { root.filter-toggle(filter.id, v); }
            move(up) => { root.filter-move(filter.id, up); }
            remove => { root.filter-remove(filter.id); }
            for param in filter.params: ParamEditor {
                param: param;
                changed(v) => { root.filter-param(filter.id, param.key, v); }
                committed => { root.commit(); }
            }
        }
    }

    FoldPanel {
        title: "Advanced";
        folded: root.folds.advanced;
        toggle-fold => { root.folds.advanced = !root.folds.advanced; }
        ValueSlider {
            label: "Sync offset";
            value: root.audio.sync-ms;
            minimum: 0;
            maximum: 2000;
            step: 10;
            decimals: 0;
            suffix: " ms";
            changed(v) => { root.audio-set("sync", v); }
            committed => { root.commit(); }
        }
        Text {
            text: "Delays this sound to line it up with a camera that lags behind.";
            color: Theme.text-faint;
            font-size: Theme.font-xs;
            wrap: word-wrap;
        }
        Toggle { label: "Mono"; checked: root.audio.mono; toggled(v) => { root.audio-set("mono", v ? 1 : 0); } }
        Toggle { label: "Heard in all scenes"; checked: root.audio.global; toggled(v) => { root.audio-set("global", v ? 1 : 0); } }
        FieldRow {
            label: "Tracks";
            label-width: 56px;
            for t in [0, 1, 2, 3, 4, 5]: Rectangle {
                property <bool> on: mod(floor(root.audio.tracks / pow(2, t)), 2) == 1;
                horizontal-stretch: 1;
                height: 26px;
                border-radius: Theme.radius-s;
                background: on ? Theme.accent : Theme.surface-3;
                accessible-role: checkbox;
                accessible-label: "Track " + (t + 1);
                accessible-checked: on;
                accessible-action-default => { root.audio-set("tracks", on ? root.audio.tracks - pow(2, t) : root.audio.tracks + pow(2, t)); }
                Text { text: t + 1; color: on ? Theme.on-accent : Theme.text-muted; font-size: Theme.font-s; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.audio-set("tracks", on ? root.audio.tracks - pow(2, t) : root.audio.tracks + pow(2, t)); }
                }
            }
        }
    }
}

// Design tokens. Every UI color comes from here (dark and light themes).

// Words that differ per system, set once at startup.
export global Platform {
    in property <string> trash: "Recycle Bin";
    /// Where stream keys are saved, and whether they survive a restart.
    in property <string> key-storage: "Stored encrypted for your Windows account";
    in property <bool> key-remembered: true;
    /// Set when hotkeys work only while Clutch is in front.
    in property <string> hotkeys-note;
    /// Set when the "window focused" trigger can't work on this system.
    in property <string> focus-note;
    /// The virtual camera has a component to install (Windows).
    in property <bool> vcam-installable: true;
}

export global Theme {
    in-out property <bool> dark: true;
    in-out property <color> accent: #8ec5ff;

    // Surfaces, from the window background up to raised controls.
    out property <color> bg: dark ? #0f141a : #eef1f4;
    out property <color> surface: dark ? #161d25 : #ffffff;
    out property <color> surface-2: dark ? #1e2731 : #f5f7f9;
    out property <color> surface-3: dark ? #26313d : #e6ebf0;
    out property <color> border: dark ? #232d38 : #d9e0e7;
    out property <color> border-strong: dark ? #34414f : #c3cdd7;
    out property <color> canvas-bg: dark ? #0a0e12 : #d3dae1;

    // Every text color reaches 4.5:1 contrast on every surface of its theme (checked by a
    // test in the app crate, theme_contrast.rs).
    out property <color> text: dark ? #f3f6f9 : #0d1218;
    out property <color> text-muted: dark ? #b4c0cc : #3d4955;
    out property <color> text-faint: dark ? #8a9aac : #5f6b79;
    // In the dark theme accents are light (ice blue by default), so text on them is dark; the
    // light theme gets a deeper shade of the accent (see apply_theme) with white text.
    out property <color> on-accent: dark ? #0f141a : #ffffff;

    out property <color> accent-soft: accent.with-alpha(dark ? 0.16 : 0.13);
    out property <color> accent-strong: dark ? accent.brighter(0.15) : accent.darker(0.1);
    out property <color> hover: dark ? #ffffff0c : #00000009;
    out property <color> pressed: dark ? #ffffff16 : #00000012;
    out property <color> live: #ff5a6a;
    out property <color> live-soft: live.with-alpha(0.16);
    out property <color> warn: #f2b84b;
    out property <color> ok: #4ad69a;
    out property <color> scrim: dark ? #000000a6 : #10131a66;

    out property <length> radius-s: 8px;
    out property <length> radius-m: 10px;
    out property <length> radius-l: 14px;

    /// Settings → Appearance → Text size: every font size below is multiplied by it.
    in-out property <float> text-scale: 1.0;
    /// Fixed heights of controls that hold text are multiplied by this, so Large and Larger
    /// text isn't cut off (Small keeps the Default sizes).
    out property <float> grow: max(1.0, text-scale);
    /// Small badges (LIVE, counts).
    out property <length> font-2xs: 10px * text-scale;
    out property <length> font-xs: 12px * text-scale;
    out property <length> font-s: 12px * text-scale;
    out property <length> font-m: 13px * text-scale;
    out property <length> font-l: 15px * text-scale;
    /// The CLUTCH wordmark in the title bar.
    out property <length> font-brand: 17px * text-scale;
    out property <length> font-xl: 20px * text-scale;
    /// Dialog and page headings.
    out property <length> font-2xl: 24px * text-scale;
    out property <length> font-3xl: 28px * text-scale;
    out property <string> font-family: "Figtree";
    /// Headings and the brand (Jost, like the Clutch wordmark).
    out property <string> font-display: "Jost";
}

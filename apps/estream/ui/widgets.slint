// Clutch component library. All colors and sizes come from Theme.

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { FilterParamRow } from "types.slint";

// Shared tooltip state, rendered once at the window root (see TooltipLayer).
export global Hint {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <bool> below: true;
}

export component Icon inherits Image {
    in property <color> tint: Theme.text-muted;
    in property <length> size: 16px;
    width: size;
    height: size;
    colorize: tint;
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    // "default" | "primary" | "ghost" | "danger" | "live"
    in property <string> kind: "default";
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <string> tooltip;
    callback clicked;

    property <color> fg: !enabled ? Theme.text-faint
        : kind == "primary" || kind == "live" ? Theme.on-accent
        : kind == "danger" ? Theme.live
        : Theme.text;
    property <color> base: kind == "primary" ? Theme.accent
        : kind == "live" ? (active ? Theme.live : Theme.live.with-alpha(0.85))
        : kind == "ghost" ? transparent
        : Theme.surface-3;

    height: 30px;
    min-width: content.min-width;
    border-radius: Theme.radius-s;
    background: !enabled ? (kind == "ghost" ? transparent : Theme.surface-2)
        : ta.pressed ? base.mix(Theme.text, 0.82)
        : ta.has-hover ? (kind == "ghost" ? Theme.hover : base.mix(Theme.text, 0.9))
        : base;
    opacity: enabled ? 1 : 0.7;
    accessible-role: button;
    accessible-label: text != "" ? text : tooltip;
    accessible-enabled: enabled;
    accessible-action-default => { if (enabled) { root.clicked(); } }

    content := HorizontalLayout {
        padding-left: text != "" ? 12px : 7px;
        padding-right: text != "" ? 12px : 7px;
        spacing: 6px;
        alignment: center;
        if has-icon: VerticalLayout {
            alignment: center;
            Icon { source: root.icon; tint: root.fg; size: 15px; }
        }
        if text != "": Text {
            text: root.text;
            color: root.fg;
            font-size: Theme.font-m;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    // Keep a visible tooltip in sync when the label changes while hovered.
    changed tooltip => {
        if (ta.has-hover && root.tooltip != "") {
            Hint.text = root.tooltip;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
        changed has-hover => {
            if (self.has-hover && root.tooltip != "") {
                Hint.text = root.tooltip;
                Hint.x = root.absolute-position.x + root.width / 2;
                Hint.y = root.absolute-position.y + root.height + 6px;
            } else if (Hint.text == root.tooltip) {
                Hint.text = "";
            }
        }
    }
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> tooltip;
    in property <bool> toggled: false;
    in property <bool> enabled: true;
    in property <length> size: 28px;
    in property <length> icon-size: 16px;
    in property <color> tint: toggled ? Theme.accent : Theme.text-muted;
    callback clicked;

    width: size;
    height: size;
    border-radius: Theme.radius-s;
    background: ta.pressed ? Theme.pressed : ta.has-hover || toggled ? Theme.hover : transparent;
    opacity: enabled ? 1 : 0.4;
    accessible-role: button;
    accessible-label: tooltip;
    accessible-enabled: enabled;
    accessible-action-default => { if (enabled) { root.clicked(); } }

    changed tooltip => {
        if (ta.has-hover && root.tooltip != "") {
            Hint.text = root.tooltip;
        }
    }

    Icon {
        source: root.icon;
        size: root.icon-size;
        tint: ta.has-hover && root.enabled ? Theme.text : root.tint;
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
        changed has-hover => {
            if (self.has-hover && root.tooltip != "") {
                Hint.text = root.tooltip;
                Hint.x = root.absolute-position.x + root.width / 2;
                Hint.y = root.absolute-position.y + root.height + 6px;
            } else if (Hint.text == root.tooltip) {
                Hint.text = "";
            }
        }
    }
}

// Renders the shared tooltip. Place once, last, at the window root.
export component TooltipLayer inherits Rectangle {
    if Hint.text != "": Rectangle {
        property <length> w: label.preferred-width + 16px;
        x: max(4px, min(parent.width - self.width - 4px, Hint.x - self.width / 2));
        y: Hint.y;
        width: w;
        height: 24px;
        border-radius: Theme.radius-s;
        background: Theme.dark ? #2b303b : #1d2129;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000050;
        label := Text {
            text: Hint.text;
            color: #f1f3f7;
            font-size: Theme.font-s;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component TextField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <InputType> input-type: InputType.text;
    in property <bool> enabled: true;
    in property <string> label;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback accepted(string);
    forward-focus: input;

    height: 28px;
    clip: true;
    // Size by layout, not by text, so long values (paths) scroll inside the field.
    preferred-width: 160px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-s;
    background: Theme.surface-2;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : ta.has-hover ? Theme.border-strong : Theme.border;
    accessible-role: text-input;
    accessible-label: label != "" ? label : placeholder;

    ta := TouchArea { mouse-cursor: MouseCursor.text; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        input := TextInput {
            min-width: 0px;
            horizontal-stretch: 1;
            enabled: root.enabled;
            input-type: root.input-type;
            single-line: true;
            vertical-alignment: center;
            color: Theme.text;
            font-size: Theme.font-m;
            selection-background-color: Theme.accent.with-alpha(0.35);
            selection-foreground-color: Theme.text;
            edited => { root.edited(self.text); }
            accepted => { root.accepted(self.text); }
        }
    }

    if root.text == "" && !input.has-focus: Text {
        x: 8px;
        text: root.placeholder;
        color: Theme.text-faint;
        font-size: Theme.font-m;
        vertical-alignment: center;
        height: parent.height;
    }
}

// Multi-line text input.
export component TextArea inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> label;
    callback edited(string);

    height: max(64px, input.preferred-height + 16px);
    border-radius: Theme.radius-s;
    background: Theme.surface-2;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    accessible-role: text-input;
    accessible-label: label;
    TouchArea { mouse-cursor: MouseCursor.text; clicked => { input.focus(); } }
    input := TextInput {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        single-line: false;
        wrap: word-wrap;
        color: Theme.text;
        font-size: Theme.font-m;
        selection-background-color: Theme.accent.with-alpha(0.35);
        edited => { root.edited(self.text); }
    }
}

// A numeric field whose label can be dragged horizontally to scrub the value.
export component NumberField inherits Rectangle {
    in property <string> label;
    in property <float> value;
    in property <float> step: 1;
    in property <int> decimals: 0;
    in property <float> minimum: -1000000;
    in property <float> maximum: 1000000;
    in property <string> suffix;
    in property <bool> enabled: true;
    callback changed(float);
    callback committed();

    property <float> scrub-start;
    height: 28px;
    min-width: 64px;
    border-radius: Theme.radius-s;
    background: Theme.surface-2;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    opacity: enabled ? 1 : 0.5;
    accessible-role: spinbox;
    accessible-label: label;
    accessible-value: value.to-fixed(decimals);
    accessible-action-increment => { root.changed(min(root.maximum, root.value + root.step)); }
    accessible-action-decrement => { root.changed(max(root.minimum, root.value - root.step)); }

    function show-value() {
        input.text = root.value.to-fixed(root.decimals);
    }
    init => { show-value(); }
    changed value => { if (!input.has-focus) { show-value(); } }

    HorizontalLayout {
        Rectangle {
            width: 24px;
            Text {
                text: root.label;
                color: scrub.has-hover || scrub.pressed ? Theme.accent : Theme.text-faint;
                font-size: Theme.font-xs;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            scrub := TouchArea {
                enabled: root.enabled;
                mouse-cursor: MouseCursor.ew-resize;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.scrub-start = root.value;
                    } else if (e.kind == PointerEventKind.up) {
                        root.committed();
                    }
                }
                moved => {
                    if (self.pressed) {
                        root.changed(clamp(
                            root.scrub-start + round((self.mouse-x - self.pressed-x) / 2px) * root.step,
                            root.minimum, root.maximum));
                    }
                }
            }
        }
        input := TextInput {
            enabled: root.enabled;
            single-line: true;
            vertical-alignment: center;
            color: Theme.text;
            font-size: Theme.font-m;
            selection-background-color: Theme.accent.with-alpha(0.35);
            accepted => {
                if (self.text.is-float()) {
                    root.changed(clamp(self.text.to-float(), root.minimum, root.maximum));
                    root.committed();
                }
                root.show-value();
            }
            changed has-focus => {
                if (!self.has-focus) {
                    if (self.text.is-float() && self.text.to-float() != root.value) {
                        root.changed(clamp(self.text.to-float(), root.minimum, root.maximum));
                        root.committed();
                    }
                    root.show-value();
                }
            }
        }
        if root.suffix != "": Text {
            text: root.suffix;
            color: Theme.text-faint;
            font-size: Theme.font-xs;
            vertical-alignment: center;
        }
        Rectangle { width: 6px; }
    }
}

export component Toggle inherits Rectangle {
    in property <bool> checked;
    in property <string> label;
    in property <bool> enabled: true;
    callback toggled(bool);

    height: 24px;
    min-width: layout.min-width;
    accessible-role: switch;
    accessible-label: label;
    accessible-checked: checked;
    accessible-action-default => { root.toggled(!root.checked); }

    layout := HorizontalLayout {
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 32px;
                height: 18px;
                border-radius: 9px;
                background: root.checked ? Theme.accent : Theme.surface-3;
                border-width: root.checked ? 0px : 1px;
                border-color: Theme.border-strong;
                animate background { duration: 120ms; }
                Rectangle {
                    x: root.checked ? parent.width - self.width - 3px : 3px;
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    background: root.checked ? Theme.on-accent : Theme.text-muted;
                    animate x { duration: 120ms; easing: ease-out; }
                }
            }
        }
        if root.label != "": Text {
            text: root.label;
            color: Theme.text;
            font-size: Theme.font-m;
            vertical-alignment: center;
        }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.toggled(!root.checked); }
    }
}

export component Slider inherits Rectangle {
    in property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <string> label;
    callback changed(float);
    callback committed();

    property <float> ratio: (value - minimum) / (maximum - minimum);
    height: 20px;
    accessible-role: slider;
    accessible-label: label;
    accessible-value: value;
    accessible-value-minimum: minimum;
    accessible-value-maximum: maximum;

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.surface-3;
        Rectangle {
            x: 0;
            width: parent.width * root.ratio;
            border-radius: 2px;
            background: Theme.accent;
        }
    }
    Rectangle {
        x: (parent.width - self.width) * root.ratio;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: #ffffff;
        border-width: 2px;
        border-color: Theme.accent;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000040;
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        function set(x: length) {
            root.changed(root.minimum + clamp(x / root.width, 0, 1) * (root.maximum - root.minimum));
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                self.set(self.mouse-x);
            } else if (e.kind == PointerEventKind.up) {
                root.committed();
            }
        }
        moved => { if (self.pressed) { self.set(self.mouse-x); } }
    }
}

// A bounded number as a bar: the name on the left, the value on the right, filled up to the
// value. Dragging moves the value with the pointer (Shift is ten times finer) without jumping
// to where the press landed, a click without dragging types an exact value, and arrow keys
// step it.
export component ValueSlider inherits Rectangle {
    in property <string> label;
    in property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <float> step: 0.01;
    in property <int> decimals: 2;
    in property <string> suffix;
    /// Shown instead of the number ("" = the number and suffix).
    in property <string> display;
    /// Where the fill starts: zero for ranges that cross it, else the bottom.
    in property <float> origin: minimum < 0 && maximum > 0 ? 0 : minimum;
    /// A tick at this value (0 dB on a volume); outside the range for none.
    in property <float> mark: minimum - 1;
    in property <bool> enabled: true;
    callback changed(float);
    callback committed();

    property <float> span: max(root.maximum - root.minimum, 0.000001);
    property <float> ratio: clamp((root.value - root.minimum) / root.span, 0, 1);
    property <float> origin-ratio: clamp((root.origin - root.minimum) / root.span, 0, 1);
    property <bool> editing;
    property <bool> dragging;
    // Unsnapped value while dragging, and the pointer's last x.
    property <float> drag-value;
    property <length> last-x;

    pure function snap(v: float) -> float {
        return clamp(root.minimum + round((v - root.minimum) / root.step) * root.step, root.minimum, root.maximum);
    }
    pure function value-text() -> string {
        return root.display != "" ? root.display : root.value.to-fixed(root.decimals) + root.suffix;
    }
    function nudge(steps: float) {
        root.changed(root.snap(root.value + steps * root.step));
        root.committed();
    }

    height: 26px;
    min-width: 80px;
    horizontal-stretch: 1;
    clip: true;
    border-radius: Theme.radius-s;
    background: Theme.surface-2;
    border-width: 1px;
    border-color: keys.has-focus || root.editing ? Theme.accent : ta.has-hover ? Theme.border-strong : Theme.border;
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-value: root.value-text();
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-action-increment => { root.nudge(1); }
    accessible-action-decrement => { root.nudge(-1); }

    // The fill, from the origin to the value.
    Rectangle {
        x: parent.width * min(root.origin-ratio, root.ratio);
        width: parent.width * abs(root.ratio - root.origin-ratio);
        background: Theme.accent.with-alpha(ta.has-hover || root.dragging ? 0.34 : 0.26);
    }
    if root.mark >= root.minimum && root.mark <= root.maximum: Rectangle {
        x: parent.width * (root.mark - root.minimum) / root.span - 1px;
        y: 5px;
        width: 2px;
        height: parent.height - 10px;
        background: Theme.text-faint.with-alpha(0.6);
    }
    if !root.editing: HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 8px;
        Text {
            text: root.label;
            color: Theme.text-muted;
            font-size: Theme.font-s;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: root.value-text();
            color: Theme.text;
            font-size: Theme.font-s;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    keys := FocusScope {
        enabled: root.enabled && !root.editing;
        key-pressed(e) => {
            let n = e.modifiers.shift ? 10 : 1;
            if (e.text == Key.LeftArrow || e.text == Key.DownArrow) {
                root.nudge(-n);
                return accept;
            }
            if (e.text == Key.RightArrow || e.text == Key.UpArrow) {
                root.nudge(n);
                return accept;
            }
            if (e.text == Key.Return) {
                root.editing = true;
                return accept;
            }
            reject
        }
    }
    ta := TouchArea {
        enabled: root.enabled && !root.editing;
        mouse-cursor: MouseCursor.ew-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.dragging = false;
                root.drag-value = root.value;
                root.last-x = self.mouse-x;
            } else if (e.kind == PointerEventKind.move && self.pressed) {
                if (!root.dragging && abs(self.mouse-x - self.pressed-x) > 3px) {
                    root.dragging = true;
                    root.last-x = self.mouse-x;
                }
                if (root.dragging) {
                    root.drag-value += (self.mouse-x - root.last-x) / max(root.width, 1px) * root.span * (e.modifiers.shift ? 0.1 : 1);
                    root.drag-value = clamp(root.drag-value, root.minimum, root.maximum);
                    root.last-x = self.mouse-x;
                    root.changed(root.snap(root.drag-value));
                }
            } else if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left) {
                if (root.dragging) {
                    root.dragging = false;
                    root.committed();
                } else {
                    root.editing = true;
                }
            }
        }
    }
    if root.editing: FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.editing = false;
                return accept;
            }
            reject
        }
        input := TextInput {
            x: 9px;
            width: parent.width - 18px;
            single-line: true;
            vertical-alignment: center;
            color: Theme.text;
            font-size: Theme.font-s;
            selection-background-color: Theme.accent.with-alpha(0.35);
            selection-foreground-color: Theme.text;
            text: root.value.to-fixed(root.decimals);
            init => {
                self.focus();
                self.select-all();
            }
            accepted => {
                if (self.text.is-float()) {
                    root.changed(clamp(self.text.to-float(), root.minimum, root.maximum));
                    root.committed();
                }
                root.editing = false;
            }
            changed has-focus => {
                if (!self.has-focus && root.editing) {
                    if (self.text.is-float() && self.text.to-float() != root.value) {
                        root.changed(clamp(self.text.to-float(), root.minimum, root.maximum));
                        root.committed();
                    }
                    root.editing = false;
                }
            }
        }
    }
}

// A group of settings under a header that folds it, like Blender's panels. A `sub` panel sits
// inside another panel with a lighter header. The header can carry a switch (a filter's on/off),
// one action button, and move/remove buttons.
export component FoldPanel inherits Rectangle {
    in property <string> title;
    /// Folded state belongs to the caller, which flips it on `toggle-fold`.
    in property <bool> folded;
    in property <bool> sub;
    /// Muted text on the right of the header.
    in property <string> note;
    in property <bool> has-switch;
    in property <bool> switch-on;
    in property <image> action-icon;
    in property <string> action-tooltip;
    in property <bool> has-action;
    in property <bool> has-moves;
    callback toggle-fold();
    callback switched(bool);
    callback action();
    callback move(bool);
    callback remove();

    height: col.preferred-height;
    border-radius: root.sub ? Theme.radius-s : Theme.radius-m;
    background: root.sub ? Theme.surface : Theme.surface-2;
    border-width: 1px;
    border-color: Theme.border;

    col := VerticalLayout {
        Rectangle {
            height: root.sub ? 30px : 34px;
            border-radius: root.border-radius;
            background: head-ta.has-hover ? Theme.hover : transparent;
            accessible-role: button;
            accessible-label: root.title;
            accessible-expandable: true;
            accessible-expanded: !root.folded;
            accessible-action-default => { root.toggle-fold(); }
            head-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.toggle-fold(); }
            }
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        source: Icons.chevron-down;
                        size: 13px;
                        tint: Theme.text-faint;
                        transform-rotation: root.folded ? -90deg : 0deg;
                        animate transform-rotation { duration: 120ms; easing: ease-out; }
                    }
                }
                if root.has-switch: VerticalLayout {
                    alignment: center;
                    Toggle {
                        label: "";
                        accessible-label: root.title + " on";
                        checked: root.switch-on;
                        toggled(v) => { root.switched(v); }
                    }
                }
                Text {
                    text: root.title;
                    color: root.has-switch && !root.switch-on ? Theme.text-faint : Theme.text;
                    font-size: root.sub ? Theme.font-s : Theme.font-m;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if root.note != "": Text {
                    text: root.note;
                    color: Theme.text-faint;
                    font-size: Theme.font-xs;
                    vertical-alignment: center;
                }
                if root.has-action: VerticalLayout {
                    alignment: center;
                    IconButton { icon: root.action-icon; tooltip: root.action-tooltip; size: 24px; icon-size: 13px; clicked => { root.action(); } }
                }
                if root.has-moves: HorizontalLayout {
                    VerticalLayout {
                        alignment: center;
                        IconButton { icon: Icons.chevron-up; tooltip: "Move up"; size: 22px; icon-size: 12px; clicked => { root.move(true); } }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton { icon: Icons.chevron-down; tooltip: "Move down"; size: 22px; icon-size: 12px; clicked => { root.move(false); } }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton { icon: Icons.trash; tooltip: "Remove"; size: 22px; icon-size: 12px; clicked => { root.remove(); } }
                    }
                }
            }
        }
        Rectangle {
            height: root.folded ? 0px : body.preferred-height;
            clip: true;
            animate height { duration: 140ms; easing: ease-out; }
            body := VerticalLayout {
                y: 0;
                height: self.preferred-height;
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 2px;
                padding-bottom: 10px;
                spacing: 8px;
                @children
            }
        }
    }
}

// A choice of two to four options shown side by side.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> current;
    in property <string> label;
    callback selected(int);

    height: 28px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-s;
    background: Theme.surface-3;
    accessible-role: radio-group;
    accessible-label: root.label;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for option[i] in root.options: Rectangle {
            horizontal-stretch: 1;
            min-width: 0px;
            border-radius: Theme.radius-s - 2px;
            background: i == root.current ? Theme.surface : seg-ta.has-hover ? Theme.hover : transparent;
            drop-shadow-blur: i == root.current ? 3px : 0px;
            drop-shadow-color: #00000030;
            accessible-role: radio-button;
            accessible-label: option;
            accessible-checked: i == root.current;
            accessible-action-default => { root.selected(i); }
            Text {
                width: parent.width - 8px;
                text: option;
                color: i == root.current ? Theme.text : Theme.text-muted;
                font-size: Theme.font-s;
                font-weight: i == root.current ? 600 : 400;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
            seg-ta := TouchArea {
                mouse-cursor: MouseCursor.pointer;
                clicked => { root.selected(i); }
            }
        }
    }
}

export component Select inherits Rectangle {
    in property <[string]> options;
    in property <int> current-index;
    in property <string> label;
    callback selected(int);

    height: 28px;
    border-radius: Theme.radius-s;
    background: ta.has-hover ? Theme.surface-3 : Theme.surface-2;
    border-width: 1px;
    border-color: Theme.border;
    accessible-role: combobox;
    accessible-label: label;
    accessible-value: current-index >= 0 && current-index < options.length ? options[current-index] : "";

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        Text {
            text: root.current-index >= 0 && root.current-index < root.options.length ? root.options[root.current-index] : "";
            color: Theme.text;
            font-size: Theme.font-m;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Icon { source: Icons.chevron-down; size: 14px; }
        }
    }
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: max(root.width, 220px);
        height: min(root.options.length * 28px + 8px, 320px);
        Rectangle {
            background: Theme.surface-3;
            border-radius: Theme.radius-m;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000060;
            Flickable {
              content-height: option-list.preferred-height;
              option-list := VerticalLayout {
                padding: 4px;
                for option[i] in root.options: Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-s;
                    background: item-ta.has-hover ? Theme.hover : i == root.current-index ? Theme.accent-soft : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        Text {
                            text: option;
                            color: Theme.text;
                            font-size: Theme.font-m;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    item-ta := TouchArea {
                        clicked => { root.selected(i); }
                    }
                }
              }
            }
        }
    }
}

// Card-style panel container. Put a PanelHeader as the first child.
export component Panel inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius-l;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;
    VerticalLayout {
        @children
    }
}

export component PanelHeader inherits Rectangle {
    in property <string> title;
    in property <image> icon;
    height: 40px;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        spacing: 2px;
        VerticalLayout {
            alignment: center;
            Icon { source: root.icon; size: 14px; tint: Theme.text-faint; }
        }
        Rectangle { width: 6px; }
        Text {
            text: root.title;
            color: Theme.text-muted;
            font-size: Theme.font-s;
            font-weight: 650;
            letter-spacing: 0.3px;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        @children
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}

export component SectionTitle inherits Text {
    color: Theme.text-faint;
    font-size: Theme.font-xs;
    font-weight: 700;
    letter-spacing: 0.6px;
}

// Draggable separator between panels. `vertical` = a vertical bar that resizes widths.
component Splitter inherits Rectangle {
    in property <bool> vertical: true;
    in-out property <length> size;
    in property <length> minimum: 120px;
    in property <length> maximum: 900px;
    // When true, dragging towards the start grows the panel (panel is after the splitter).
    in property <bool> invert: false;
    callback released();

    property <length> start;

    Rectangle {
        x: vertical ? (parent.width - self.width) / 2 : 0;
        y: vertical ? 0 : (parent.height - self.height) / 2;
        width: vertical ? 2px : parent.width;
        height: vertical ? parent.height : 2px;
        border-radius: 1px;
        background: ta.has-hover || ta.pressed ? Theme.accent.with-alpha(0.6) : transparent;
    }
    ta := TouchArea {
        mouse-cursor: root.vertical ? MouseCursor.col-resize : MouseCursor.row-resize;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.start = root.size;
            } else if (e.kind == PointerEventKind.up) {
                root.released();
            }
        }
        moved => {
            if (self.pressed) {
                let delta = root.vertical ? self.mouse-x - self.pressed-x : self.mouse-y - self.pressed-y;
                root.size = clamp(root.start + (root.invert ? -delta : delta), root.minimum, root.maximum);
            }
        }
    }
}

export component VSplitter inherits Splitter {
    vertical: true;
    width: 8px;
}

export component HSplitter inherits Splitter {
    vertical: false;
    height: 8px;
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.text-muted;
    height: 18px;
    width: label.preferred-width + 12px;
    border-radius: 9px;
    background: tone.with-alpha(0.14);
    label := Text {
        text: root.text;
        color: root.tone;
        font-size: Theme.font-xs;
        font-weight: 650;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component EmptyState inherits VerticalLayout {
    in property <image> icon;
    in property <string> title;
    in property <string> body;
    alignment: center;
    spacing: 8px;
    padding: 16px;
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 40px;
            height: 40px;
            border-radius: 20px;
            background: Theme.surface-3;
            Icon { source: root.icon; size: 18px; tint: Theme.text-muted; }
        }
    }
    Text {
        text: root.title;
        color: Theme.text;
        font-size: Theme.font-m;
        font-weight: 600;
        horizontal-alignment: center;
    }
    Text {
        text: root.body;
        color: Theme.text-muted;
        font-size: Theme.font-s;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    @children
}

// A setting's name on the left and its control on the right.
export component FieldRow inherits HorizontalLayout {
    in property <string> label;
    in property <length> label-width: 84px;
    spacing: 8px;
    Text {
        width: root.label-width;
        text: root.label;
        color: Theme.text-muted;
        font-size: Theme.font-s;
        vertical-alignment: center;
        wrap: word-wrap;
    }
    @children
}

// One audio or video filter parameter, as the control that suits it: a segmented choice or a
// dropdown for named options, a switch for on/off, a slider for a range that can be dragged
// precisely, and a number field otherwise.
export component ParamEditor inherits VerticalLayout {
    in property <FilterParamRow> param;
    callback changed(float);
    callback committed();

    property <bool> choice: root.param.choices.length > 0;
    property <bool> switch: !root.choice && root.param.minimum == 0 && root.param.maximum == 1 && root.param.step == 1;
    property <bool> slider: !root.choice && !root.switch && root.param.step > 0
        && (root.param.maximum - root.param.minimum) / root.param.step <= 1000;
    property <int> decimals: root.param.step < 0.1 ? 2 : root.param.step < 1 ? 1 : 0;
    // Units that read as words get a space ("-26 dB"); symbols don't ("100%", "4.0:1").
    property <string> unit: root.param.unit == "dB" || root.param.unit == "ms" || root.param.unit == "Hz" || root.param.unit == "px" ? " " + root.param.unit : root.param.unit;

    spacing: 4px;
    if root.choice && root.param.choices.length <= 3: FieldRow {
        label: root.param.label;
        Segmented {
            label: root.param.label;
            options: root.param.choices;
            current: root.param.value;
            selected(i) => {
                root.changed(i);
                root.committed();
            }
        }
    }
    if root.choice && root.param.choices.length > 3: FieldRow {
        label: root.param.label;
        Select {
            label: root.param.label;
            options: root.param.choices;
            current-index: root.param.value;
            selected(i) => {
                root.changed(i);
                root.committed();
            }
        }
    }
    if root.switch: Toggle {
        label: root.param.label;
        checked: root.param.value > 0.5;
        toggled(v) => {
            root.changed(v ? 1 : 0);
            root.committed();
        }
    }
    if root.slider: ValueSlider {
        label: root.param.label;
        value: root.param.value;
        minimum: root.param.minimum;
        maximum: root.param.maximum;
        step: root.param.step;
        decimals: root.decimals;
        suffix: root.unit;
        changed(v) => { root.changed(v); }
        committed => { root.committed(); }
    }
    if !root.choice && !root.switch && !root.slider: FieldRow {
        label: root.param.label;
        NumberField {
            label: "";
            value: root.param.value;
            minimum: root.param.minimum;
            maximum: root.param.maximum;
            step: root.param.step;
            decimals: root.decimals;
            suffix: root.param.unit;
            changed(v) => { root.changed(v); }
            committed => { root.committed(); }
        }
    }
    if root.param.note != "": Text {
        text: root.param.note;
        color: Theme.text-faint;
        font-size: Theme.font-xs;
        wrap: word-wrap;
    }
}

// Data passed between Rust and the UI.

/// A canvas tab above the preview.
export struct CanvasTab {
    id: string,
    name: string,
    /// e.g. "1080 × 1920 · 30 fps"
    info: string,
    active: bool,
}

export struct SceneRow {
    id: string,
    name: string,
    /// Being edited (the Preview scene in studio mode, else the program scene).
    active: bool,
    /// On program (shown separately in studio mode).
    live: bool,
    items: int,
}

export struct LayerRow {
    id: string,
    name: string,
    // "color" | "test_pattern" | "group" | other source kind
    kind: string,
    visible: bool,
    locked: bool,
    depth: int,
    group: bool,
    selected: bool,
    // Empty when the source is active; otherwise a human-readable problem.
    problem: string,
}

// Selection or hover box in canvas pixels (rotated around its center).
export struct CanvasBox {
    visible: bool,
    cx: float,
    cy: float,
    w: float,
    h: float,
    rotation: float,
    handles: bool,
    locked: bool,
}

export struct Guide {
    vertical: bool,
    pos: float,
}

export struct Inspect {
    has: bool,
    id: string,
    name: string,
    kind: string,
    kind-label: string,
    group: bool,
    problem: string,
    x: float,
    y: float,
    w: float,
    h: float,
    rotation: float,
    // 0 free scale, 1 stretch, 2 fit, 3 fill
    size-mode: int,
    crop-l: float,
    crop-t: float,
    crop-r: float,
    crop-b: float,
    opacity: float,
    // 0 normal, 1 additive, 2 multiply, 3 screen
    blend: int,
    visible: bool,
    locked: bool,
    // Audio-only sources (no transform/crop/appearance).
    no-video: bool,
}

export struct PaletteEntry {
    id: string,
    title: string,
    category: string,
    hint: string,
}

export struct Preset {
    label: string,
    detail: string,
}

export struct SourceType {
    kind: string,
    title: string,
    description: string,
    available: bool,
}

// One editable source setting, rendered generically by the inspector.
export struct PropRow {
    key: string,
    label: string,
    hint: string,
    // "bool" | "int" | "float" | "text" | "multiline" | "color" | "path" | "select"
    kind: string,
    flag: bool,
    number: float,
    minimum: float,
    maximum: float,
    step: float,
    decimals: int,
    text: string,
    color: color,
    options: [string],
    index: int,
}
export struct MixerStrip {
    id: string,
    name: string,
    kind: string,
    // Meter positions 0..1 on a -60..0 dB scale.
    level-l: float,
    level-r: float,
    rms-l: float,
    rms-r: float,
    hold-l: float,
    hold-r: float,
    // Fader position 0..1 and its value in dB.
    fader: float,
    volume-db: float,
    muted: bool,
    monitoring: bool,
    global: bool,
    selected: bool,
    problem: string,
}

export struct FilterParamRow {
    key: string,
    label: string,
    value: float,
    minimum: float,
    maximum: float,
    step: float,
    unit: string,
}

/// Playback state of a selected media source.
export struct MediaInspect {
    has: bool,
    item: string,
    /// "1 / 3" for playlists, "" for one file.
    index: string,
    time: string,
    /// 0..1 (0 if the duration is unknown).
    progress: float,
    paused: bool,
    ended: bool,
}

/// A video filter in the inspector.
export struct VideoFilterRow {
    id: string,
    name: string,
    enabled: bool,
    params: [FilterParamRow],
    /// Label of the file it needs ("" if none) and the chosen file's name.
    file-label: string,
    file: string,
    /// Takes WGSL code (custom shader).
    code: bool,
}

export struct FilterRow {
    id: string,
    name: string,
    enabled: bool,
    params: [FilterParamRow],
}

export struct AudioInspect {
    has: bool,
    volume-db: float,
    muted: bool,
    balance: float,
    mono: bool,
    sync-ms: float,
    // 0 off, 1 monitor only, 2 monitor and output
    monitoring: int,
    tracks: int,
    global: bool,
    filters: [FilterRow],
}
// Recording & app settings shown in the Settings dialog.
/// A streaming destination in Settings.
export struct DestinationRow {
    name: string,
    enabled: bool,
    /// e.g. "RTMPS", "SRT"; "" if the server is not set or not recognized.
    protocol: string,
}

/// A destination in the live panel.
export struct LiveRow {
    name: string,
    /// 0 off, 1 connecting, 2 live, 3 reconnecting, 4 failed
    state: int,
    /// Bitrate and drops, or the error / what is happening.
    info: string,
    /// 1 good, 2 congested / connecting, 3 failing
    health: int,
}

export struct SettingsForm {
    folder: string,
    filename: string,
    container: int,
    codec: int,
    encoders: [string],
    encoder: int,
    rate-control: int,
    bitrate: float,
    quality: float,
    keyframe: float,
    preset: int,
    audio-codec: int,
    audio-bitrate: float,
    tracks: int,
    replay-seconds: float,
    auto-remux: bool,
    /// Canvas names (current collection), for the recording and destination pickers.
    canvas-names: [string],
    /// Recording canvas index; `canvas-names.length` means all canvases.
    rec-canvas: int,
    /// `canvas-names` plus "All canvases".
    rec-canvas-names: [string],
    dest-canvas: int,
    theme: int,
    ffmpeg: string,
    // Streaming: destination list, then the editor for the selected one
    destinations: [DestinationRow],
    dest-selected: int,
    dest-name: string,
    stream-services: [string],
    stream-service: int,
    stream-server: string,
    stream-key-set: bool,
    /// Detected transport, e.g. "RTMPS", or "" if the server is not recognized.
    stream-protocol: string,
    /// Problem to fix before going live, or a bitrate warning ("" if none).
    stream-warning: string,
    stream-codec: int,
    stream-encoders: [string],
    stream-encoder: int,
    stream-bitrate: float,
    stream-audio-bitrate: float,
    stream-track: int,
    stream-reconnect: bool,
    // Remote control (obs-websocket)
    remote-enabled: bool,
    remote-port: float,
    remote-auth: bool,
    remote-password: string,
    // Virtual camera
    vcam-canvas: int,
    vcam-status: string,
    vcam-installed: bool,
}

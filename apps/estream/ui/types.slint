// Data passed between Rust and the UI.

/// A canvas tab above the preview.
export struct CanvasTab {
    id: string,
    name: string,
    /// e.g. "1080 × 1920 · 30 fps"
    info: string,
    active: bool,
}

export struct SceneRow {
    id: string,
    name: string,
    /// The last picture seen of the scene (empty until it has been shown).
    thumb: image,
    /// Being edited (the Preview scene in studio mode, else the program scene).
    active: bool,
    /// On program (shown separately in studio mode).
    live: bool,
    items: int,
}

export struct LayerRow {
    id: string,
    name: string,
    // "color" | "test_pattern" | "group" | other source kind
    kind: string,
    visible: bool,
    locked: bool,
    depth: int,
    group: bool,
    selected: bool,
    // Empty when the source is active; otherwise a human-readable problem.
    problem: string,
}

// Selection or hover box in canvas pixels (rotated around its center).
export struct CanvasBox {
    visible: bool,
    cx: float,
    cy: float,
    w: float,
    h: float,
    rotation: float,
    handles: bool,
    locked: bool,
}

export struct Guide {
    vertical: bool,
    pos: float,
}

export struct Inspect {
    has: bool,
    id: string,
    name: string,
    kind: string,
    kind-label: string,
    group: bool,
    problem: string,
    x: float,
    y: float,
    w: float,
    h: float,
    rotation: float,
    // 0 free scale, 1 stretch, 2 fit, 3 fill
    size-mode: int,
    crop-l: float,
    crop-t: float,
    crop-r: float,
    crop-b: float,
    opacity: float,
    // 0 normal, 1 additive, 2 multiply, 3 screen
    blend: int,
    visible: bool,
    locked: bool,
    // Audio-only sources (no transform/crop/appearance).
    no-video: bool,
}

export struct PaletteEntry {
    id: string,
    title: string,
    category: string,
    hint: string,
}

export struct Preset {
    label: string,
    detail: string,
}

export struct SourceType {
    kind: string,
    title: string,
    description: string,
    available: bool,
}

// One editable source setting, rendered generically by the inspector.
export struct PropRow {
    key: string,
    label: string,
    hint: string,
    // "bool" | "int" | "float" | "text" | "multiline" | "color" | "path" | "select" | "button"
    kind: string,
    flag: bool,
    number: float,
    minimum: float,
    maximum: float,
    step: float,
    decimals: int,
    text: string,
    color: color,
    options: [string],
    index: int,
}
export struct MixerStrip {
    id: string,
    name: string,
    kind: string,
    // Meter positions 0..1 on a -60..0 dB scale.
    level-l: float,
    level-r: float,
    rms-l: float,
    rms-r: float,
    hold-l: float,
    hold-r: float,
    // Fader position 0..1 and its value in dB.
    fader: float,
    volume-db: float,
    muted: bool,
    monitoring: bool,
    global: bool,
    selected: bool,
    problem: string,
}

export struct FilterParamRow {
    key: string,
    label: string,
    value: float,
    minimum: float,
    maximum: float,
    step: float,
    unit: string,
}

/// Playback state of a selected media source.
export struct MediaInspect {
    has: bool,
    item: string,
    /// "1 / 3" for playlists, "" for one file.
    index: string,
    time: string,
    /// 0..1 (0 if the duration is unknown).
    progress: float,
    paused: bool,
    ended: bool,
    /// Music: tracks of its playlist around the playing one (empty for media files), which
    /// one is playing (-1 none), and whether Repeat is on.
    tracks: [string],
    track: int,
    music: bool,
    repeat: bool,
}

/// A video filter in the inspector.
export struct VideoFilterRow {
    id: string,
    name: string,
    enabled: bool,
    params: [FilterParamRow],
    /// Label of the file it needs ("" if none) and the chosen file's name.
    file-label: string,
    file: string,
    /// Takes WGSL code (custom shader).
    code: bool,
}

export struct FilterRow {
    id: string,
    name: string,
    enabled: bool,
    params: [FilterParamRow],
}

export struct AudioInspect {
    has: bool,
    volume-db: float,
    muted: bool,
    balance: float,
    mono: bool,
    sync-ms: float,
    // 0 off, 1 monitor only, 2 monitor and output
    monitoring: int,
    tracks: int,
    global: bool,
    filters: [FilterRow],
    /// Why this sound may be heard twice on the stream ("" when fine).
    problem: string,
    /// The source's name (shown when the settings open on their own, e.g. over the Live deck).
    name: string,
    /// The voice preset: 0 off, then the presets in menu order.
    voice: int,
}
// Recording & app settings shown in the Settings dialog.
/// A streaming destination in Settings.
export struct DestinationRow {
    name: string,
    enabled: bool,
    /// e.g. "RTMPS", "SRT"; "" if the server is not set or not recognized.
    protocol: string,
}

/// A destination in the live panel.
export struct LiveRow {
    name: string,
    /// Viewers right now (-1 when the platform doesn't report it).
    viewers: int,
    /// 0 off, 1 connecting, 2 live, 3 reconnecting, 4 failed
    state: int,
    /// Bitrate and drops, or the error / what is happening.
    info: string,
    /// 1 good, 2 congested / connecting, 3 failing
    health: int,
}

/// A stream event kind's sound in Settings.
export struct EventSoundRow {
    label: string,
    /// The file name, or "" for the chime.
    file: string,
}

/// A game integration in Settings → Clips.
export struct ClipIntegrationRow {
    name: string,
    status: string,
    connected: bool,
}

/// One auto-clip rule (event) of the game being edited.
export struct ClipRuleRow {
    event: string,
    enabled: bool,
    pre: float,
    post: float,
}

export struct SettingsForm {
    folder: string,
    filename: string,
    container: int,
    codec: int,
    encoders: [string],
    encoder: int,
    rate-control: int,
    bitrate: float,
    quality: float,
    keyframe: float,
    preset: int,
    audio-codec: int,
    audio-bitrate: float,
    tracks: int,
    replay-seconds: float,
    auto-remux: bool,
    /// Canvas names (current collection), for the recording and destination pickers.
    canvas-names: [string],
    /// Recording canvas index; `canvas-names.length` means all canvases.
    rec-canvas: int,
    /// `canvas-names` plus "All canvases".
    rec-canvas-names: [string],
    dest-canvas: int,
    theme: int,
    scroll-pan: bool,
    ffmpeg: string,
    // Streaming: destination list, then the editor for the selected one
    destinations: [DestinationRow],
    dest-selected: int,
    dest-name: string,
    /// The channel (or live link) the chat tab opens.
    dest-channel: string,
    /// The selected destination's platform account: "twitch", "youtube" or "" (none to connect).
    account-kind: string,
    /// The connected account's name ("" when not connected).
    account-name: string,
    account-connecting: bool,
    /// A code to enter on the platform while connecting ("" for none).
    account-code: string,
    stream-services: [string],
    stream-service: int,
    stream-server: string,
    stream-key-set: bool,
    /// Detected transport, e.g. "RTMPS", or "" if the server is not recognized.
    stream-protocol: string,
    /// Problem to fix before going live, or a bitrate warning ("" if none).
    stream-warning: string,
    stream-codec: int,
    stream-encoders: [string],
    stream-encoder: int,
    stream-bitrate: float,
    stream-audio-bitrate: float,
    stream-track: int,
    stream-reconnect: bool,
    // Going live opens the Go live window (stream details per platform).
    ask-details: bool,
    // Game capture sound when the game is already heard: 0 ask, 1 always capture, 2 leave off.
    game-audio: int,
    // Chat: emotes as images, 7TV / BetterTTV / FrankerFaceZ emotes, animation.
    chat-emotes: bool,
    chat-third-party: bool,
    chat-animate: bool,
    // Stream event sounds, one row per kind (Settings → Audio).
    event-sounds: [EventSoundRow],
    event-sound-volume: float,
    // Remote control (obs-websocket)
    remote-enabled: bool,
    remote-port: float,
    remote-auth: bool,
    remote-password: string,
    // Virtual camera
    vcam-canvas: int,
    vcam-status: string,
    vcam-installed: bool,
    // Clips
    clip-mode: bool,
    clip-buffer: float,
    clip-hotkey: string,
    clip-seconds: float,
    clip-max: float,
    clip-sound: bool,
    clip-cap: float,
    clip-folder: string,
    clip-integrations: [ClipIntegrationRow],
    /// Games with auto-clip rules, and the one being edited.
    clip-rule-games: [string],
    clip-rule-game: int,
    clip-rules: [ClipRuleRow],
    hype-game: bool,
    hype-mic: bool,
    /// 0 low, 1 medium, 2 high.
    hype-sensitivity: int,
    /// A fullscreen program to ask about ("" = none).
    clip-ask: string,
    /// Settings → Performance: the profile the settings match (0 Gaming, 1 Balanced,
    /// 2 Quality, -1 custom), the recommended one (-1 = not known yet), what was found on
    /// this PC, and a profile waiting for confirmation (-1 = none) with its changes.
    perf-current: int,
    perf-recommended: int,
    perf-found: string,
    perf-warning: string,
    perf-pending: int,
    perf-changes: [string],
    perf-can-revert: bool,
    /// Settings → Updates: mode (0 install automatically, 1 tell me, 2 off), whether betas
    /// count, the installed version, what's happening, the action button ("" none), download
    /// progress (-1 none) and whether there's a release page to open.
    upd-mode: int,
    upd-betas: bool,
    upd-version: string,
    upd-status: string,
    upd-action: string,
    upd-progress: float,
    upd-notes: bool,
}

/// One macro in the automation list.
export struct MacroRow {
    id: string,
    name: string,
    enabled: bool,
    /// Its triggers in words ("Ctrl+F9 · When stream starts").
    summary: string,
    running: bool,
}

/// One trigger of the selected macro.
export struct TriggerRow {
    /// "hotkey" | "focus" | "interval" | "scene" | "output" | "game"
    kind: string,
    /// Hotkey chord or window pattern.
    text: string,
    /// Interval seconds.
    number: float,
    /// Scene, output or game event index.
    index: int,
    /// Output: true = starts, false = stops.
    flag: bool,
    /// Hotkey taken by another program.
    conflict: bool,
    /// Game event: index into `game-names` (0 = any game).
    game: int,
}

/// One step of the selected macro.
export struct StepRow {
    /// "scene" | "visible" | "mute" | "output" | "replay" | "clip" | "studio" | "action" | "wait"
    kind: string,
    /// Scene, source, output or action index.
    index: int,
    /// 0 on, 1 off, 2 toggle.
    mode: int,
    /// Scene: cut instead of the transition.
    flag: bool,
    /// Wait milliseconds, or clip seconds before.
    number: float,
    /// Clip seconds after.
    after: float,
}

export struct AutomationForm {
    macros: [MacroRow],
    selected: int,
    name: string,
    enabled: bool,
    triggers: [TriggerRow],
    steps: [StepRow],
    scene-names: [string],
    source-names: [string],
    output-names: [string],
    action-names: [string],
    /// Game event kinds, and game names ("Any game" first).
    event-names: [string],
    game-names: [string],
    /// Trigger whose hotkey is being recorded (-1 = none).
    recording: int,
    error: string,
    running: bool,
}

/// A saved montage on the Montages home page.
export struct MontageRow {
    name: string,
    /// e.g. "0:58 · 9:16 · Today 21:14"
    detail: string,
}

/// Something to pick in the New montage wizard: a clip, or a highlight of a scanned recording.
export struct PickRow {
    title: string,
    detail: string,
    thumb: image,
    has-thumb: bool,
    picked: bool,
}

/// A recording that can be scanned for highlights.
export struct RecordingRow {
    name: string,
    detail: string,
    /// 0..1 while scanning, -1 otherwise.
    progress: float,
    scanned: bool,
}

/// A segment on the timeline (positions in pixels).
export struct BlockRow {
    x: length,
    w: length,
    label: string,
    thumb: image,
    has-thumb: bool,
    selected: bool,
    missing: bool,
    slow: bool,
    /// Event ticks, in pixels from the block's left edge.
    events: [length],
}

/// A transition between two segments.
export struct ChipRow {
    x: length,
    label: string,
    selected: bool,
}

/// A title on its lane.
export struct TitleRow {
    x: length,
    w: length,
    text: string,
    selected: bool,
}

/// The montage editor and the pages around it.
export struct MontageForm {
    /// "home" | "wizard" | "editor"
    page: string,
    // Home
    montages: [MontageRow],
    // Wizard
    /// 0 pick, 1 style
    step: int,
    /// 0 clips, 1 recordings
    source-tab: int,
    clips: [PickRow],
    recordings: [RecordingRow],
    highlights: [PickRow],
    picked-count: int,
    music-name: string,
    music-detail: string,
    target: float,
    /// 0 16:9, 1 9:16, 2 1:1
    format: int,
    /// 0 chronological, 1 best first
    order: int,
    slow-motion: bool,
    title-text: string,
    busy: string,
    // Editor
    name: string,
    duration: float,
    position: float,
    time-text: string,
    playing: bool,
    preview: image,
    has-preview: bool,
    can-undo: bool,
    can-redo: bool,
    timeline-width: length,
    playhead-x: length,
    blocks: [BlockRow],
    chips: [ChipRow],
    titles: [TitleRow],
    has-music: bool,
    music-x: length,
    music-w: length,
    /// Waveform bar heights (0..1), one per 4 px.
    waveform: [float],
    /// Beat positions in pixels.
    beats: [length],
    /// "" | "segment" | "transition" | "title" | "music" | "montage"
    selection: string,
    // Inspector: segment
    seg-speed: float,
    seg-gain: float,
    seg-pan: float,
    seg-length: string,
    seg-source: string,
    seg-missing: bool,
    // Inspector: transition (0 cut, 1 crossfade, 2 dip, 3 whip)
    trans-kind: int,
    trans-secs: float,
    // Inspector: title
    title-edit: string,
    title-style: int,
    title-anchor: int,
    title-start: float,
    title-dur: float,
    // Inspector: music / montage
    music-gain: float,
    music-fade-in: float,
    music-fade-out: float,
    duck: float,
    fade-out: float,
    // Export
    export-preset: int,
    /// 0..1 while exporting, -1 otherwise.
    export-progress: float,
    add-to-clips: bool,
    error: string,
}

/// One clip in the Clips view grid.
export struct ClipRow {
    title: string,
    game: string,
    /// e.g. "Today 20:14" or "12 Oct 20:14".
    when: string,
    /// e.g. "0:17".
    length: string,
    thumb: image,
    has-thumb: bool,
    favorite: bool,
    auto: bool,
}

/// The Clips view.
/// An event on the clip player's seek bar.
export struct ClipTick {
    /// Seconds into the clip.
    at: float,
    label: string,
}

/// The in-app clip player, updated while it plays (kept out of `ClipsForm`, which is rebuilt
/// only when the library changes).
export struct ClipPlayerState {
    /// The player has the selected clip open (its frames replace the still preview).
    active: bool,
    playing: bool,
    /// Seconds.
    position: float,
    /// 0..1.
    volume: float,
    muted: bool,
    frame: image,
    has-frame: bool,
}

export struct ClipsForm {
    items: [ClipRow],
    /// "All games" first.
    games: [string],
    game-filter: int,
    /// 0 all, 1 automatic, 2 manual, 3 favorites, 4 recordings.
    kind-filter: int,
    /// Recordings are listed instead of clips.
    recordings: bool,
    search: string,
    /// Index into `items`, -1 = none.
    selected: int,
    /// The selected clip.
    title: string,
    subtitle: string,
    /// Events inside the clip, e.g. "Kill 0:10 · Double kill 0:14".
    events: string,
    /// The same events, for the player's seek bar.
    ticks: [ClipTick],
    favorite: bool,
    /// Seconds.
    duration: float,
    trim-in: float,
    trim-out: float,
    /// 0 lossless, 1 precise.
    trim-mode: int,
    /// The frame at the trim point being edited.
    preview: image,
    has-preview: bool,
    /// Trimming in progress (0..1), or -1.
    progress: float,
    /// "123 clips · 4.2 GB (auto 3.1 GB of 20 GB)"
    summary: string,
}

/// One metric tile in Stats: value, caption and a sparkline.
export struct StatTile {
    label: string,
    value: string,
    sub: string,
    /// Sparkline as path commands in a 100×12 box ("" = no history yet).
    path: string,
    /// 0 good, 1 warning, 2 problem.
    level: int,
}

/// An encoder or destination row in Stats.
export struct StatRow {
    name: string,
    detail: string,
    c1: string,
    c2: string,
    c3: string,
    c4: string,
    level: int,
}

export struct AlertRow {
    /// 1 warning, 2 problem.
    severity: int,
    title: string,
    detail: string,
    advice: string,
}

export struct StatsForm {
    tiles: [StatTile],
    encoders: [StatRow],
    destinations: [StatRow],
    alerts: [AlertRow],
}

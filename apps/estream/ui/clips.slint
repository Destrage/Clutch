// Clips: the clip library (grid with filters) and the selected clip (details, trim).

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { ClipsForm, ClipRow, ClipPlayerState } from "types.slint";
import { Button, IconButton, TextField, NumberField, Select, Slider, SectionTitle, EmptyState, Badge } from "widgets.slint";
import { Modal } from "overlays.slint";

component ClipTile inherits Rectangle {
    in property <ClipRow> entry;
    in property <bool> selected;
    callback clicked();
    callback open();

    border-radius: Theme.radius-l;
    background: ta.has-hover && !selected ? Theme.surface-2 : Theme.surface;
    border-width: selected ? 2px : 1px;
    border-color: selected ? Theme.accent : Theme.border;
    accessible-role: list-item;
    accessible-label: entry.title + ", " + entry.game + ", " + entry.length;
    ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
        double-clicked => { root.open(); }
    }
    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        Rectangle {
            height: (root.width - 16px) * 9 / 16;
            border-radius: Theme.radius-m;
            background: Theme.surface-3;
            clip: true;
            if entry.has-thumb: Image {
                width: parent.width;
                height: parent.height;
                source: entry.thumb;
                image-fit: cover;
            }
            if !entry.has-thumb: Image {
                width: 28px;
                height: 28px;
                source: Icons.film;
                colorize: Theme.text-faint;
            }
            Rectangle {
                x: parent.width - self.width - 6px;
                y: parent.height - self.height - 6px;
                width: len.preferred-width + 10px;
                height: 18px;
                border-radius: 4px;
                background: #000000b0;
                len := Text { text: entry.length; color: #ffffff; font-size: Theme.font-xs; horizontal-alignment: center; vertical-alignment: center; }
            }
            if entry.favorite: Image {
                x: 6px;
                y: 6px;
                width: 16px;
                height: 16px;
                source: Icons.star;
                colorize: #ffd54a;
            }
        }
        Text { text: entry.title; color: Theme.text; font-size: Theme.font-m; font-weight: 600; overflow: elide; }
        Text { text: entry.game == "" ? entry.when : entry.game + " · " + entry.when; color: Theme.text-muted; font-size: Theme.font-xs; overflow: elide; }
    }
}

export component ClipsDialog inherits Modal {
    in property <ClipsForm> form;
    in property <ClipPlayerState> player;
    callback action(string, int, float);
    callback text(string, string);

    card-width: 1100px;
    card-top: 30px;

    // As a page the library gets more room: four columns across about 60% of the width.
    property <int> columns: root.as-page ? 4 : 3;
    property <length> grid-width: root.as-page ? max(580px, (root.inner-width - 73px) * 0.62) : 580px;
    // What's left of the card for the selected clip (paddings, gaps and the divider).
    property <length> detail-width: root.inner-width - root.grid-width - 36px - 37px;
    property <length> gap: 12px;
    property <length> tile-width: (grid-width - gap * (columns - 1)) / columns;
    property <length> tile-height: (tile-width - 16px) * 9 / 16 + 66px;
    // Delete asks twice: the first press arms it for a few seconds.
    property <bool> confirm-delete: false;
    property <int> armed-for: -1;
    function delete-pressed() {
        if (root.confirm-delete && root.armed-for == root.form.selected) {
            root.confirm-delete = false;
            root.action("delete", root.form.selected, 0);
        } else {
            root.confirm-delete = true;
            root.armed-for = root.form.selected;
        }
    }
    Timer {
        interval: 3s;
        running: root.confirm-delete;
        triggered => { root.confirm-delete = false; }
    }
    /// "1:05" for 65 seconds.
    pure function clock(seconds: float) -> string {
        let s = floor(max(seconds, 0));
        let m = floor(s / 60);
        let rest = s - m * 60;
        return m + ":" + (rest < 10 ? "0" : "") + rest;
    }

    FocusScope {
        height: 0px;
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.dismiss();
                return EventResult.accept;
            }
            if (e.text == Key.Delete && root.form.selected >= 0) {
                root.delete-pressed();
                return EventResult.accept;
            }
            // The player: Space plays or pauses, the arrows skip 5 s, M mutes.
            if (root.form.selected >= 0) {
                if (e.text == " ") {
                    root.action("play-toggle", root.form.selected, 0);
                    return EventResult.accept;
                }
                if (e.text == Key.LeftArrow || e.text == Key.RightArrow) {
                    root.action("seek-by", root.form.selected, e.text == Key.LeftArrow ? -5 : 5);
                    return EventResult.accept;
                }
                if (e.text == "m" || e.text == "M") {
                    root.action("mute", root.form.selected, 0);
                    return EventResult.accept;
                }
            }
            return EventResult.reject;
        }
    }
    HorizontalLayout {
        padding: 18px;
        padding-bottom: 4px;
        spacing: 10px;
        Text { text: root.form.recordings ? "Recordings" : "Clips"; color: Theme.text; font-family: Theme.font-display; font-size: root.as-page ? 28px : Theme.font-xl; font-weight: 600; vertical-alignment: center; }
        Text { text: root.form.summary; color: Theme.text-faint; font-size: Theme.font-s; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
        Button { text: "Make a montage"; has-icon: true; icon: Icons.sparkles; kind: "ghost"; tooltip: "Cut your clips into a highlight video to music"; clicked => { root.action("make-montage", 0, 0); } }
        Button { text: "Open folder"; has-icon: true; icon: Icons.folder-open; kind: "ghost"; clicked => { root.action("open-folder", 0, 0); } }
        if !root.as-page: Button { text: "Done"; kind: "primary"; clicked => { root.dismiss(); } }
    }
    HorizontalLayout {
        padding: 18px;
        padding-top: 8px;
        spacing: 18px;
        height: root.as-page ? max(600px, root.height - 70px) : 600px;

        // Library
        VerticalLayout {
            width: root.grid-width;
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                TextField {
                    label: root.form.recordings ? "Search recordings" : "Search clips";
                    placeholder: "Search titles";
                    text: root.form.search;
                    edited(t) => { root.text("search", t); }
                }
                if !root.form.recordings: Select {
                    width: 170px;
                    label: "Game";
                    options: root.form.games;
                    current-index: root.form.game-filter;
                    selected(i) => { root.action("filter-game", i, 0); }
                }
                Select {
                    width: 130px;
                    label: "Show";
                    options: ["All clips", "Automatic", "Manual", "Favorites", "Recordings"];
                    current-index: root.form.kind-filter;
                    selected(i) => { root.action("filter-kind", i, 0); }
                }
            }
            if root.form.items.length == 0: VerticalLayout {
                vertical-stretch: 1;
                alignment: center;
                EmptyState {
                    icon: Icons.film;
                    title: root.form.recordings ? "No recordings yet" : "No clips yet";
                    body: root.form.recordings
                        ? "Press Record in the top bar. Recordings saved in your recording folder show up here."
                        : "Press your clip hotkey after something great happens, or turn on clip mode and auto-clip in Settings → Clips.";
                }
            }
            if root.form.items.length > 0: Flickable {
                vertical-stretch: 1;
                content-height: ceil(root.form.items.length / root.columns) * (root.tile-height + root.gap);
                for c[i] in root.form.items: ClipTile {
                    x: mod(i, root.columns) * (root.tile-width + root.gap);
                    y: floor(i / root.columns) * (root.tile-height + root.gap);
                    width: root.tile-width;
                    height: root.tile-height;
                    entry: c;
                    selected: i == root.form.selected;
                    clicked => { root.action("select", i, 0); }
                    open => { root.action("play", i, 0); }
                }
            }
        }

        Rectangle { width: 1px; background: Theme.border; }

        // Selected clip
        if root.form.selected < 0: VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            EmptyState {
                icon: Icons.scissors;
                title: root.form.recordings ? "Pick a recording" : "Pick a clip";
                body: root.form.recordings
                    ? "Select a recording to rename it, play it or cut a clip from it. Double-click to play."
                    : "Select a clip to rename it, mark it as a favorite or trim it. Double-click to play.";
            }
        }
        if root.form.selected >= 0: VerticalLayout {
            width: root.detail-width;
            spacing: 10px;
            alignment: start;
            Rectangle {
                width: root.detail-width;
                height: root.detail-width * 9 / 16;
                border-radius: Theme.radius-m;
                background: #000000;
                clip: true;
                if root.player.active && root.player.has-frame: Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.player.frame;
                    image-fit: contain;
                }
                if !(root.player.active && root.player.has-frame) && root.form.has-preview: Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.form.preview;
                    image-fit: contain;
                }
                if !root.player.active && !root.form.has-preview: Text { text: "Loading frame…"; color: Theme.text-faint; font-size: Theme.font-s; }
                // Click the picture to play or pause.
                TouchArea {
                    clicked => { root.action("play-toggle", root.form.selected, 0); }
                    double-clicked => { root.action("play-toggle", root.form.selected, 0); }
                }
            }
            // Player controls: play/pause, seek bar with event ticks, time, volume.
            HorizontalLayout {
                spacing: 8px;
                IconButton {
                    icon: root.player.playing ? Icons.pause : Icons.play;
                    tooltip: root.player.playing ? "Pause (Space)" : "Play (Space)";
                    clicked => { root.action("play-toggle", root.form.selected, 0); }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    Slider {
                        y: (parent.height - self.height) / 2;
                        width: parent.width;
                        label: "Playback position";
                        value: root.player.position;
                        minimum: 0;
                        maximum: max(root.form.duration, 0.1);
                        changed(v) => { root.action("seek", root.form.selected, v); }
                        committed => { root.action("seek-done", root.form.selected, 0); }
                    }
                    for t[i] in root.form.ticks: Rectangle {
                        x: (parent.width - 14px) * clamp(t.at / max(root.form.duration, 0.1), 0, 1) + 7px - 3px;
                        y: 0;
                        width: 6px;
                        height: 7px;
                        border-radius: 2px;
                        background: #ffd54a;
                        accessible-role: button;
                        accessible-label: t.label;
                        TouchArea {
                            mouse-cursor: MouseCursor.pointer;
                            clicked => { root.action("seek-event", i, 0); }
                        }
                    }
                }
                Text {
                    text: root.clock(root.player.position) + " / " + root.clock(root.form.duration);
                    color: Theme.text-muted;
                    font-size: Theme.font-xs;
                    vertical-alignment: center;
                }
                IconButton {
                    icon: root.player.muted || root.player.volume <= 0 ? Icons.volume-x : Icons.volume;
                    toggled: root.player.muted;
                    tooltip: root.player.muted ? "Unmute (M)" : "Mute (M)";
                    clicked => { root.action("mute", root.form.selected, 0); }
                }
                Slider {
                    width: 70px;
                    label: "Volume";
                    value: root.player.volume;
                    changed(v) => { root.action("volume", root.form.selected, v); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                TextField {
                    label: root.form.recordings ? "Recording title" : "Clip title";
                    text: root.form.title;
                    accepted(t) => { root.text("title", t); }
                }
                IconButton {
                    icon: Icons.star;
                    toggled: root.form.favorite;
                    tooltip: root.form.favorite ? "Remove from favorites" : "Add to favorites (never deleted automatically)";
                    clicked => { root.action("favorite", root.form.selected, 0); }
                }
            }
            Text { text: root.form.subtitle; color: Theme.text-muted; font-size: Theme.font-s; overflow: elide; }
            if root.form.events != "": Text { text: root.form.events; color: Theme.text-faint; font-size: Theme.font-xs; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Button { text: "Open in player"; has-icon: true; icon: Icons.app-window; kind: "ghost"; tooltip: "Open in your default video player"; clicked => { root.action("open-external", root.form.selected, 0); } }
                Button { text: "Show in folder"; has-icon: true; icon: Icons.folder; kind: "ghost"; clicked => { root.action("reveal", root.form.selected, 0); } }
                Button { text: "Copy"; has-icon: true; icon: Icons.copy; kind: "ghost"; tooltip: "Copy the file, to paste into Discord or a folder"; clicked => { root.action("copy", root.form.selected, 0); } }
                Button {
                    text: root.confirm-delete && root.armed-for == root.form.selected ? "Delete for good?" : "Delete";
                    has-icon: true;
                    icon: Icons.trash;
                    kind: "danger";
                    tooltip: root.form.recordings ? "Deletes the recording file; press twice" : "Deletes the clip file; press twice";
                    clicked => { root.delete-pressed(); }
                }
            }

            SectionTitle { text: "TRIM"; }
            if root.form.recordings && root.form.ticks.length > 0: Text {
                text: "Click a marker on the seek bar to trim around that moment, then save it as a clip.";
                color: Theme.text-faint;
                font-size: Theme.font-xs;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                Text { text: "In"; width: 28px; color: Theme.text-muted; font-size: Theme.font-s; vertical-alignment: center; }
                Slider {
                    label: "Trim start";
                    value: root.form.trim-in;
                    minimum: 0;
                    maximum: max(root.form.duration, 0.1);
                    changed(v) => { root.action("trim-in", root.form.selected, v); }
                }
                NumberField {
                    width: 90px;
                    label: "";
                    value: root.form.trim-in;
                    minimum: 0;
                    maximum: root.form.duration;
                    step: 0.1;
                    decimals: 1;
                    suffix: "s";
                    changed(v) => { root.action("trim-in", root.form.selected, v); }
                }
                Button { text: "Set"; kind: "ghost"; tooltip: "Start the trim at the playback position"; clicked => { root.action("trim-in", root.form.selected, root.player.position); } }
            }
            HorizontalLayout {
                spacing: 8px;
                Text { text: "Out"; width: 28px; color: Theme.text-muted; font-size: Theme.font-s; vertical-alignment: center; }
                Slider {
                    label: "Trim end";
                    value: root.form.trim-out;
                    minimum: 0;
                    maximum: max(root.form.duration, 0.1);
                    changed(v) => { root.action("trim-out", root.form.selected, v); }
                }
                NumberField {
                    width: 90px;
                    label: "";
                    value: root.form.trim-out;
                    minimum: 0;
                    maximum: root.form.duration;
                    step: 0.1;
                    decimals: 1;
                    suffix: "s";
                    changed(v) => { root.action("trim-out", root.form.selected, v); }
                }
                Button { text: "Set"; kind: "ghost"; tooltip: "End the trim at the playback position"; clicked => { root.action("trim-out", root.form.selected, root.player.position); } }
            }
            HorizontalLayout {
                spacing: 8px;
                Select {
                    width: 210px;
                    label: "Trim mode";
                    options: ["Fast (cuts at keyframes)", "Exact (re-encodes)"];
                    current-index: root.form.trim-mode;
                    selected(i) => { root.action("trim-mode", i, 0); }
                }
                Rectangle { horizontal-stretch: 1; }
                if root.form.progress < 0: Button {
                    text: "Save as new clip";
                    has-icon: true;
                    icon: Icons.scissors;
                    enabled: root.form.trim-out > root.form.trim-in;
                    clicked => { root.action("trim-new", root.form.selected, 0); }
                }
                if root.form.progress < 0: Button {
                    text: "Replace";
                    kind: "ghost";
                    enabled: root.form.trim-out > root.form.trim-in;
                    tooltip: root.form.recordings ? "Trim this recording in place" : "Trim this clip in place";
                    clicked => { root.action("trim-replace", root.form.selected, 0); }
                }
                if root.form.progress >= 0: HorizontalLayout {
                    spacing: 8px;
                    Text { text: "Trimming… " + round(root.form.progress * 100) + "%"; color: Theme.text-muted; font-size: Theme.font-s; vertical-alignment: center; }
                    Button { text: "Cancel"; kind: "ghost"; clicked => { root.action("trim-cancel", 0, 0); } }
                }
            }
        }
    }
}

// Clutch main window.

// Bundled fonts (SIL Open Font License; the licences ship in the install's licenses folder).
import "fonts/Figtree.ttf";
import "fonts/Jost.ttf";
import { Theme, Platform } from "theme.slint";
import { Icons } from "icons.slint";
import { CanvasTab, SceneRow, LayerRow, CanvasBox, Guide, Inspect, PaletteEntry, Preset, SetupLine, SourceType, PropRow, MixerStrip, AudioInspect, SettingsForm, LiveRow, DestinationRow, VideoFilterRow, MediaInspect, AutomationForm, MacroRow, TriggerRow, StepRow, ClipsForm, ClipRow, ClipPlayerState, MontageForm, StatsForm, StatTile, StatRow, AlertRow, InspectorFolds } from "types.slint";
import { VSplitter, HSplitter, TooltipLayer, Hint } from "widgets.slint";
import { Preview } from "preview.slint";
import { InspectorPanel } from "inspector.slint";
import { TopBar, ScenesPanel, SourcesPanel, MixerPanel, StatusBar, TransitionColumn, ProgramView, CanvasTabs } from "panels.slint";
import { CommandPalette, AddSourceDialog, SetupWizard, SetupDialog, RecoveryPrompt, GameAudioPrompt, Toast, SettingsDialog, LivePanel, ShaderDialog } from "overlays.slint";
import { AutomationDialog } from "automation.slint";
import { StatsDialog } from "stats.slint";
import { ClipsDialog } from "clips.slint";
import { MontageDialog } from "montage.slint";
import { LiveDeck } from "deck.slint";
import { Sidebar } from "sidebar.slint";
import { SceneStrip } from "stage.slint";
import { ChatPanel, ChatTabRow, ChatLive, ChatLine, ChatStateRow, SignInDialog } from "chat.slint";
import { GoLiveDialog, StreamDetailsDialog, DetailsSection } from "golive.slint";

export { Theme, Platform }

export component AppWindow inherits Window {
    in property <string> window-title: "Clutch";
    title: window-title;
    preferred-width: 1440px;
    preferred-height: 900px;
    min-width: 980px;
    min-height: 620px;
    background: Theme.bg;
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-m;
    icon: Icons.logo;

    // "loading" | "wizard" | "recovery" | "ready"
    in property <string> startup: "loading";

    // Preview
    in property <image> preview-frame;
    // The live scene card's picture: a new image a few times a second (the main view's
    // image stays the same object and is redrawn in place, which the card wouldn't show).
    in property <image> card-frame;
    in property <bool> scroll-pan;
    // Studio mode and transitions
    in property <bool> studio-mode;
    in property <[CanvasTab]> canvas-tabs;
    in property <[string]> canvas-presets;
    in-out property <string> renaming-canvas;
    callback canvas-select(string);
    callback canvas-add(int);
    callback canvas-remove(string);
    callback canvas-rename(string, string);
    in property <image> program-frame;
    in property <int> transition-kind;
    in property <int> transition-direction;
    in property <float> transition-duration;
    in property <string> transition-file;
    in property <float> transition-point;
    in property <string> transition-label;
    in property <bool> transition-busy;
    in-out property <bool> shader-open;
    in property <string> shader-code;
    in property <string> shader-error;
    callback transition-set(string, float);
    callback studio-go(string);
    callback shader-apply(string);
    callback shader-example();
    in property <string> shader-title: "Custom transition shader";
    in property <string> shader-help;
    in property <[VideoFilterRow]> video-filters;
    in property <MediaInspect> media-inspect;
    callback media-control(string);
    callback media-seek(float);
    in property <bool> browser-selected;
    in property <string> browser-status;
    in property <string> remote-status;
    callback browser-reload();
    in property <[string]> video-filter-kinds;
    callback vfilter-add(int);
    callback vfilter-remove(string);
    callback vfilter-toggle(string, bool);
    callback vfilter-param(string, string, float);
    callback vfilter-move(string, bool);
    callback vfilter-browse(string);
    callback vfilter-code(string);
    in property <float> canvas-w: 1920;
    in property <float> canvas-h: 1080;
    in property <CanvasBox> selection-box;
    in property <CanvasBox> hover-box;
    in property <[Guide]> guides;
    in property <string> cursor: "default";

    // Panels
    in property <[SceneRow]> scenes;
    in property <[LayerRow]> layers;
    in property <Inspect> inspect;
    in property <[PropRow]> props;
    in property <AudioInspect> audio-inspect;
    in property <[MixerStrip]> mixer-strips;
    in property <MixerStrip> mixer-master;
    in-out property <string> renaming-scene;

    // Top bar and status
    in property <string> collection-name: "My setup";
    in property <string> canvas-info;
    in property <string> canvas-tag;
    // Setups (scene collections): the list, the open one, and the name/delete dialog.
    in property <[string]> setups;
    in property <int> setup-index;
    in-out property <string> setup-dialog;
    in-out property <string> setup-dialog-name;
    in property <string> setup-dialog-error;
    in property <string> wizard-setup-name;
    callback setup-pick(int);
    callback setup-action(string);
    callback setup-confirm(string);
    callback setup-cancel();
    callback wizard-cancel();
    in property <string> gpu-info;
    /// This build, shown at the bottom right ("Clutch 0.4.0 beta 1").
    in property <string> app-version;
    in property <bool> dirty;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <float> fps;
    in property <float> target-fps: 60;
    in property <float> render-ms;
    in property <int> lagged;
    in property <string> status-message;

    // Overlays
    in-out property <bool> palette-open;
    in property <[PaletteEntry]> palette-entries;
    in-out property <string> palette-query;
    in-out property <int> palette-current;
    in-out property <bool> add-source-open;
    // "Capture the game's sound too?" when adding a Game capture.
    in-out property <bool> game-audio-open;
    in property <string> game-audio-heard-by;
    callback game-audio-answer(bool, bool);
    in property <[SourceType]> source-types;
    in property <[Preset]> presets;
    in property <[Preset]> wizard-purposes;
    in-out property <int> wizard-purpose;
    in property <[SetupLine]> wizard-summary;
    in-out property <bool> wizard-custom;
    in-out property <int> wizard-current;
    in property <bool> recording;
    in property <string> record-time;
    in property <bool> replay-active;
    in property <int> vcam-state;
    in property <string> vcam-tooltip;
    in property <int> stream-state;
    in property <string> stream-time;
    in property <string> stream-info;
    in property <int> stream-health;
    in property <[LiveRow]> live-rows;
    // The destinations streaming or trying to (not off), for the live view.
    in property <[LiveRow]> live-active-rows;
    /// Viewers across platforms that report them (-1: none do).
    in property <int> viewers-total: -1;
    // The Live deck shows while a stream runs, unless the user chose to edit the layout.
    // Chat panel (the Live deck's right column and the Chat page).
    in property <[ChatTabRow]> chat-tabs;
    in property <int> chat-selected;
    in property <image> chat-frame;
    in property <string> chat-message;
    /// Who is in the selected chat (-1: not listed).
    in property <int> chat-people-total: -1;
    in property <[string]> chat-people;
    in property <ChatLive> chat-live;
    in-out property <bool> chat-open;
    // Signing in to a platform inside Clutch (shown over everything).
    in property <bool> signin-open;
    in property <string> signin-title;
    in property <string> signin-hint;
    in property <image> signin-frame;
    in property <string> signin-message;
    callback signin-pointer(string, float, float, int, float, float);
    callback signin-key(string, bool, bool, bool, bool);
    callback signin-resized(float, float);
    callback signin-browser();
    callback signin-cancel();
    callback chat-select(int);
    callback chat-pointer(string, float, float, int, float, float);
    callback chat-key(string, bool, bool, bool, bool);
    callback chat-home();
    callback chat-reload();
    callback chat-resized(float, float);
    callback chat-send(string, int);
    callback chat-toggle-chime();
    // Animated emotes: the frame clock (ms), and the chat's text width for laying out lines.
    in property <int> chat-emote-ms;
    callback chat-text-width(float);
    /// Whether a chat panel is on screen.
    out property <bool> chat-visible: root.deck-visible || root.chat-open;
    in-out property <bool> deck-edit;
    /// The section shown beside the sidebar.
    property <string> page: root.chat-open ? "chat" : root.clips-open ? "clips" : root.montage-open ? "montages" : "studio";
    property <length> sidebar-width: 76px;
    /// Leaves Clips or Montages (whichever is open) for the studio.
    function close-pages() {
        root.chat-open = false;
        if (root.clips-open) {
            root.clips-action("close", 0, 0);
            root.clips-open = false;
        }
        if (root.montage-open) {
            root.montage-action("close", 0, 0);
            root.montage-open = false;
        }
        main-keys.focus();
    }
    property <bool> deck-visible: root.stream-state != 0 && !root.deck-edit && root.startup == "ready";
    changed stream-state => { if (root.stream-state == 0) { root.deck-edit = false; } }
    /// The clip hotkey (e.g. "F8"), shown on the deck's clip button.
    in property <string> clip-hotkey;
    in-out property <bool> live-panel-open;
    callback live-toggle(int);
    in-out property <bool> settings-open;
    /// The Settings page shown (kept while Settings is closed, so it reopens there).
    in-out property <int> settings-page;
    /// The version an update is ready to install ("" = none).
    in property <string> update-ready;
    in-out property <bool> automation-open;
    in-out property <bool> stats-open;
    in-out property <bool> clips-open;
    in property <ClipsForm> clips-form;
    in property <ClipPlayerState> clip-player;
    callback clips-action(string, int, float);
    callback clips-text(string, string);
    in-out property <bool> montage-open;
    in property <MontageForm> montage-form;
    callback montage-action(string, int, float);
    callback montage-text(string, string);
    callback montage-key(string, bool, bool);
    in-out property <bool> golive-open;
    in property <[string]> golive-platforms;
    in property <int> golive-platform: -1;
    in-out property <string> golive-key;
    in property <string> golive-message;
    in property <bool> golive-message-error;
    in property <string> golive-auto;
    callback golive-pick(int);
    callback golive-open-key-page();
    callback golive-go();
    callback golive-more();
    callback golive-key-edited(string);
    // The Go live window (stream details per connected platform).
    in-out property <bool> details-open;
    in property <[DetailsSection]> details-sections;
    in property <string> details-keys-only;
    in property <bool> details-live;
    in property <string> details-busy;
    in property <bool> details-loading;
    in property <bool> details-ask: true;
    callback details-text(int, string, string);
    callback details-flag(int, string, bool);
    callback details-choose(int, string, int);
    callback details-retry(int);
    callback details-skip(int);
    callback details-set-ask(bool);
    callback details-go();
    callback details-closed();
    /// The Go Live button (hotkeys and remote control use the "stream.toggle" action).
    callback go-live-clicked();
    in property <StatsForm> stats-form;
    in property <int> health;
    in property <string> health-text: "Healthy";
    in property <AutomationForm> automation-form;
    callback automation-edit(string, int, float);
    callback automation-text(string, int, string);
    callback automation-key(string, bool, bool, bool, bool);
    in property <SettingsForm> settings-form;
    in property <string> toast-text;
    in property <bool> toast-error;
    /// A button on the toast ("" = none), and its click.
    in property <string> toast-action;
    callback toast-act();

    // Layout (persisted)
    in-out property <length> scenes-width: 220px;
    in-out property <length> inspector-width: 300px;
    in-out property <length> bottom-height: 230px;
    in-out property <length> sources-width: 420px;
    /// Stage: the floating layers list and the mixer.
    in-out property <bool> layers-open: true;
    in-out property <bool> mixer-open;
    /// The inspector's chosen tab and its folded panels (Crop and Advanced start folded).
    in-out property <string> inspector-tab;
    in-out property <InspectorFolds> inspector-folds: { crop: true, advanced: true };

    property <bool> space-down;

    callback key(string, bool, bool, bool) -> bool;
    callback preview-pointer(string, float, float, float, bool, bool, bool);
    callback preview-wheel(float, float, float, float) -> bool;
    callback scene-activate(string);
    callback scene-add();
    callback scene-duplicate(string);
    callback scene-remove(string);
    callback scene-rename(string, string);
    callback layer-select(string);
    callback layer-toggle-visible(string);
    callback layer-toggle-lock(string);
    callback action(string);
    callback inspect-edit(string, float);
    callback inspect-text(string, string);
    callback inspect-color(color);
    callback inspect-option(string, int);
    callback inspect-toggle(string, bool);
    callback inspect-commit();
    callback prop-flag(string, bool);
    callback prop-number(string, float);
    callback prop-text(string, string);
    callback prop-color(string, color);
    callback prop-index(string, int);
    callback prop-browse(string);
    callback prop-refresh();
    callback audio-set(string, float);
    callback filter-add(int);
    callback filter-remove(string);
    callback filter-toggle(string, bool);
    callback filter-param(string, string, float);
    callback filter-move(string, bool);
    callback mixer-select(string);
    callback mixer-fader(string, float);
    callback mixer-mute(string);
    callback palette-query-changed(string);
    callback palette-run(string);
    callback add-source-pick(string);
    callback wizard-create();
    callback wizard-purpose-changed(int);
    callback wizard-toggled(string);
    callback recovery-restore();
    callback recovery-discard();
    callback toggle-theme();
    callback settings-set(string, float);
    callback settings-text(string, string);
    callback settings-browse();

    public function zoom-fit() { preview.zoom-fit(); }
    public function zoom-actual() { preview.zoom-actual(); }
    public function focus-main() { main-keys.focus(); }
    pure function fkey-index(t: string) -> int {
        if (t == Key.F1) { return 0; }
        if (t == Key.F2) { return 1; }
        if (t == Key.F3) { return 2; }
        if (t == Key.F4) { return 3; }
        if (t == Key.F5) { return 4; }
        if (t == Key.F6) { return 5; }
        if (t == Key.F7) { return 6; }
        if (t == Key.F8) { return 7; }
        if (t == Key.F9) { return 8; }
        return -1;
    }

    main-keys := FocusScope {
        width: 100%;
        height: 100%;
        init => { self.focus(); }
        key-pressed(e) => {
            // On the Live deck, F1 to F9 switch scenes (except the clip hotkey).
            if (root.deck-visible) {
                let i = root.fkey-index(e.text);
                if (i >= 0 && i < root.scenes.length && "F" + (i + 1) != root.clip-hotkey) {
                    root.scene-activate(root.scenes[i].id);
                    return EventResult.accept;
                }
            }
            if (e.text == " ") {
                root.space-down = true;
                return EventResult.accept;
            }
            if (root.key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt)) {
                return EventResult.accept;
            }
            return EventResult.reject;
        }
        key-released(e) => {
            if (e.text == " ") {
                root.space-down = false;
            }
            return EventResult.reject;
        }

        HorizontalLayout {
        width: parent.width;
        height: parent.height;
        Sidebar {
            page: root.page;
            open(p) => {
                if (p == root.page) { return; }
                root.close-pages();
                if (p == "clips") { root.action("clips.open"); }
                if (p == "montages") { root.action("montage.open"); }
                if (p == "chat") { root.chat-open = true; }
            }
            open-settings => { root.action("settings"); }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            TopBar {
                collection-name: root.collection-name;
                canvas-info: root.canvas-info;
                canvas-tag: root.canvas-tag;
                setups: root.setups;
                setup-index: root.setup-index;
                setup-pick(i) => { root.setup-pick(i); }
                setup-action(id) => { root.setup-action(id); }
                dirty: root.dirty;
                can-undo: root.can-undo;
                can-redo: root.can-redo;
                open-palette => { root.action("palette"); }
                undo => { root.action("undo"); }
                redo => { root.action("redo"); }
                toggle-theme => { root.toggle-theme(); }
                recording: root.recording;
                record-time: root.record-time;
                replay-active: root.replay-active;
                vcam-state: root.vcam-state;
                vcam-tooltip: root.vcam-tooltip;
                toggle-vcam => { root.action("vcam.toggle"); }
                open-automation => { root.action("automation"); }
                open-clips => { root.action("clips.open"); }
                stream-state: root.stream-state;
                stream-time: root.stream-time;
                toggle-stream => { root.go-live-clicked(); }
                show-deck => { root.deck-edit = false; main-keys.focus(); }
                live-panel-open: root.live-panel-open;
                open-destinations => { root.live-panel-open = !root.live-panel-open; }
                toggle-record => { root.action("record.toggle"); }
                toggle-replay => { root.action("replay.toggle"); }
                save-replay => { root.action("replay.save"); }
                open-settings => { root.action("settings"); }
                studio-mode: root.studio-mode;
                update-ready: root.update-ready;
                update-restart => { root.action("update-restart"); }
                toggle-studio => { root.action("studio.toggle"); }
            }
            // The Stage: the preview fills the page; layers and settings float over it.
            VerticalLayout {
                vertical-stretch: 1;
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                CanvasTabs {
                    tabs: root.canvas-tabs;
                    presets: root.canvas-presets;
                    renaming <=> root.renaming-canvas;
                    select(id) => { root.canvas-select(id); main-keys.focus(); }
                    add(i) => { root.canvas-add(i); }
                    remove(id) => { root.canvas-remove(id); }
                    rename(id, name) => { root.canvas-rename(id, name); main-keys.focus(); }
                }
                stage := Rectangle {
                    vertical-stretch: 1;
                    border-radius: Theme.radius-l;
                    border-width: 1px;
                    border-color: Theme.border;
                    clip: true;
                    HorizontalLayout {
                        preview := Preview {
                            horizontal-stretch: 1;
                            frame: root.preview-frame;
                            canvas-w: root.canvas-w;
                            canvas-h: root.canvas-h;
                            selection: root.selection-box;
                            hover: root.hover-box;
                            guides: root.guides;
                            cursor: root.cursor;
                            space-down: root.space-down;
                            scroll-pan: root.scroll-pan;
                            pointer(kind, x, y, px, shift, alt, ctrl) => {
                                if (kind == "down") { main-keys.focus(); }
                                root.preview-pointer(kind, x, y, px, shift, alt, ctrl);
                            }
                            wheel(x, y, dx, dy) => {
                                return root.preview-wheel(x, y, dx, dy);
                            }
                        }
                        if root.studio-mode: TransitionColumn {
                            label: root.transition-label;
                            busy: root.transition-busy;
                            go(mode) => { root.studio-go(mode); main-keys.focus(); }
                        }
                        if root.studio-mode: ProgramView {
                            horizontal-stretch: 1;
                            frame: root.program-frame;
                            canvas-w: root.canvas-w;
                            canvas-h: root.canvas-h;
                        }
                    }
                    if root.studio-mode: Rectangle {
                        x: parent.width - self.width - 12px;
                        y: 10px;
                        width: preview-label.preferred-width + 14px;
                        height: 20px;
                        border-radius: 10px;
                        background: Theme.ok;
                        preview-label := Text { text: "PREVIEW"; color: Theme.on-accent; font-size: Theme.font-xs; font-weight: 700; }
                    }
                    // What is in the scene (top left).
                    if root.layers-open: Rectangle {
                        x: 12px;
                        y: 12px;
                        // Room for the title and all five header buttons.
                        width: 300px;
                        height: min(parent.height - 24px, 120px + root.layers.length * 34px);
                        border-radius: Theme.radius-l;
                        drop-shadow-blur: 18px;
                        drop-shadow-color: #00000050;
                        // Swallow clicks and wheel on empty panel areas so they do not reach the preview
                        // (which would deselect and close the panel).
                        TouchArea { scroll-event(e) => { EventResult.accept } }
                        SourcesPanel {
                            width: parent.width;
                            height: parent.height;
                            layers: root.layers;
                            select(id) => { root.layer-select(id); main-keys.focus(); }
                            toggle-visible(id) => { root.layer-toggle-visible(id); }
                            toggle-lock(id) => { root.layer-toggle-lock(id); }
                            add => { root.action("source.add"); }
                            remove => { root.action("item.remove"); }
                            move-up => { root.action("item.up"); }
                            move-down => { root.action("item.down"); }
                            group => { root.action("item.group"); }
                        }
                    }
                    // The selected item's settings (top right), only while something is selected.
                    if root.inspect.has || root.audio-inspect.has: Rectangle {
                        x: parent.width - self.width - 12px;
                        y: root.studio-mode ? 40px : 12px;
                        width: root.inspector-width;
                        height: parent.height - self.y - 12px;
                        border-radius: Theme.radius-l;
                        drop-shadow-blur: 18px;
                        drop-shadow-color: #00000050;
                        TouchArea { scroll-event(e) => { EventResult.accept } }
                        InspectorPanel {
                            width: parent.width;
                            height: parent.height;
                            sel: root.inspect;
                            tab <=> root.inspector-tab;
                            folds <=> root.inspector-folds;
                            canvas-info: root.canvas-info;
                            gpu-info: root.gpu-info;
                            edit(field, v) => { root.inspect-edit(field, v); }
                            edit-text(field, v) => { root.inspect-text(field, v); }
                            edit-color(c) => { root.inspect-color(c); }
                            select-option(field, i) => { root.inspect-option(field, i); }
                            toggle(field, v) => { root.inspect-toggle(field, v); }
                            commit => { root.inspect-commit(); }
                            action(id) => { root.action(id); }
                            props: root.props;
                            prop-flag(k, v) => { root.prop-flag(k, v); }
                            prop-number(k, v) => { root.prop-number(k, v); }
                            prop-text(k, v) => { root.prop-text(k, v); }
                            prop-color(k, v) => { root.prop-color(k, v); }
                            prop-index(k, i) => { root.prop-index(k, i); }
                            prop-browse(k) => { root.prop-browse(k); }
                            prop-refresh => { root.prop-refresh(); }
                            audio: root.audio-inspect;
                            audio-set(k, v) => { root.audio-set(k, v); }
                            filter-add(i) => { root.filter-add(i); }
                            filter-remove(id) => { root.filter-remove(id); }
                            filter-toggle(id, v) => { root.filter-toggle(id, v); }
                            filter-param(id, k, v) => { root.filter-param(id, k, v); }
                            filter-move(id, up) => { root.filter-move(id, up); }
                            video-filters: root.video-filters;
                            media: root.media-inspect;
                            media-control(c) => { root.media-control(c); }
                            media-seek(f) => { root.media-seek(f); }
                            browser: root.browser-selected;
                            browser-status: root.browser-status;
                            browser-reload => { root.browser-reload(); }
                            video-filter-kinds: root.video-filter-kinds;
                            vfilter-add(i) => { root.vfilter-add(i); }
                            vfilter-remove(id) => { root.vfilter-remove(id); }
                            vfilter-toggle(id, v) => { root.vfilter-toggle(id, v); }
                            vfilter-param(id, k, v) => { root.vfilter-param(id, k, v); }
                            vfilter-move(id, up) => { root.vfilter-move(id, up); }
                            vfilter-browse(id) => { root.vfilter-browse(id); }
                            vfilter-code(id) => { root.vfilter-code(id); }
                            close => { root.action("selection.clear"); main-keys.focus(); }
                        }
                    }
                    // The full mixer, on demand (bottom right).
                    if root.mixer-open: Rectangle {
                        x: parent.width - self.width - 12px;
                        y: parent.height - self.height - 12px;
                        width: min(parent.width - 24px, 560px);
                        height: min(parent.height - 24px, 300px);
                        border-radius: Theme.radius-l;
                        drop-shadow-blur: 18px;
                        drop-shadow-color: #00000050;
                        TouchArea { scroll-event(e) => { EventResult.accept } }
                        MixerPanel {
                            width: parent.width;
                            height: parent.height;
                            strips: root.mixer-strips;
                            master: root.mixer-master;
                            select(id) => { root.mixer-select(id); main-keys.focus(); }
                            fader(id, v) => { root.mixer-fader(id, v); }
                            commit => { root.inspect-commit(); }
                            toggle-mute(id) => { root.mixer-mute(id); }
                            add => { root.action("source.add"); }
                        }
                    }
                }
                SceneStrip {
                    scenes: root.scenes;
                    frame: root.card-frame;
                    studio-mode: root.studio-mode;
                    strips: root.mixer-strips;
                    renaming <=> root.renaming-scene;
                    mixer-open: root.mixer-open;
                    transition-kind: root.transition-kind;
                    transition-direction: root.transition-direction;
                    transition-duration: root.transition-duration;
                    transition-file: root.transition-file;
                    transition-point: root.transition-point;
                    activate(id) => { root.scene-activate(id); main-keys.focus(); }
                    add => { root.scene-add(); }
                    duplicate(id) => { root.scene-duplicate(id); }
                    remove(id) => { root.scene-remove(id); }
                    rename(id, name) => { root.scene-rename(id, name); main-keys.focus(); }
                    toggle-mute(id) => { root.mixer-mute(id); }
                    toggle-mixer => { root.mixer-open = !root.mixer-open; }
                    fader(id, v) => { root.mixer-fader(id, v); }
                    commit => { root.inspect-commit(); }
                    open-settings(id) => { root.mixer-select(id); main-keys.focus(); }
                    transition-set(k, v) => { root.transition-set(k, v); }
                    edit-shader => { root.action("transition.shader"); }
                }
            }
            StatusBar {
                fps: root.fps;
                target-fps: root.target-fps;
                render-ms: root.render-ms;
                lagged: root.lagged;
                gpu: root.gpu-info;
                message: root.status-message;
                stream-info: root.stream-info;
                stream-health: root.stream-health;
                health: root.health;
                health-text: root.health-text;
                version: root.app-version;
                open-stats => { root.action("stats"); }
                open-about => { root.action("about"); }
            }
        }
        }

        // Covers the studio while live (the studio stays as it is underneath).
        if root.deck-visible: LiveDeck {
            width: 100%;
            height: 100%;
            frame: root.studio-mode ? root.program-frame : root.preview-frame;
            canvas-w: root.canvas-w;
            canvas-h: root.canvas-h;
            scenes: root.scenes;
            strips: root.mixer-strips;
            live-rows: root.live-active-rows;
            stream-time: root.stream-time;
            viewers-total: root.viewers-total;
            stream-health: root.stream-health;
            stream-info: root.stream-info;
            recording: root.recording;
            record-time: root.record-time;
            replay-active: root.replay-active;
            clip-hotkey: root.clip-hotkey;
            scene(id) => { root.scene-activate(id); main-keys.focus(); }
            fader(id, v) => { root.mixer-fader(id, v); }
            commit => { root.inspect-commit(); main-keys.focus(); }
            toggle-mute(id) => { root.mixer-mute(id); }
            clip-now => { root.action("replay.save"); main-keys.focus(); }
            toggle-record => { root.action("record.toggle"); main-keys.focus(); }
            end-stream => { root.action("stream.toggle"); main-keys.focus(); }
            edit-layout => { root.deck-edit = true; main-keys.focus(); }
            folds <=> root.inspector-folds;
            audio: root.audio-inspect;
            open-sound(id) => { root.mixer-select(id); main-keys.focus(); }
            close-sound => { root.action("selection.clear"); main-keys.focus(); }
            audio-set(k, v) => { root.audio-set(k, v); }
            filter-add(i) => { root.filter-add(i); }
            filter-remove(id) => { root.filter-remove(id); }
            filter-toggle(id, v) => { root.filter-toggle(id, v); }
            filter-param(id, k, v) => { root.filter-param(id, k, v); }
            filter-move(id, up) => { root.filter-move(id, up); }
            chat-tabs: root.chat-tabs;
            chat-selected: root.chat-selected;
            chat-frame: root.chat-frame;
            chat-message: root.chat-message;
            chat-people-total: root.chat-people-total;
            chat-people: root.chat-people;
            chat-live: root.chat-live;
            chat-select(i) => { root.chat-select(i); }
            chat-pointer(k, x, y, b, dx, dy) => { root.chat-pointer(k, x, y, b, dx, dy); }
            chat-key(t, d, c, s, a) => { root.chat-key(t, d, c, s, a); }
            chat-home => { root.chat-home(); }
            chat-reload => { root.chat-reload(); }
            chat-resized(w, h) => { root.chat-resized(w, h); }
            chat-send(t, i) => { root.chat-send(t, i); }
            chat-toggle-chime => { root.chat-toggle-chime(); }
            chat-emote-ms: root.chat-emote-ms;
            chat-text-width(w) => { root.chat-text-width(w); }
        }
    }

    if root.palette-open: CommandPalette {
        entries: root.palette-entries;
        query <=> root.palette-query;
        current <=> root.palette-current;
        query-changed(q) => { root.palette-query-changed(q); }
        run(id) => {
            root.palette-open = false;
            main-keys.focus();
            root.palette-run(id);
        }
        dismiss => {
            root.palette-open = false;
            main-keys.focus();
        }
    }

    if root.montage-open: MontageDialog {
        as-page: true;
        x: root.sidebar-width;
        width: root.width - root.sidebar-width;
        form: root.montage-form;
        action(f, i, v) => { root.montage-action(f, i, v); }
        text(f, s) => { root.montage-text(f, s); }
        key(t, c, s) => { root.montage-key(t, c, s); }
        dismiss => {
            root.montage-action("close", 0, 0);
            root.montage-open = false;
            main-keys.focus();
        }
    }

    // The Chat page (beside the sidebar), for chatting when not live.
    if root.chat-open && !root.deck-visible: Rectangle {
        x: root.sidebar-width;
        width: root.width - root.sidebar-width;
        background: Theme.bg;
        VerticalLayout {
            padding: 20px;
            spacing: 14px;
            Text { text: "Chat"; color: Theme.text; font-family: Theme.font-display; font-size: 28px; font-weight: 600; }
            HorizontalLayout {
                alignment: start;
                vertical-stretch: 1;
                ChatPanel {
                    width: min(560px, root.width - root.sidebar-width - 40px);
                    tabs: root.chat-tabs;
                    selected: root.chat-selected;
                    frame: root.chat-frame;
                    message: root.chat-message;
                    people-total: root.chat-people-total;
                    people: root.chat-people;
                    live: root.chat-live;
                    select(i) => { root.chat-select(i); }
                    pointer(k, x, y, b, dx, dy) => { root.chat-pointer(k, x, y, b, dx, dy); }
                    key(t, d, c, s, a) => { root.chat-key(t, d, c, s, a); }
                    home => { root.chat-home(); }
                    reload => { root.chat-reload(); }
                    resized(w, h) => { root.chat-resized(w, h); }
                    send(t, i) => { root.chat-send(t, i); }
                    toggle-chime => { root.chat-toggle-chime(); }
                    emote-ms: root.chat-emote-ms;
                    text-width(w) => { root.chat-text-width(w); }
                }
            }
        }
    }

    if root.clips-open: ClipsDialog {
        as-page: true;
        x: root.sidebar-width;
        width: root.width - root.sidebar-width;
        form: root.clips-form;
        player: root.clip-player;
        action(f, i, v) => { root.clips-action(f, i, v); }
        text(f, s) => { root.clips-text(f, s); }
        dismiss => {
            root.clips-action("close", 0, 0);
            root.clips-open = false;
            main-keys.focus();
        }
    }

    if root.add-source-open: AddSourceDialog {
        types: root.source-types;
        pick(kind) => {
            root.add-source-open = false;
            main-keys.focus();
            root.add-source-pick(kind);
        }
        dismiss => {
            root.add-source-open = false;
            main-keys.focus();
        }
    }

    if root.game-audio-open: GameAudioPrompt {
        heard-by: root.game-audio-heard-by;
        // Rust closes it and adds the Game capture.
        answer(capture, remember) => {
            root.game-audio-answer(capture, remember);
            main-keys.focus();
        }
    }

    if root.shader-open: ShaderDialog {
        code: root.shader-code;
        error: root.shader-error;
        title: root.shader-title;
        help: root.shader-help;
        apply(code) => { root.shader-apply(code); }
        example => { root.shader-example(); }
        dismiss => { root.shader-open = false; main-keys.focus(); }
    }

    if root.live-panel-open: LivePanel {
        width: parent.width;
        height: parent.height;
        rows: root.live-rows;
        streaming: root.stream-state != 0;
        edit-details => { root.live-panel-open = false; root.action("stream.details"); }
        toggle(i) => { root.live-toggle(i); }
        manage => { root.live-panel-open = false; root.settings-page = 1; root.action("settings"); }
        add-platform => { root.live-panel-open = false; root.action("go-live-setup"); }
        dismiss => { root.live-panel-open = false; }
    }

    if root.settings-open: SettingsDialog {
        form: root.settings-form;
        remote-status: root.remote-status;
        page <=> root.settings-page;
        set(k, v) => { root.settings-set(k, v); }
        set-text(k, v) => { root.settings-text(k, v); }
        browse => { root.settings-browse(); }
        dismiss => {
            root.settings-open = false;
            main-keys.focus();
        }
    }

    if root.signin-open: SignInDialog {
        title: root.signin-title;
        hint: root.signin-hint;
        frame: root.signin-frame;
        message: root.signin-message;
        pointer(k, x, y, b, dx, dy) => { root.signin-pointer(k, x, y, b, dx, dy); }
        key(t, d, c, s, a) => { root.signin-key(t, d, c, s, a); }
        resized(w, h) => { root.signin-resized(w, h); }
        open-browser => { root.signin-browser(); }
        dismiss => { root.signin-cancel(); }
    }

    if root.stats-open: StatsDialog {
        form: root.stats-form;
        dismiss => {
            root.stats-open = false;
            main-keys.focus();
        }
    }

    if root.golive-open: GoLiveDialog {
        platforms: root.golive-platforms;
        platform: root.golive-platform;
        key <=> root.golive-key;
        message: root.golive-message;
        message-error: root.golive-message-error;
        auto-settings: root.golive-auto;
        pick(i) => { root.golive-pick(i); }
        key-edited(t) => { root.golive-key-edited(t); }
        open-key-page => { root.golive-open-key-page(); }
        go => { root.golive-go(); }
        more-options => { root.golive-more(); }
        dismiss => {
            root.golive-open = false;
            main-keys.focus();
        }
    }

    if root.details-open: StreamDetailsDialog {
        sections: root.details-sections;
        keys-only: root.details-keys-only;
        live: root.details-live;
        busy: root.details-busy;
        loading: root.details-loading;
        ask: root.details-ask;
        text(i, field, value) => { root.details-text(i, field, value); }
        flag(i, field, value) => { root.details-flag(i, field, value); }
        choose(i, field, value) => { root.details-choose(i, field, value); }
        retry(i) => { root.details-retry(i); }
        skip(i) => { root.details-skip(i); }
        set-ask(v) => { root.details-set-ask(v); }
        go => { root.details-go(); }
        // Rust closes it (it stays open while the details are being applied).
        dismiss => {
            root.details-closed();
            main-keys.focus();
        }
    }

    if root.automation-open: AutomationDialog {
        form: root.automation-form;
        edit(f, i, v) => { root.automation-edit(f, i, v); }
        edit-text(f, i, s) => { root.automation-text(f, i, s); }
        key(t, c, a, s, m) => { root.automation-key(t, c, a, s, m); }
        dismiss => {
            root.automation-edit("close", 0, 0);
            root.automation-open = false;
            main-keys.focus();
        }
    }

    if root.startup == "wizard": SetupWizard {
        presets: root.presets;
        purposes: root.wizard-purposes;
        purpose <=> root.wizard-purpose;
        summary: root.wizard-summary;
        custom <=> root.wizard-custom;
        current <=> root.wizard-current;
        setup-name: root.wizard-setup-name;
        purpose-changed(i) => { root.wizard-purpose-changed(i); }
        toggled(key) => { root.wizard-toggled(key); }
        create => { root.wizard-create(); }
        cancel => { root.wizard-cancel(); main-keys.focus(); }
    }

    if root.setup-dialog != "": SetupDialog {
        mode: root.setup-dialog;
        current-name: root.collection-name;
        name <=> root.setup-dialog-name;
        error: root.setup-dialog-error;
        confirm(t) => {
            root.setup-confirm(t);
            if (root.setup-dialog == "") { main-keys.focus(); }
        }
        cancel => { root.setup-cancel(); main-keys.focus(); }
    }

    if root.startup == "recovery": RecoveryPrompt {
        restore => { root.recovery-restore(); }
        discard => { root.recovery-discard(); }
    }

    if root.toast-text != "": Toast {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 44px;
        text: root.toast-text;
        error: root.toast-error;
        action: root.toast-action;
        act => { root.toast-act(); }
    }

    TooltipLayer {
        width: 100%;
        height: 100%;
    }
}
